diff --git a/tools/recomp/test_lifter_movsx.py b/tools/recomp/test_lifter_movsx.py
new file mode 100644
index 0000000..2054a93
--- /dev/null
+++ b/tools/recomp/test_lifter_movsx.py
@@ -0,0 +1,46 @@
+"""movsx from a register sign-extends, whichever register it is.
+
+`_lift_movsx` named ax/bx/cx/dx/si/di as the 16-bit sources and left out bp
+and sp, so `movsx ebp, bp` fell through to the plain operand read, LO16(ebp),
+which is a zero extension. MechAssault 2's Bink intra-block IDCT
+(sub_0039B9F0, at 0x0039BA9C) fetches row 6 of each column with
+`mov bp, [ebx+0x60]` / `movsx ebp, bp`; every negative coefficient there
+came out as 65536 + c, and the 8x8 block decoded to noise -- the random
+coloured rectangles over the intro and attract movies, identical on both
+renderers because the decoded frames themselves were wrong.
+"""
+
+import pytest
+
+from .disasm import Instruction, Operand
+from .lifter import Lifter
+
+REG16 = ["ax", "bx", "cx", "dx", "si", "di", "bp", "sp"]
+REG8 = ["al", "bl", "cl", "dl", "ah", "bh", "ch", "dh"]
+
+
+def _lift(mnemonic, dst, src):
+    insn = Instruction(0, 3, mnemonic, "", "00")
+    insn.operands = [Operand(type="reg", reg=dst), Operand(type="reg", reg=src)]
+    return Lifter().lift_instruction(insn)
+
+
+@pytest.mark.parametrize("src", REG16)
+def test_movsx_r32_from_every_r16_sign_extends(src):
+    assert _lift("movsx", "ebp", src) == [f"ebp = SX16(LO16(e{src}));"]
+
+
+@pytest.mark.parametrize("src", REG8)
+def test_movsx_r32_from_every_r8_sign_extends(src):
+    lifted = _lift("movsx", "eax", src)
+    assert len(lifted) == 1 and lifted[0].startswith("eax = SX8("), lifted
+
+
+@pytest.mark.parametrize("src", REG16 + REG8)
+def test_movsx_and_movzx_extend_the_same_register_set(src):
+    # The two lists drifted apart once; a source movzx widens explicitly
+    # must not reach movsx as a bare, zero-extended read.
+    sx = _lift("movsx", "ecx", src)[0]
+    zx = _lift("movzx", "ecx", src)[0]
+    assert ("SX16(" in sx) == ("ZX16(" in zx)
+    assert ("SX8(" in sx) == ("ZX8(" in zx)
