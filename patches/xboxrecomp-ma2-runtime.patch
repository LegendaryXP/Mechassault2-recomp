+/* RECOMP_MEMLOG=<hex addr>[:<count>],...[@<ms>]: every <ms> of script time
+ * (default 100) print the floats at those guest addresses (<count> floats
+ * from one, for a struct) -- how a candidate camera variable moves through
+ * a scripted turn. */
+static void mkb_memlog(unsigned long t)
+{
+    static int init, n;
+    static unsigned long every = 100, next;
+    static uint32_t addr[128];
+    extern ptrdiff_t xbox_GetMemoryOffset(void);
+    int k;
+
+    if (!init) {
+        const char *e = getenv("RECOMP_MEMLOG");
+        char *end;
+        init = 1;
+        while (e && *e && *e != '@' && n < 128) {
+            uint32_t a = (uint32_t)strtoul(e, &end, 16), c = 1;
+            if (*end == ':')
+                c = (uint32_t)strtoul(end + 1, &end, 10);
+            while (c-- && n < 128) {
+                addr[n++] = a;
+                a += 4;
+            }
+            e = (*end == ',') ? end + 1 : end;
+        }
+        if (e && *e == '@')
+            every = strtoul(e + 1, NULL, 10);
+        if (!every)
+            every = 100;
+    }
+    if (!n || t < next)
+        return;
+    next = t + every;
+    fprintf(stderr, "  [MEMLOG] t=%lu", t);
+    for (k = 0; k < n; k++) {
+        if (addr[k] >= 0x10000u && addr[k] < 0x04000000u)
+            fprintf(stderr, " %08X=%g", addr[k],
+                    *(const float *)((const char *)xbox_GetMemoryOffset() + addr[k]));
+    }
+    fprintf(stderr, "\n");
+}
