+/* RECOMP_APU_BINSTAT=1: every 5 s of output, each mixbin's peak and RMS and
+ * how many output samples the mixdown clipped. Tells which bins a title's
+ * loud passages come from. */
+static int binstat_on(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char *e = getenv("RECOMP_APU_BINSTAT");
+        on = e && *e && *e != '0';
+    }
+    return on;
+}
+
+static void binstat_frame(float mixbins[NUM_MIXBINS][NUM_SAMPLES_PER_FRAME],
+                          unsigned clipped)
+{
+    static float peak[NUM_MIXBINS];
+    static double sq[NUM_MIXBINS];
+    static unsigned n, clips;
+    int b, i;
+
+    for (b = 0; b < NUM_MIXBINS; b++)
+        for (i = 0; i < NUM_SAMPLES_PER_FRAME; i++) {
+            float v = mixbins[b][i];
+            float a = v < 0 ? -v : v;
+            if (a > peak[b])
+                peak[b] = a;
+            sq[b] += (double)v * v;
+        }
+    clips += clipped;
+    n += NUM_SAMPLES_PER_FRAME;
+    if (n < 48000 * 5)
+        return;
+    fprintf(stderr, "[APU-BINSTAT] clipped %u of %u; bin peak/rms:", clips, n * 2);
+    for (b = 0; b < NUM_MIXBINS; b++)
+        if (peak[b] > 0.001f)
+            fprintf(stderr, " %d=%.2f/%.3f", b, peak[b], sqrt(sq[b] / n));
+    fprintf(stderr, "\n");
+    memset(peak, 0, sizeof peak);
+    memset(sq, 0, sizeof sq);
+    n = clips = 0;
+}
+
 void mcpx_apu_dsp_frame(MCPXAPUState *d,
                          float mixbins[NUM_MIXBINS][NUM_SAMPLES_PER_FRAME])
 {
+    unsigned clipped = 0;
+
     /* Bypass DSP: take mixbin 0 (front-left) and mixbin 1 (front-right)
      * and write them directly to the monitor frame buffer as the final
