+/* The other copy of an address mcpx_apu_phys resolved to a named heap page
+ * while the window also has that page number in use (or did: below the
+ * arena's high-water mark), or NULL when the number names one copy only.
+ * mcpx_apu_phys has to pick one and picks RAM; a caller that can tell valid
+ * data from garbage -- the ADPCM fetch, by its block headers -- can check the
+ * other. MechAssault 2's music streams live in the window at numbers whose
+ * heap pages are named: read from RAM, every music voice was noise. */
+uint8_t *mcpx_apu_phys_alias(uint64_t addr)
+{
+    uint32_t a = (uint32_t)addr & 0x0FFFFFFFu;
+    if (a >= (64u << 20) || !xbox_PhysRamNameMap()[a >> 12])
+        return NULL;
+    if (xbox_ContiguousPageMap()[a >> 12] || a < xbox_ContiguousAllocatedBytes())
+        return g_apu_ram_ptr + 0x80000000u + a;
+    return NULL;
+}
