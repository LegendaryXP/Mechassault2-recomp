+{
+    int i;
+    for (i = 0; i < s_nsteps; i++) {
+        MkbStep *st = &s_steps[i];
+        if (st->in < 0 || t < st->at || t >= st->at + st->len)
+            continue;
+        mkb_script_shown(st, i, t);
