+/* =========================================================================
+ * CPUID and the EFLAGS bits a title can observe
+ *
+ * Lifted as no-ops, the classic "is CPUID there?" test (flip EFLAGS.ID with
+ * pushfd/popfd and see if it sticks) read garbage, cpuid left its registers
+ * unchanged, and feature detection came out "no MMX". An Xbox always has MMX
+ * and SSE, so titles link only those code paths: RAD's Bink in MechAssault 2
+ * (sub_0031C900) then left its MMX routine pointers at 0x004D36B8.. null,
+ * called them, leaked their stack arguments, and the intro's caller read its
+ * own object from the wrong slot and quit to the dashboard.
+ *
+ * The answers are the console's: a 733 MHz Pentium III (Coppermine, family 6
+ * model 8), GenuineIntel, with FPU/TSC/CX8/CMOV/MMX/FXSR/SSE and no SSE2.
+ *
+ * EFLAGS: the arithmetic flags live in the lifter's own model, so pushfd
+ * pushes only the system bits a title can set and read back (ID, AC, DF, IF,
+ * plus the always-one bit 1), kept per thread like the real register.
+ * ========================================================================= */
+void xbox_Cpuid(uint32_t *a, uint32_t *b, uint32_t *c, uint32_t *d)
+{
+    uint32_t leaf = *a;
+
+    switch (leaf) {
+    case 0:
+        *a = 2;
+        *b = 0x756E6547u;   /* "Genu" */
+        *d = 0x49656E69u;   /* "ineI" */
+        *c = 0x6C65746Eu;   /* "ntel" */
+        break;
+    case 1:
+        *a = 0x0000068Au;   /* family 6, model 8, stepping 10 */
+        *b = 0;
+        *c = 0;
+        *d = 0x0383F9FFu;   /* FPU..CMOV, MMX (23), FXSR (24), SSE (25) */
+        break;
+    case 2:
+        *a = 0x03020101u;   /* PIII cache/TLB descriptors */
+        *b = 0;
+        *c = 0;
+        *d = 0x0C040843u;
+        break;
+    default:
+        *a = *b = *c = *d = 0;
+        break;
+    }
+}
+
+#if defined(_MSC_VER)
+static __declspec(thread) uint32_t t_eflags_sys = 0x00000202u;   /* IF + bit 1 */
+#else
+static _Thread_local uint32_t t_eflags_sys = 0x00000202u;
+#endif
+
+uint32_t xbox_PushfdValue(void)
+{
+    return t_eflags_sys | 0x2u;
+}
+
+void xbox_PopfdValue(uint32_t v)
+{
+    /* ID (21), AC (18), DF (10), IF (9) -- the bits user code can change. */
+    t_eflags_sys = (v & 0x00240600u) | 0x2u;
+}
+
