+}
+
+static void binstat_frame(float mixbins[NUM_MIXBINS][NUM_SAMPLES_PER_FRAME],
+                          unsigned clipped, const float (*out)[2],
+                          const float (*dry)[3])
+{
+    static float peak[NUM_MIXBINS];
+    static double sq[NUM_MIXBINS];
+    static double x04, x15, x01;      /* front/rear and left/right products */
+    static unsigned n, clips;
+    int b, i;
+
+    /* [APU-LEVEL] once a second: the left output's RMS before the limiter,
+     * and the part of it from send-only voices (s_send_dry), in dBFS. */
+    {
+        static double so, sd;
+        static unsigned m, secs;
+        for (i = 0; i < NUM_SAMPLES_PER_FRAME; i++) {
+            so += (double)out[i][0] * out[i][0];
+            sd += (double)dry[i][0] * dry[i][0];
+        }
+        m += NUM_SAMPLES_PER_FRAME;
+        if (m >= 48000) {
+            fprintf(stderr, "[APU-LEVEL] %us out %.1f send-only %.1f dBFS\n",
+                    ++secs, so > 0 ? 10.0 * log10(so / m) : -99.0,
+                    sd > 0 ? 10.0 * log10(sd / m) : -99.0);
+            so = sd = 0.0;
+            m = 0;
+        }
+    }
+
+    for (b = 0; b < NUM_MIXBINS; b++)
+        for (i = 0; i < NUM_SAMPLES_PER_FRAME; i++) {
+            float v = mixbins[b][i];
+            float a = v < 0 ? -v : v;
+            if (a > peak[b])
+                peak[b] = a;
+            sq[b] += (double)v * v;
+        }
+    for (i = 0; i < NUM_SAMPLES_PER_FRAME; i++) {
+        x04 += (double)mixbins[0][i] * mixbins[4][i];
+        x15 += (double)mixbins[1][i] * mixbins[5][i];
+        x01 += (double)mixbins[0][i] * mixbins[1][i];
+    }
+    clips += clipped;
+    n += NUM_SAMPLES_PER_FRAME;
+    if (n < 48000 * 5)
+        return;
+    fprintf(stderr, "[APU-BINSTAT] clipped %u of %u; bin peak/rms:", clips, n * 2);
+    for (b = 0; b < NUM_MIXBINS; b++)
+        if (peak[b] > 0.001f)
+            fprintf(stderr, " %d=%.2f/%.3f", b, peak[b], sqrt(sq[b] / n));
+    /* Correlation of front with back (1: the same signal, -1: inverted)
+     * and of left with right. */
+    fprintf(stderr, "; corr 0/4 %.2f 1/5 %.2f 0/1 %.2f\n",
+            sq[0] * sq[4] > 0 ? x04 / sqrt(sq[0] * sq[4]) : 0.0,
+            sq[1] * sq[5] > 0 ? x15 / sqrt(sq[1] * sq[5]) : 0.0,
+            sq[0] * sq[1] > 0 ? x01 / sqrt(sq[0] * sq[1]) : 0.0);
+    memset(peak, 0, sizeof peak);
+    memset(sq, 0, sizeof sq);
+    x04 = x15 = x01 = 0.0;
+    n = clips = 0;
+}
