+/* ---- scripted input (RECOMP_MKB_SCRIPT) --------------------------------- *
+ *
+ *   <ms>:<INPUT>[:<hold ms>]          a key or mouse button, held (default 150)
+ *   <ms>:mouse:<dx>:<dy>[:<ms>]       mouse travel, spread over the time given
+ *
+ * Times count from the first poll, as RECOMP_PAD_SCRIPT's do. Each step is
+ * printed as it starts, so a run log says what was pressed when. */
+typedef struct { unsigned long at, len; int in; long dx, dy; int shown; } MkbStep;
+#define MKB_SCRIPT_MAX 256
+static MkbStep s_steps[MKB_SCRIPT_MAX];
+static int s_nsteps = -1;
+
+static void mkb_script_load(void)
+{
+    const char *e = getenv("RECOMP_MKB_SCRIPT");
+    char buf[4096], *tok, *ctx = NULL;
+    s_nsteps = 0;
+    if (!e || !*e)
+        return;
+    snprintf(buf, sizeof buf, "%s", e);
+    for (tok = strtok_s(buf, ",", &ctx); tok && s_nsteps < MKB_SCRIPT_MAX;
+         tok = strtok_s(NULL, ",", &ctx)) {
+        MkbStep st;
+        char *f[5];
+        int n = 0;
+        char *c = tok, *p;
+        memset(&st, 0, sizeof st);
+        while (n < 5 && (p = strchr(c, ':')) != NULL) { *p = 0; f[n++] = c; c = p + 1; }
+        if (n < 5) f[n++] = c;
+        if (n < 2)
+            continue;
+        st.at = strtoul(f[0], NULL, 10);
+        if (!_stricmp(f[1], "mouse")) {
+            if (n < 4) continue;
+            st.in = -1;
+            st.dx = strtol(f[2], NULL, 10);
+            st.dy = strtol(f[3], NULL, 10);
+            st.len = n > 4 ? strtoul(f[4], NULL, 10) : 100;
+        } else {
+            st.in = mkb_parse_input(f[1]);
+            if (st.in < 0) {
+                fprintf(stderr, "  [MKB] script: unknown input %s\n", f[1]);
+                continue;
+            }
+            st.len = n > 2 ? strtoul(f[2], NULL, 10) : 150;
+        }
+        if (!st.len) st.len = 1;
+        s_steps[s_nsteps++] = st;
+    }
+}
+
+/* Apply the script at time t: held inputs into down[], mouse travel into
+ * *dx/*dy for the slice (last, t]. */
+static void mkb_script_apply(unsigned long last, unsigned long t,
+                             unsigned char *down, LONG *dx, LONG *dy)
+{
+    int i;
+    for (i = 0; i < s_nsteps; i++) {
+        MkbStep *st = &s_steps[i];
+        unsigned long end = st->at + st->len;
+        if (t < st->at || (st->in >= 0 && t >= end) || (st->in < 0 && last >= end))
+            continue;
+        if (!st->shown) {
+            st->shown = 1;
+            fprintf(stderr, "  [MKB] script t=%lu ms: step %d\n", t, i);
+            fflush(stderr);
+        }
+        if (st->in >= 0) {
+            down[st->in] = 1;
+        } else {
+            unsigned long a = last > st->at ? last : st->at, b = t < end ? t : end;
+            if (b > a) {
+                *dx += (LONG)(st->dx * (double)(b - a) / st->len);
+                *dy += (LONG)(st->dy * (double)(b - a) / st->len);
+            }
+        }
+    }
+}
