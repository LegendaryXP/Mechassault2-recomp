              * On hardware the GP and EP mix the submixes down; here they are
@@ -273,33 +334,77 @@ void mcpx_apu_dsp_frame(MCPXAPUState *d,
              * Gating the HRTF submix override was tried first and did not fix
              * it, so the defect is the width of this mixdown and nothing else.
              *
-             * Even bins left, odd bins right, which preserves the stereo
-             * pairing the guest set up -- bins 6/7 and 8/9 arrive with matched
-             * counts. This is not what a real EP does; it is the cheapest
-             * mixdown that stops discarding audio. */
+             * The mixdown follows the XDK's mixbin layout (DSMIXBIN_*), as a
+             * stereo downmix would: 0/1 front L/R, 4/5 back L/R and 6-9 the
+             * crosstalk (3D) front and back L/R go to their side; 2, the
+             * centre, goes to both at -3 dB; 3, the LFE, to both at half;
+             * 10 (the I3DL2 reverb send) and 11-31 (the effect sends) are
+             * copies of voices already in the bins above, fed to GP effects
+             * there is no DSP for, so they go in quietly, at both sides.
+             *
+             * It used to be even bins left and odd bins right at full gain.
+             * That put the centre on the left only, the LFE on the right only
+             * and the reverb send in as a second dry copy; in MechAssault 2's
+             * battles the 3D pair alone peaks at 1.9, and a fifth of the
+             * output samples were clipped flat: harsh, crackling sound. */
             float left, right;
             if (mcpx_apu_mixdown_all()) {
-                left = 0.0f;
-                right = 0.0f;
-                for (int b = 0; b < NUM_MIXBINS; ++b) {
-                    if (b & 1) right += mixbins[b][i];
-                    else       left  += mixbins[b][i];
-                }
+                float sends = 0.0f;
+                for (int b = 10; b < NUM_MIXBINS; ++b)
+                    sends += mixbins[b][i];
+                left  = mixbins[0][i] + mixbins[4][i] + mixbins[6][i] + mixbins[8][i];
+                right = mixbins[1][i] + mixbins[5][i] + mixbins[7][i] + mixbins[9][i];
+                left  += 0.707f * mixbins[2][i] + 0.5f * mixbins[3][i] + 0.25f * sends;
+                right += 0.707f * mixbins[2][i] + 0.5f * mixbins[3][i] + 0.25f * sends;
             } else {
                 left = mixbins[0][i];
                 right = mixbins[1][i];
             }
-            /* Clamp to [-1, 1] range */
-            if (left > 1.0f) left = 1.0f;
-            if (left < -1.0f) left = -1.0f;
-            if (right > 1.0f) right = 1.0f;
-            if (right < -1.0f) right = -1.0f;
+            out[i][0] = left;
+            out[i][1] = right;
+            if (fabsf(left) > peak) peak = fabsf(left);
+            if (fabsf(right) > peak) peak = fabsf(right);
