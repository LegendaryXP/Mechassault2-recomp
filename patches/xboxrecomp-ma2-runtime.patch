+/* Bytes in live heap blocks: what MmQueryStatistics subtracts from the
+ * console's 64 MB along with the contiguous arena. */
+uint32_t xbox_HeapInUseBytes(void)
+{
+    uint64_t sum = 0;
+
+    AcquireSRWLockShared(&g_heap_lock);
+    for (int i = 0; i < g_heap_block_count; i++)
+        if (!g_heap_blocks[i].free)
+            sum += g_heap_blocks[i].size;
+    ReleaseSRWLockShared(&g_heap_lock);
+    return sum > 0xFFFFFFFFull ? 0xFFFFFFFFu : (uint32_t)sum;
+}
