+"  o.d0 = i.d0; o.d1 = i.d1; o.fog = i.fog; o.uv = i.uv;\n"
+"  o.t0 = i.t0; o.t1 = i.t1; o.t2 = i.t2; o.t3 = i.t3;\n"
+"  return o;\n"
+"}\n"
+"cbuffer VP : register(b1) { uint4 g_prog[136]; };\n"
+"cbuffer VC : register(b2) { float4 g_c[192]; };\n"
+"cbuffer VA : register(b3) { uint4 g_attr[16]; uint4 g_vm; float4 g_vf; };\n"
+"ByteAddressBuffer VB : register(t8);\n"
+"uint ld32(uint a) {\n"
