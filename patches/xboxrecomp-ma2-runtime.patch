+static __declspec(thread) uint32_t t_eflags_sys = 0x00000202u;   /* IF + bit 1 */
+#else
+static _Thread_local uint32_t t_eflags_sys = 0x00000202u;
+#endif
+
+uint32_t xbox_PushfdValue(void)
+{
+    return t_eflags_sys | 0x2u;
+}
+
+void xbox_PopfdValue(uint32_t v)
+{
+    /* ID (21), AC (18), DF (10), IF (9) -- the bits user code can change. */
+    t_eflags_sys = (v & 0x00240600u) | 0x2u;
+}
