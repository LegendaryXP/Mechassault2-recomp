+static void pad_auto_apply(int pad, uint8_t *out, unsigned long t)
+{
+    static long period = -1, draws_min, from;
+    static int done;
+    static unsigned long hot_since;
+    unsigned long ph;
+
+    if (period < 0) {
+        const char *e = getenv("RECOMP_PAD_AUTO"), *d = getenv("RECOMP_PAD_AUTO_DRAWS");
+        period = e ? atol(e) : 0;
+        if (period > 0 && period < 1000)
+            period = 1000;
+        draws_min = d ? atol(d) : 300;
+        d = getenv("RECOMP_PAD_AUTO_FROM");
+        from = d ? atol(d) : 60000;
+    }
+    if (period <= 0 || done || pad != 0 || t < (unsigned long)from)
+        return;
+    if (nv2a_pb_frame_draws() >= (uint32_t)draws_min) {
+        if (!hot_since)
+            hot_since = t ? t : 1;
+    } else {
