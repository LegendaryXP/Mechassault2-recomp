+/* RECOMP_MEMPOKE=<t>:<hex addr>:<float>[:<ms>],...: from script time t, add
+ * <float> to the float at that guest address -- once, or spread over <ms>
+ * milliseconds (a steady drift). For proving which variable a camera reads.
+ * "=<float>" sets it instead, every poll until <ms> runs out (once without
+ * one): a teleport, to put the player where a bug was reported. Up to 256. */
+static void mkb_mempoke(unsigned long last, unsigned long t)
+{
+    static int init, n;
+    static struct { unsigned long at, len; uint32_t addr; float v; int set; } pk[256];
+    extern ptrdiff_t xbox_GetMemoryOffset(void);
+    int k;
+
+    if (!init) {
+        const char *e = getenv("RECOMP_MEMPOKE");
+        char *end;
+        init = 1;
+        while (e && *e && n < 256) {
+            pk[n].at = strtoul(e, &end, 10);
+            if (*end != ':') break;
+            pk[n].addr = (uint32_t)strtoul(end + 1, &end, 16);
+            if (*end != ':') break;
+            pk[n].set = end[1] == '=';
+            pk[n].v = (float)strtod(end + 1 + pk[n].set, &end);
+            pk[n].len = 0;
+            if (*end == ':')
+                pk[n].len = strtoul(end + 1, &end, 10);
+            n++;
+            e = (*end == ',') ? end + 1 : NULL;
+        }
+    }
+    for (k = 0; k < n; k++) {
+        unsigned long end = pk[k].at + (pk[k].len ? pk[k].len : 1);
+        unsigned long a = last > pk[k].at ? last : pk[k].at, b = t < end ? t : end;
+        float *f;
+        if (b <= a || pk[k].addr < 0x10000u || pk[k].addr >= 0x04000000u)
+            continue;
+        f = (float *)((char *)xbox_GetMemoryOffset() + pk[k].addr);
+        if (pk[k].set)
+            *f = pk[k].v;
+        else
+            *f += pk[k].len ? pk[k].v * (float)(b - a) / (float)pk[k].len : pk[k].v;
+    }
+}
