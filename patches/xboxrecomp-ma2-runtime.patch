+            }
+            for (int i = 0; i < NUM_SAMPLES_PER_FRAME; i++) {
+                float g = g0 + (g1 - g0) * (float)(i + 1) / NUM_SAMPLES_PER_FRAME;
+                float left = out[i][0] * g, right = out[i][1] * g;
+                if (left > 1.0f || left < -1.0f) clipped++;
+                if (right > 1.0f || right < -1.0f) clipped++;
+                /* Clamp to [-1, 1] range */
+                if (left > 1.0f) left = 1.0f;
+                if (left < -1.0f) left = -1.0f;
+                if (right > 1.0f) right = 1.0f;
+                if (right < -1.0f) right = -1.0f;
+
+                /* Convert to 16-bit and write (not accumulate) into frame
+                 * buffer. Each of the 8 sub-frames writes its own 32-sample
+                 * slice. */
+                d->monitor.frame_buf[off + i][0] = (int16_t)(left * 32767.0f);
+                d->monitor.frame_buf[off + i][1] = (int16_t)(right * 32767.0f);
+            }
         }
+        if (binstat_on())
+            binstat_frame(mixbins, clipped);
     }
 
