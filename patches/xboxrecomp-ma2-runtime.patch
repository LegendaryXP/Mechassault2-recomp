+            # negative coefficient there became 65536 + c: the block noise
+            # over every Bink movie.
+            elif r in ("ax", "bx", "cx", "dx", "si", "di", "bp", "sp"):
                 src = f"SX16({src})"
         return [_fmt_operand_write(ops[0], src)]
 
