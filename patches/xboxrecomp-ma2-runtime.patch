+/* The EP's "program is running" word (RECOMP_APU_EP_MARK=1).
+ *
+ * MechAssault 2's DirectSound checks, every time its work routine runs
+ * (sub_003AB03A), that EP program memory word 6 (APU +0x5A018) reads
+ * 0xCCCCCC, and otherwise takes the EP for dead and restarts both DSPs
+ * (sub_003AADFA): counter stopped, GP and EP reset and reloaded, a 10 ms
+ * KeStallExecutionProcessor. On hardware the EP's boot loads its program
+ * and the word is there. Nothing here loads DSP programs, so the word stayed
+ * 0 and the restart ran about 75 times a second, with the same silent frames
+ * as the sample-limit restarts. The GP and EP windows are plain memory
+ * (MemoryLayoutInit traps only 0x00000-0x2FFFF), so the reset register the
+ * title writes, EPRST at +0x5FFFC, is read from there: while it has the EP
+ * running, the word is put in place. */
+#define APU_EP_PMEM_MARK   0x5A018u
+#define APU_EP_MARK_VALUE  0xCCCCCCu
+
+static void ep_mark_poll(void)
+{
+    static int on = -1;
+    static volatile uint32_t *ep;
+    const uint32_t run = NV_PAPU_GPRST_GPRST | NV_PAPU_GPRST_GPDSPRST;
+
+    if (on < 0) {
+        extern ptrdiff_t xbox_GetMemoryOffset(void);
+        on = apu_env_on("RECOMP_APU_EP_MARK");
+        ep = (volatile uint32_t *)((char *)xbox_GetMemoryOffset() + 0xFE850000u);
+        if (on)
+            fprintf(stderr, "[APU] EP program marker: 0x%06X at APU +0x%05X while EPRST"
+                            " runs the EP (RECOMP_APU_EP_MARK)\n",
+                    APU_EP_MARK_VALUE, APU_EP_PMEM_MARK);
+    }
+    if (!on)
+        return;
+    if ((ep[NV_PAPU_EPRST / 4] & run) == run
+        && ep[(APU_EP_PMEM_MARK - 0x50000u) / 4] != APU_EP_MARK_VALUE)
+        ep[(APU_EP_PMEM_MARK - 0x50000u) / 4] = APU_EP_MARK_VALUE;
+}
