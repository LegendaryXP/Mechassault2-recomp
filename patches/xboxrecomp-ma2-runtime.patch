+    } else if (ph >= (unsigned long)period / 2 && ph < (unsigned long)period / 2 + 200) {
+        out[4] = 0xFF;                                  /* A */
+    } else if (ph >= (unsigned long)period / 2 + 400 && hot_since && t - hot_since >= 5000) {
