+
+    memset(&rd, 0, sizeof rd);
+    rd.FillMode = D3D11_FILL_SOLID;
+    rd.CullMode = D3D11_CULL_NONE;      /* culling off; s_rs_cull when on */
+    rd.DepthClipEnable = FALSE;         /* window z is clamped, not clipped */
+    rd.ScissorEnable = TRUE;
+    rd.MultisampleEnable = s_msaa > 1;
+    hr = ID3D11Device_CreateRasterizerState(s_dev, &rd, &s_rs);
+    if (FAILED(hr)) { d3d_log("CreateRasterizerState", hr); return 0; }
+    {
+        int c, f;
+        for (c = 0; c < 2; c++)
+            for (f = 0; f < 2; f++) {
+                rd.CullMode = c ? D3D11_CULL_BACK : D3D11_CULL_FRONT;
+                rd.FrontCounterClockwise = f;
+                hr = ID3D11Device_CreateRasterizerState(s_dev, &rd, &s_rs_cull[c][f]);
+                if (FAILED(hr)) { d3d_log("CreateRasterizerState (cull)", hr); return 0; }
+            }
+    }
+
+    {
+        const char *e = getenv("RECOMP_RENDER_SCALE");
+        float f = e ? (float)atof(e) : 1.0f;
+        s_scale = f >= 1.0f && f <= 4.0f ? f : 1.0f;
+    }
+    s_white2d = make_white(0);
+    s_whitecube = make_white(1);
+    s_failed = 0;
+    fprintf(stderr, "  [D3D11] back end up (feature level 0x%X)\n", (unsigned)fl);
+    if (s_af || s_msaa > 1)
+        fprintf(stderr, "  [D3D11] anisotropic filtering %dx, MSAA %ux\n", s_af, s_msaa);
+    fflush(stderr);
+    return 1;
+}
+
+/* ---- textures ----------------------------------------------------------- */
+
+typedef struct {
+    Nv2aTexture key;
+    uint64_t hash;
+    uint32_t checked;               /* frame of the last hash check */
+    uint32_t bytes;                 /* hashed span, all faces */
+    ID3D11ShaderResourceView *srv;
+    uint32_t used;                  /* frame last used, for eviction */
+} TexEntry;
+
+#define TEX_MAX 512
+static uint8_t s_fmt_bad[256];      /* see tex_get */
+static const Nv2aTexture *s_sync_tex;   /* the texture read that forced a write-back */
+static TexEntry s_tex[TEX_MAX];
+static uint32_t *s_decode;
+static size_t s_decode_cap;
+
+static uint64_t hash_bytes(const uint8_t *p, size_t n)
+{
+    uint64_t h = 0x9E3779B97F4A7C15ull ^ n;
+    size_t i;
+    for (i = 0; i + 8 <= n; i += 8) {
+        uint64_t w;
+        memcpy(&w, p + i, 8);
+        h = (h ^ w) * 0xFF51AFD7ED558CCDull;
+        h ^= h >> 32;
+    }
+    for (; i < n; i++)
+        h = (h ^ p[i]) * 0x100000001B3ull;
+    return h;
+}
+
+static int tex_same(const Nv2aTexture *a, const Nv2aTexture *b)
+{
+    return a->offset == b->offset && a->width == b->width && a->height == b->height
+        && a->pitch == b->pitch && a->color == b->color && a->cube == b->cube
+        && a->palette == b->palette && a->face_stride == b->face_stride
+        && (!s_af || a->levels == b->levels)
+        && (a->depth > 1 ? a->depth : 1) == (b->depth > 1 ? b->depth : 1);
+}
+
+/* Levels a texture is made with: 1, or with RECOMP_D3D11_AF the mip levels
+ * a 2D swizzled/DXT texture stores after level 0 (each half the last, at
+ * least 1, packed with no gap -- tex_face_stride's layout), so anisotropic
+ * filtering has them to choose from. */
+static uint32_t tex_levels(const Nv2aTexture *t)
+{
+    uint32_t n = 1, w = t->width, h = t->height;
+    if (!s_af || t->cube || !t->normalized || t->depth > 1)
+        return 1;
+    while (n < t->levels && n < 13 && (w > 1 || h > 1)) {
+        w = w > 1 ? w / 2 : 1;
+        h = h > 1 ? h / 2 : 1;
+        n++;
+    }
+    return n;
+}
+
+/* Level l of t, one face: its address and size. */
+static Nv2aTexture tex_level(const Nv2aTexture *t, uint32_t l)
+{
+    Nv2aTexture v = *t;
+    uint32_t i;
+    for (i = 0; i < l; i++) {
+        v.offset += nv2a_backend_texture_bytes(&v);
+        v.width = v.width > 1 ? v.width / 2 : 1;
+        v.height = v.height > 1 ? v.height / 2 : 1;
+    }
+    return v;
+}
+
+static uint32_t tex_span(const Nv2aTexture *t)
+{
+    uint32_t n = tex_levels(t), one;
+    if (n > 1) {
+        Nv2aTexture last = tex_level(t, n - 1);
+        return last.offset + nv2a_backend_texture_bytes(&last) - t->offset;
+    }
+    one = nv2a_backend_texture_bytes(t);
+    return t->cube ? t->face_stride * 5 + one : one;
+}
+
+static ID3D11ShaderResourceView *tex_create(const Nv2aTexture *t)
+{
+    D3D11_TEXTURE2D_DESC td;
+    D3D11_SUBRESOURCE_DATA sd[16];
+    D3D11_SHADER_RESOURCE_VIEW_DESC vd;
+    ID3D11Texture2D *tx = NULL;
+    ID3D11ShaderResourceView *v = NULL;
+    uint32_t faces = t->cube ? 6 : 1, levels = tex_levels(t), f, l;
+    size_t texels = 0, at = 0;
+
+    if (!t->width || !t->height || t->width > 4096 || t->height > 4096)
+        return NULL;
+    /* A volume (DIMENSIONALITY 3): a Texture3D of its level 0, decoded slice
+     * by slice; PROJECT3D stages sample it with (s, t, r) (K_TF3). It used to
+     * be read as one flat image, its slices interleaved into stripes. */
+    if (t->depth > 1) {
+        D3D11_TEXTURE3D_DESC d3;
+        D3D11_SUBRESOURCE_DATA s3;
+        ID3D11Texture3D *t3 = NULL;
+        size_t n = (size_t)t->width * t->height * t->depth;
+        if (t->depth > 512 || n > (size_t)16 << 20)
+            return NULL;
+        if (s_decode_cap < n) {
+            free(s_decode);
+            s_decode_cap = n;
+            s_decode = (uint32_t *)malloc(s_decode_cap * 4);
+            if (!s_decode) { s_decode_cap = 0; return NULL; }
+        }
+        if (!nv2a_backend_decode_volume(t, s_decode)) {
+            s_fmt_bad[t->color & 0xFF] = 1;
+            fprintf(stderr, "  [D3D11] volume texture format 0x%X not decodable:"
+                    " sampled as white\n", t->color);
+            return NULL;
+        }
+        memset(&d3, 0, sizeof d3);
+        d3.Width = t->width;
+        d3.Height = t->height;
+        d3.Depth = t->depth;
+        d3.MipLevels = 1;
+        d3.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+        d3.Usage = D3D11_USAGE_IMMUTABLE;
+        d3.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+        s3.pSysMem = s_decode;
+        s3.SysMemPitch = t->width * 4;
+        s3.SysMemSlicePitch = t->width * t->height * 4;
+        if (FAILED(ID3D11Device_CreateTexture3D(s_dev, &d3, &s3, &t3)))
+            return NULL;
+        memset(&vd, 0, sizeof vd);
+        vd.Format = d3.Format;
+        vd.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE3D;
+        vd.Texture3D.MipLevels = 1;
+        ID3D11Device_CreateShaderResourceView(s_dev, (ID3D11Resource *)t3, &vd, &v);
+        ID3D11Texture3D_Release(t3);
+        {
+            static int shown;
+            if (shown++ < 4)
+                fprintf(stderr, "  [D3D11] volume texture %08X fmt %02X %ux%ux%u\n",
+                        t->offset, t->color, t->width, t->height, t->depth);
+        }
+        /* RECOMP_D3D11_VOL_DUMP=1: each new volume's slices top to bottom,
+         * alpha beside the colour, to d3d11_vol_<address>.bmp. */
+        if (getenv("RECOMP_D3D11_VOL_DUMP") && t->width <= 1024) {
+            static uint32_t done[64];
+            static int ndone;
+            int k, seen = 0;
+            for (k = 0; k < ndone; k++)
+                seen |= done[k] == t->offset;
+            if (!seen && ndone < 64) {
+                uint32_t w = t->width, h = t->height * t->depth, x, y;
+                uint32_t row = ((w * 2 * 3) + 3) & ~3u, sz = 54 + row * h;
+                uint8_t hdr[54] = { 'B', 'M' }, line[2048 * 3 + 4];
+                char name[64];
+                FILE *f;
+                done[ndone++] = t->offset;
+                snprintf(name, sizeof name, "d3d11_vol_%08X.bmp", t->offset);
+                if ((f = fopen(name, "wb")) != NULL) {
+                    uint32_t ww = w * 2;
+                    int32_t hh = -(int32_t)h;
+                    memcpy(hdr + 2, &sz, 4); hdr[10] = 54; hdr[14] = 40;
+                    memcpy(hdr + 18, &ww, 4); memcpy(hdr + 22, &hh, 4);
+                    hdr[26] = 1; hdr[28] = 24;
+                    fwrite(hdr, 1, 54, f);
+                    for (y = 0; y < h; y++) {
+                        memset(line, 0, sizeof line);
+                        for (x = 0; x < w; x++) {
+                            uint32_t p = s_decode[(size_t)y * w + x];
+                            line[x * 3 + 0] = (uint8_t)p;
+                            line[x * 3 + 1] = (uint8_t)(p >> 8);
+                            line[x * 3 + 2] = (uint8_t)(p >> 16);
+                            line[(w + x) * 3 + 0] = line[(w + x) * 3 + 1] =
+                                line[(w + x) * 3 + 2] = (uint8_t)(p >> 24);
+                        }
+                        fwrite(line, 1, row, f);
+                    }
+                    fclose(f);
+                    fprintf(stderr, "  [D3D11] volume %08X fmt %02X -> %s\n",
+                            t->offset, t->color, name);
+                }
+            }
+        }
+        return v;
+    }
+    for (l = 0; l < levels; l++) {
+        Nv2aTexture lv = tex_level(t, l);
+        texels += (size_t)lv.width * lv.height;
+    }
+    if (s_decode_cap < texels * faces) {
+        free(s_decode);
+        s_decode_cap = texels * faces;
+        s_decode = (uint32_t *)malloc(s_decode_cap * 4);
+        if (!s_decode) { s_decode_cap = 0; return NULL; }
+    }
+    /* RECOMP_D3D11_TEX_DUMP also covers DXT: decoded on the CPU for the
+     * dump only, then uploaded as blocks below. */
+    if ((t->color == 0x0C || t->color == 0x0E || t->color == 0x0F)
+        && getenv("RECOMP_D3D11_TEX_DUMP")) {
+        const char *e = getenv("RECOMP_D3D11_TEX_DUMP");
+        char key[16];
+        snprintf(key, sizeof key, "%08X", t->offset & 0x0FFFFFFFu);
+        if (strstr(e, key) && s_decode_cap >= (size_t)t->width * t->height
+            && nv2a_backend_decode_texture(t, s_decode)) {
+            uint32_t w = t->width, h = t->height, x, y, row = ((w * 2 * 3) + 3) & ~3u;
+            uint8_t hdr[54] = { 'B', 'M' };
+            uint32_t sz = 54 + row * h, ww = w * 2;
+            int32_t hh = -(int32_t)h;
+            char name[96];
+            FILE *f;
+            snprintf(name, sizeof name, "d3d11_tex_%s_0.bmp", key);
+            if ((f = fopen(name, "wb")) != NULL) {
+                memcpy(hdr + 2, &sz, 4); hdr[10] = 54; hdr[14] = 40;
+                memcpy(hdr + 18, &ww, 4); memcpy(hdr + 22, &hh, 4);
+                hdr[26] = 1; hdr[28] = 24;
+                fwrite(hdr, 1, 54, f);
+                for (y = 0; y < h; y++) {
+                    static uint8_t line[8192 * 3 + 4];
+                    memset(line, 0, sizeof line);
+                    for (x = 0; x < w && x < 4096; x++) {
+                        uint32_t p = s_decode[(size_t)y * w + x];
+                        line[x * 3 + 0] = (uint8_t)p;
+                        line[x * 3 + 1] = (uint8_t)(p >> 8);
+                        line[x * 3 + 2] = (uint8_t)(p >> 16);
+                        line[(w + x) * 3 + 0] = line[(w + x) * 3 + 1] =
+                            line[(w + x) * 3 + 2] = (uint8_t)(p >> 24);
+                    }
+                    fwrite(line, 1, row, f);
+                }
+                fclose(f);
+                fprintf(stderr, "  [D3D11] texture %s fmt %02X (%ux%u, DXT) -> %s\n",
+                        key, t->color, w, h, name);
+            }
+        }
+    }
+    /* DXT goes to the GPU as it is: BC1/BC2/BC3 are the same blocks. */
+    if ((t->color == 0x0C || t->color == 0x0E || t->color == 0x0F)
+        && !(t->width & 3) && !(t->height & 3)) {
+        const uint8_t *mem = (const uint8_t *)xbox_GetMemoryOffset();
+        UINT bb = t->color == 0x0C ? 8 : 16;
+        for (f = 0; f < faces; f++)
+            for (l = 0; l < levels; l++) {
+                Nv2aTexture lv = tex_level(t, l);
+                D3D11_SUBRESOURCE_DATA *d = &sd[f * levels + l];
+                d->pSysMem = mem + lv.offset + f * t->face_stride;
+                d->SysMemPitch = ((lv.width + 3) / 4) * bb;
+                d->SysMemSlicePitch = d->SysMemPitch * ((lv.height + 3) / 4);
+            }
+        memset(&td, 0, sizeof td);
+        td.Width = t->width;
+        td.Height = t->height;
+        td.MipLevels = levels;
+        td.ArraySize = faces;
+        td.Format = t->color == 0x0C ? DXGI_FORMAT_BC1_UNORM
+                  : t->color == 0x0E ? DXGI_FORMAT_BC2_UNORM : DXGI_FORMAT_BC3_UNORM;
+        goto create;
+    }
+    for (f = 0; f < faces; f++)
+    for (l = 0; l < levels; l++) {
+        Nv2aTexture one = tex_level(t, l);
+        uint32_t tw = one.width, th = one.height;
+        size_t n = (size_t)tw * th;
+        uint32_t *dst = s_decode + at;
+        const uint8_t *src = (const uint8_t *)xbox_GetMemoryOffset() + one.offset
+                           + f * t->face_stride;
+        int pow2 = !(tw & (tw - 1)) && !(th & (th - 1));
+        one.offset += f * t->face_stride;
+        at += n;
+        sd[f * levels + l].pSysMem = dst;
+        sd[f * levels + l].SysMemPitch = tw * 4;
+        sd[f * levels + l].SysMemSlicePitch = (UINT)(n * 4);
+        /* 32-bit ARGB in bulk: the same bytes as B8G8R8A8, just placed. */
+        if ((t->color == 0x06 || t->color == 0x07) && pow2) {       /* swizzled */
+            xbox_unswizzle_rect(dst, src, tw, th, 4);
+            if (t->color == 0x07) {
+                size_t k;
+                for (k = 0; k < n; k++) dst[k] |= 0xFF000000u;
+            }
+            continue;
+        }
+        if ((t->color == 0x12 || t->color == 0x1E) && t->pitch >= tw * 4) {
+            uint32_t y;
+            for (y = 0; y < th; y++) {
+                memcpy(dst + (size_t)y * tw, src + (size_t)y * t->pitch, (size_t)tw * 4);
+                if (t->color == 0x1E) {
+                    uint32_t x;
+                    for (x = 0; x < tw; x++)
+                        dst[(size_t)y * tw + x] |= 0xFF000000u;
+                }
+            }
+            continue;
+        }
+        /* Two 8-bit channels in 16 bits, widened in place from the top down
+         * so no texel is overwritten before it is read. Same channel mapping
+         * as the executor's decoder: G8B8 reads (B,G,B,G), A8Y8 (Y,Y,Y,A). */
+        if ((t->color == 0x17 && t->pitch >= tw * 2)                /* LIN_G8B8 */
+            || (t->color == 0x1A && pow2)) {                        /* SZ_A8Y8 */
+            uint16_t *s16 = (uint16_t *)dst;
+            size_t k;
+            if (t->color == 0x1A)
+                xbox_unswizzle_rect(dst, src, tw, th, 2);
+            else {
+                uint32_t y;
+                for (y = 0; y < th; y++)
+                    memcpy(s16 + (size_t)y * tw, src + (size_t)y * t->pitch, (size_t)tw * 2);
+            }
+            for (k = n; k-- > 0; ) {
+                uint32_t v = s16[k], lo = v & 0xFFu, hi = v >> 8;
+                dst[k] = t->color == 0x17 ? (hi << 24) | (lo << 16) | (hi << 8) | lo
+                                          : (hi << 24) | (lo * 0x010101u);
+            }
+            continue;
+        }
+        if (!nv2a_backend_decode_texture(&one, dst)) {
+            s_fmt_bad[t->color & 0xFF] = 1;
+            fprintf(stderr, "  [D3D11] texture format 0x%X not decodable: sampled as white\n",
+                    t->color);
+            return NULL;                /* unsupported format: white */
+        }
+    }
+    /* RECOMP_D3D11_TEX_DUMP=<hex address>[,...]: write the texture at that address
+     * as it goes to the GPU, every level, alpha in its own image beside the
+     * colour, to d3d11_tex_<address>_<level>.bmp in the working directory. */
+    {
+        static int init, nwant;
+        static uint32_t wants[16];
+        uint32_t want = 0;
+        int wi;
+        if (!init) {
+            const char *e = getenv("RECOMP_D3D11_TEX_DUMP");
+            char *end;
+            while (e && *e && nwant < 16) {
+                wants[nwant++] = (uint32_t)strtoul(e, &end, 16) & 0x0FFFFFFFu;
+                e = (*end == ',') ? end + 1 : NULL;
+            }
+            init = 1;
+        }
+        for (wi = 0; wi < nwant; wi++)
+            if ((t->offset & 0x0FFFFFFFu) == wants[wi])
+                want = wants[wi];
+        if (want) {
+            size_t lat = 0;
+            for (l = 0; l < levels; l++) {
+                Nv2aTexture lv = tex_level(t, l);
+                uint32_t w = lv.width, h = lv.height, x, y, row = ((w * 2 * 3) + 3) & ~3u;
+                char name[96];
+                FILE *f;
+                uint8_t hdr[54] = { 'B', 'M' };
+                uint32_t sz = 54 + row * h;
+                snprintf(name, sizeof name, "d3d11_tex_%08X_%u.bmp", want, l);
+                if ((f = fopen(name, "wb")) != NULL) {
+                    memcpy(hdr + 2, &sz, 4); hdr[10] = 54; hdr[14] = 40;
+                    { uint32_t ww = w * 2; int32_t hh = -(int32_t)h;
+                      memcpy(hdr + 18, &ww, 4); memcpy(hdr + 22, &hh, 4); }
+                    hdr[26] = 1; hdr[28] = 24;
+                    fwrite(hdr, 1, 54, f);
+                    for (y = 0; y < h; y++) {
+                        uint8_t line[8192 * 3 + 4] = { 0 };
+                        for (x = 0; x < w && x < 4096; x++) {
+                            uint32_t p = s_decode[lat + (size_t)y * w + x];
+                            line[x * 3 + 0] = (uint8_t)p;
+                            line[x * 3 + 1] = (uint8_t)(p >> 8);
+                            line[x * 3 + 2] = (uint8_t)(p >> 16);
+                            line[(w + x) * 3 + 0] = line[(w + x) * 3 + 1] =
+                                line[(w + x) * 3 + 2] = (uint8_t)(p >> 24);
+                        }
+                        fwrite(line, 1, row, f);
+                    }
+                    fclose(f);
+                    fprintf(stderr, "  [D3D11] texture %08X fmt %02X level %u (%ux%u) -> %s\n",
+                            want, t->color, l, w, h, name);
+                }
+                lat += (size_t)w * h;
+            }
+        }
+    }
+    memset(&td, 0, sizeof td);
+    td.Width = t->width;
+    td.Height = t->height;
+    td.MipLevels = levels;
+    td.ArraySize = faces;
+    td.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+create:
+    td.SampleDesc.Count = 1;
+    td.Usage = D3D11_USAGE_IMMUTABLE;
+    td.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+    td.MiscFlags = t->cube ? D3D11_RESOURCE_MISC_TEXTURECUBE : 0;
+    if (FAILED(ID3D11Device_CreateTexture2D(s_dev, &td, sd, &tx)))
+        return NULL;
+    memset(&vd, 0, sizeof vd);
+    vd.Format = td.Format;
+    if (t->cube) {
+        vd.ViewDimension = D3D11_SRV_DIMENSION_TEXTURECUBE;
+        vd.TextureCube.MipLevels = 1;
+    } else {
+        vd.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE2D;
+        vd.Texture2D.MipLevels = levels;
+    }
+    ID3D11Device_CreateShaderResourceView(s_dev, (ID3D11Resource *)tx, &vd, &v);
+    ID3D11Texture2D_Release(tx);
+    return v;
+}
+
+static ID3D11ShaderResourceView *rt_alias(const Nv2aTexture *t, float *w, float *h,
+                                          int *g8b8);
+static void rt_sync_overlap(uint32_t va, uint32_t n);
+static ID3D11ShaderResourceView *tex_get_decoded(const Nv2aTexture *t);
+
+/* The view a stage samples, and the size its texel coordinates divide by:
+ * a render target the title draws into and then samples is used where it
+ * is, on the GPU (*g8b8 set when the stage must read it as (B,G,B,G), the
+ * shader's K_TFG remap); anything else comes from guest memory, decoded. */
+/* Colour formats the executor's decoder cannot read. The CPU rasteriser
+ * samples white for them; so does this, without hashing or writing anything
+ * back first. */
+static int s_tex_rt;                /* the last tex_get was a render target */
+static int s_tex_z;                 /* ... the depth buffer (ds_alias): nearest */
+static uint32_t s_cur_zeta;         /* the depth surface bound for drawing */
+static ID3D11ShaderResourceView *ds_alias(const Nv2aTexture *t);
+
+static ID3D11ShaderResourceView *tex_get(const Nv2aTexture *t, float *w, float *h,
+                                         int *g8b8)
+{
+    ID3D11ShaderResourceView *a;
+    *g8b8 = 0;
+    s_tex_rt = s_tex_z = 0;
+    if (s_fmt_bad[t->color & 0xFF])
+        return NULL;
+    *w = (float)t->width;
+    *h = (float)t->height;
+    /* The bound depth surface first: its memory may also hold a colour
+     * target from before (menus drew there), stale since the depth moved
+     * in. */
+    if (t->offset == s_cur_zeta && (a = ds_alias(t)) != NULL)
+        s_tex_z = 1;
+    else
+        a = t->depth > 1 ? NULL : rt_alias(t, w, h, g8b8);
+    if (!a && (a = ds_alias(t)) != NULL)
+        s_tex_z = 1;
+    s_tex_rt = a != NULL;
+    if (a)
+        return a;
+    /* Memory a render target has drawn newer pixels into must be written
+     * back before it can be read as an ordinary texture. */
+    s_sync_tex = t;
+    rt_sync_overlap(t->offset, tex_span(t));
+    s_sync_tex = NULL;
+    return tex_get_decoded(t);
+}
+
+/* RECOMP_TEX_HASHES=<n>: each new 2D texture up to n texels on a side,
+ * once per hash, logged with the hash a replacement is keyed on and saved as
+ * texhash_<hash>.bmp (colour, then alpha beside it) in the working
+ * directory -- for finding the textures a title wants to replace. */
+static void tex_hash_note(const Nv2aTexture *t, uint64_t hash)
+{
+    static uint64_t seen[1024];
+    static int nseen;
+    uint32_t w = t->width, h = t->height, x, y, row = ((w * 2 * 3) + 3) & ~3u;
+    uint32_t *px;
+    char name[64];
+    FILE *f;
+    int i;
+
+    for (i = 0; i < nseen; i++)
+        if (seen[i] == hash)
+            return;
+    if (nseen < 1024)
+        seen[nseen++] = hash;
+    fprintf(stderr, "  [TEXHASH] %016llX %ux%u fmt 0x%02X at %08X\n",
+            (unsigned long long)hash, w, h, t->color, t->offset);
+    px = (uint32_t *)malloc((size_t)w * h * 4);
+    if (!px)
+        return;
+    snprintf(name, sizeof name, "texhash_%016llX.bmp", (unsigned long long)hash);
+    if (nv2a_backend_decode_texture(t, px) && (f = fopen(name, "wb")) != NULL) {
+        uint8_t hdr[54] = { 'B', 'M' }, *line = (uint8_t *)calloc(row, 1);
+        uint32_t sz = 54 + row * h, ww = w * 2;
+        int32_t hh = -(int32_t)h;
+        memcpy(hdr + 2, &sz, 4); hdr[10] = 54; hdr[14] = 40;
+        memcpy(hdr + 18, &ww, 4); memcpy(hdr + 22, &hh, 4);
+        hdr[26] = 1; hdr[28] = 24;
+        fwrite(hdr, 1, 54, f);
+        for (y = 0; line && y < h; y++) {
+            for (x = 0; x < w; x++) {
+                uint32_t c = px[y * w + x];
+                line[x * 3] = (uint8_t)c;
+                line[x * 3 + 1] = (uint8_t)(c >> 8);
+                line[x * 3 + 2] = (uint8_t)(c >> 16);
+                line[(w + x) * 3] = line[(w + x) * 3 + 1]
+                    = line[(w + x) * 3 + 2] = (uint8_t)(c >> 24);
+            }
+            fwrite(line, 1, row, f);
+        }
+        free(line);
+        fclose(f);
+    }
+    free(px);
+}
+
+/* The title's own picture for a texture (nv2a_backend_set_tex_replace), with
+ * mip levels box-filtered down to 1x1, or NULL to decode the guest's. */
+static ID3D11ShaderResourceView *tex_replaced(const Nv2aTexture *t, uint64_t hash)
+{
+    static int lim = -1;
+    Nv2aTexReplaceFn fn = nv2a_backend_tex_replace();
+    const uint32_t *src = NULL;
+    uint32_t w = 0, h = 0, levels = 1, l, x, y, lw, lh;
+    D3D11_TEXTURE2D_DESC td;
+    D3D11_SUBRESOURCE_DATA sd[16];
+    D3D11_SHADER_RESOURCE_VIEW_DESC vd;
+    ID3D11Texture2D *tx = NULL;
+    ID3D11ShaderResourceView *v = NULL;
+    uint32_t *mips[16] = { 0 };
+
+    if (lim < 0) {
+        const char *e = getenv("RECOMP_TEX_HASHES");
+        lim = e ? atoi(e) : 0;
+    }
+    if (t->cube || t->depth > 1)
+        return NULL;
+    if (lim > 0 && t->width <= (uint32_t)lim && t->height <= (uint32_t)lim)
+        tex_hash_note(t, hash);
+    if (!fn || !fn(hash, t, &src, &w, &h) || !src || !w || !h || w > 4096 || h > 4096)
+        return NULL;
+    while (levels < 16 && ((w >> levels) || (h >> levels)))
+        levels++;
+    for (l = 0; l < levels; l++) {
+        lw = w >> l ? w >> l : 1;
+        lh = h >> l ? h >> l : 1;
+        if (l == 0) {
+            sd[0].pSysMem = src;
+        } else {
+            uint32_t pw = w >> (l - 1) ? w >> (l - 1) : 1, ph = h >> (l - 1) ? h >> (l - 1) : 1;
+            const uint32_t *p = l == 1 ? src : mips[l - 1];
+            if ((mips[l] = (uint32_t *)malloc((size_t)lw * lh * 4)) == NULL)
+                break;
+            for (y = 0; y < lh; y++)
+                for (x = 0; x < lw; x++) {
+                    uint32_t x0 = x * 2 < pw ? x * 2 : pw - 1, x1 = x * 2 + 1 < pw ? x * 2 + 1 : x0;
+                    uint32_t y0 = y * 2 < ph ? y * 2 : ph - 1, y1 = y * 2 + 1 < ph ? y * 2 + 1 : y0;
+                    uint32_t c[4] = { p[y0 * pw + x0], p[y0 * pw + x1], p[y1 * pw + x0], p[y1 * pw + x1] };
+                    uint32_t out = 0, sh;
+                    for (sh = 0; sh < 32; sh += 8)
+                        out |= ((((c[0] >> sh) & 0xFF) + ((c[1] >> sh) & 0xFF) + ((c[2] >> sh) & 0xFF)
+                                 + ((c[3] >> sh) & 0xFF) + 2) / 4) << sh;
+                    mips[l][y * lw + x] = out;
+                }
+            sd[l].pSysMem = mips[l];
+        }
+        sd[l].SysMemPitch = lw * 4;
+        sd[l].SysMemSlicePitch = 0;
+    }
+    levels = l;
+    memset(&td, 0, sizeof td);
+    td.Width = w;
+    td.Height = h;
+    td.MipLevels = levels;
+    td.ArraySize = 1;
+    td.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    td.SampleDesc.Count = 1;
+    td.Usage = D3D11_USAGE_IMMUTABLE;
+    td.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+    if (SUCCEEDED(ID3D11Device_CreateTexture2D(s_dev, &td, sd, &tx))) {
+        memset(&vd, 0, sizeof vd);
+        vd.Format = td.Format;
+        vd.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE2D;
+        vd.Texture2D.MipLevels = levels;
+        ID3D11Device_CreateShaderResourceView(s_dev, (ID3D11Resource *)tx, &vd, &v);
+        ID3D11Texture2D_Release(tx);
+    }
+    for (l = 1; l < 16; l++)
+        free(mips[l]);
+    {
+        static int shown;
+        if (v && shown++ < 16)
+            fprintf(stderr, "  [D3D11] texture %08X %ux%u (hash %016llX) replaced by the title's %ux%u\n",
+                    t->offset, t->width, t->height, (unsigned long long)hash, w, h);
+    }
+    return v;
+}
+
+/* Where a texture was found last, by address and format: a frame binds the
+ * same few hundred textures for thousands of stage lookups. */
+static uint16_t s_tex_hint[1024];
+
+static ID3D11ShaderResourceView *tex_get_decoded(const Nv2aTexture *t)
+{
+    const uint8_t *mem = (const uint8_t *)xbox_GetMemoryOffset();
+    TexEntry *e = NULL, *victim = &s_tex[0];
+    uint32_t hk = ((t->offset >> 6) ^ (t->offset >> 16) ^ (t->color * 0x9E37u)) & 1023u;
+    int i;
+
+    if (s_tex[s_tex_hint[hk]].bytes && tex_same(&s_tex[s_tex_hint[hk]].key, t))
+        e = &s_tex[s_tex_hint[hk]];
+    else
+        for (i = 0; i < TEX_MAX; i++) {
+            if (s_tex[i].bytes && tex_same(&s_tex[i].key, t)) { e = &s_tex[i]; break; }
+            if (s_tex[i].used < victim->used) victim = &s_tex[i];
+        }
+    if (!e)
+        s_tex_hint[hk] = (uint16_t)(victim - s_tex);
+    else
+        s_tex_hint[hk] = (uint16_t)(e - s_tex);
+    if (e && e->checked == s_frame) {
+        e->used = s_frame;
+        return e->srv;
+    }
+    {
+        uint32_t span = tex_span(t);
+        uint64_t h = span ? hash_bytes(mem + t->offset, span) : 0;
+        s_st.hashes++;
+        s_st.hash_bytes += span;
+        if (e && e->hash == h) {
+            e->checked = s_frame;
+            e->used = s_frame;
+            return e->srv;
+        }
+        if (!e) {
+            e = victim;
+            if (e->srv) ID3D11ShaderResourceView_Release(e->srv);
+            memset(e, 0, sizeof *e);
+        } else if (e->srv) {
+            ID3D11ShaderResourceView_Release(e->srv);
+            e->srv = NULL;
+        }
+        e->key = *t;
+        e->hash = h;
+        e->bytes = span ? span : 1;
+        e->checked = s_frame;
+        e->used = s_frame;
+        e->srv = tex_replaced(t, h);
+        if (!e->srv)
+            e->srv = tex_create(t);
+        s_st.decodes++;
+        s_st.decode_texels += (uint64_t)t->width * t->height * (t->cube ? 6 : 1);
+        return e->srv;
+    }
+}
+
+/* A write-back landed on [va, va+n): re-check any texture there. */
+static void tex_invalidate(uint32_t va, uint32_t n)
+{
+    int i;
+    for (i = 0; i < TEX_MAX; i++)
+        if (s_tex[i].bytes && s_tex[i].key.offset < va + n
+            && va < s_tex[i].key.offset + s_tex[i].bytes)
+            s_tex[i].checked = 0;
+}
+
+/* ---- render targets ----------------------------------------------------- */
+
+typedef struct {
+    uint32_t va, pitch, width, height, bpp;
+    ID3D11Texture2D *tex, *staging;
+    ID3D11RenderTargetView *rtv;
+    ID3D11ShaderResourceView *srv;
+    ID3D11Texture2D *copy;              /* for sampling while drawn into */
+    ID3D11ShaderResourceView *copy_srv;
+    int dirty;              /* the GPU holds pixels guest memory does not */
+    int gpu_valid;          /* the render target holds the surface at all */
+    uint64_t guest_hash;    /* guest bytes when the two last agreed */
+    uint32_t alias_frame;   /* rt_alias last checked guest_hash (s_frame) */
+    uint32_t drawn_frame;   /* s_frame when it was last made current */
+    /* A 16-bit surface drawn as G8B8 (surface colour format 0xA) rather
+     * than R5G6B5: its low byte is the blue channel and its high byte green,
+     * so the BGRA target holds them in blue and green and a pixel's low
+     * 16 bits are the guest's. */
+    int g8b8;
+    /* RECOMP_RENDER_SCALE: tex is sw x sh; `lo` is a guest-sized
+     * go-between for uploads and write-backs. aa_* is the surface's
+     * anti-aliasing factor, for presenting the right part of it. */
+    uint32_t sw, sh, aa_sx, aa_sy;
+    ID3D11Texture2D *lo;
+    ID3D11RenderTargetView *lo_rtv;
+    ID3D11ShaderResourceView *lo_srv;
+    /* RECOMP_D3D11_MSAA: draws go to `ms`, s_msaa samples a pixel, and tex
+     * is its resolved image, current when ms_dirty is clear. */
+    ID3D11Texture2D *ms;
+    ID3D11RenderTargetView *ms_rtv;
+    int ms_dirty;
+} Target;
+
+typedef struct {
+    uint32_t va, width, height;
+    ID3D11Texture2D *tex;
+    ID3D11DepthStencilView *dsv;
+    /* ds_alias: depth and stencil views of tex, and the buffer packed into
+     * guest Z24S8 bytes (pk) for a texture that reads the zeta surface. */
+    ID3D11ShaderResourceView *srv_z, *srv_s;
+    ID3D11Texture2D *pk;
+    ID3D11UnorderedAccessView *pk_uav;
+    ID3D11ShaderResourceView *pk_srv;
+} Depth;
+
+#define RT_MAX 16
+static Target s_rt[RT_MAX];
+static Depth s_ds[8];
+static Target *s_cur;
+static uint32_t *s_conv;
+static size_t s_conv_cap;
+
+static uint32_t *conv_buf(size_t texels)
+{
+    if (s_conv_cap < texels) {
+        free(s_conv);
+        s_conv = (uint32_t *)malloc(texels * 4);
+        s_conv_cap = s_conv ? texels : 0;
+    }
+    return s_conv;
+}
+
+
+/* ---- scaled rendering and presenting ------------------------------------ *
+ *
+ * RECOMP_RENDER_SCALE=<f> (1 to 4) draws every render target f times the
+ * guest's resolution: 2.25 turns MechAssault 2's 640x480 into 1440x1080.
+ * Vertex positions stay in guest pixels (the clip-space mapping divides by
+ * the guest size), and the viewport, scissor and clears are scaled, so the
+ * title sees nothing different. Where pixels cross between guest memory and
+ * a target -- the CPU wrote a surface, or something reads one back -- a
+ * guest-sized texture sits in between and a blit scales them.
+ *
+ * The finished frame goes to the window straight from the GPU, through a
+ * swap chain on the framebuffer window (letterboxed to the display mode's
+ * shape), instead of being read back for the window to draw with GDI; that
+ * keeps the resolution, and saves the read-back. RECOMP_D3D11_PRESENT=0
+ * goes back to the GDI window, RECOMP_VSYNC=1 waits for the display.
+ */
+extern HWND xbox_FramebufferWindowHwnd(void);
+extern void xbox_FramebufferWindowGpuPresent(int on);
+extern void xbox_FramebufferWindowDisplaySize(uint32_t *w, uint32_t *h);
+extern void xbox_FramebufferWindowDisplayAspect(uint32_t *aw, uint32_t *ah);
+
+static const char s_hlsl_blit[] =
+"Texture2D BT : register(t0); SamplerState BS : register(s0);\n"
+"cbuffer BC : register(b0) { float4 g_uv; };\n"
+"struct BV { float4 pos : SV_Position; float2 uv : TEXCOORD0; };\n"
+"BV vs_blit(uint id : SV_VertexID) {\n"
+"  BV o; float2 p = float2((id << 1) & 2, id & 2);\n"
+"  o.pos = float4(p * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0);\n"
+"  o.uv = lerp(g_uv.xy, g_uv.zw, p); return o;\n"
+"}\n"
+"float4 ps_blit(BV i) : SV_Target { return BT.SampleLevel(BS, i.uv, 0); }\n";
+
+static ID3D11VertexShader *s_vs_blit;
+static ID3D11PixelShader *s_ps_blit;
+static ID3D11Buffer *s_cb_blit;
+static ID3D11SamplerState *s_smp_lin;
+static ID3D11RasterizerState *s_rs_blit;
+static ID3D11BlendState *s_bs_blit;
+static ID3D11DepthStencilState *s_dss_blit;
+
+static int blit_init(void)
+{
+    static int done;
+    ID3DBlob *vb = NULL, *pb = NULL, *err = NULL;
+    D3D11_BUFFER_DESC bd;
+    D3D11_SAMPLER_DESC sd;
+    D3D11_RASTERIZER_DESC rd;
+    D3D11_BLEND_DESC bld;
+    D3D11_DEPTH_STENCIL_DESC dd;
+
+    if (done)
+        return done > 0;
+    done = -1;
+    if (FAILED(D3DCompile(s_hlsl_blit, sizeof s_hlsl_blit - 1, "blit", NULL, NULL, "vs_blit",
+                          "vs_5_0", 0, 0, &vb, &err))
+        || FAILED(D3DCompile(s_hlsl_blit, sizeof s_hlsl_blit - 1, "blit", NULL, NULL, "ps_blit",
+                             "ps_5_0", 0, 0, &pb, &err))) {
+        fprintf(stderr, "  [D3D11] blit shader: %s\n",
+                err ? (const char *)ID3D10Blob_GetBufferPointer(err) : "?");
+        return 0;
+    }
+    ID3D11Device_CreateVertexShader(s_dev, ID3D10Blob_GetBufferPointer(vb),
+                                    ID3D10Blob_GetBufferSize(vb), NULL, &s_vs_blit);
+    ID3D11Device_CreatePixelShader(s_dev, ID3D10Blob_GetBufferPointer(pb),
+                                   ID3D10Blob_GetBufferSize(pb), NULL, &s_ps_blit);
+    ID3D10Blob_Release(vb);
+    ID3D10Blob_Release(pb);
+    memset(&bd, 0, sizeof bd);
+    bd.ByteWidth = 16;
+    bd.Usage = D3D11_USAGE_DYNAMIC;
+    bd.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+    bd.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+    ID3D11Device_CreateBuffer(s_dev, &bd, NULL, &s_cb_blit);
+    memset(&sd, 0, sizeof sd);
+    sd.Filter = D3D11_FILTER_MIN_MAG_MIP_LINEAR;
+    sd.AddressU = sd.AddressV = sd.AddressW = D3D11_TEXTURE_ADDRESS_CLAMP;
+    sd.MaxLOD = D3D11_FLOAT32_MAX;
+    ID3D11Device_CreateSamplerState(s_dev, &sd, &s_smp_lin);
+    memset(&rd, 0, sizeof rd);
+    rd.FillMode = D3D11_FILL_SOLID;
+    rd.CullMode = D3D11_CULL_NONE;
+    rd.DepthClipEnable = TRUE;
+    ID3D11Device_CreateRasterizerState(s_dev, &rd, &s_rs_blit);
+    memset(&bld, 0, sizeof bld);
+    bld.RenderTarget[0].RenderTargetWriteMask = D3D11_COLOR_WRITE_ENABLE_ALL;
+    bld.RenderTarget[0].SrcBlend = bld.RenderTarget[0].SrcBlendAlpha = D3D11_BLEND_ONE;
+    bld.RenderTarget[0].DestBlend = bld.RenderTarget[0].DestBlendAlpha = D3D11_BLEND_ZERO;
+    bld.RenderTarget[0].BlendOp = bld.RenderTarget[0].BlendOpAlpha = D3D11_BLEND_OP_ADD;
+    ID3D11Device_CreateBlendState(s_dev, &bld, &s_bs_blit);
+    memset(&dd, 0, sizeof dd);
+    ID3D11Device_CreateDepthStencilState(s_dev, &dd, &s_dss_blit);
+    done = s_vs_blit && s_ps_blit && s_cb_blit && s_smp_lin && s_rs_blit
+        && s_bs_blit && s_dss_blit ? 1 : -1;
+    return done > 0;
+}
+
+/* Draw `src` (texture coordinates u0,v0..u1,v1) into the rectangle
+ * x,y,w,h of `dst`. Leaves the output merger, viewport and scissor as it
+ * found them: blits happen in the middle of setting up a draw (a texture
+ * read that needs a target written back). */
+static void blit(ID3D11ShaderResourceView *src, ID3D11RenderTargetView *dst,
+                 float x, float y, float w, float h,
+                 float u0, float v0, float u1, float v1)
+{
+    ID3D11RenderTargetView *old_rtv = NULL;
+    ID3D11DepthStencilView *old_dsv = NULL;
+    D3D11_VIEWPORT old_vp, vp;
+    D3D11_RECT old_sc;
+    UINT nvp = 1, nsc = 1, zero = 0;
+    D3D11_MAPPED_SUBRESOURCE m;
+    ID3D11ShaderResourceView *none = NULL;
+
+    if (!blit_init())
+        return;
+    ID3D11DeviceContext_OMGetRenderTargets(s_ctx, 1, &old_rtv, &old_dsv);
+    ID3D11DeviceContext_RSGetViewports(s_ctx, &nvp, &old_vp);
+    ID3D11DeviceContext_RSGetScissorRects(s_ctx, &nsc, &old_sc);
+
+    if (SUCCEEDED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)s_cb_blit, 0,
+                                          D3D11_MAP_WRITE_DISCARD, 0, &m))) {
+        float *f = (float *)m.pData;
+        f[0] = u0; f[1] = v0; f[2] = u1; f[3] = v1;
+        ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)s_cb_blit, 0);
+    }
+    ID3D11DeviceContext_PSSetShaderResources(s_ctx, 0, 1, &none);
+    ID3D11DeviceContext_OMSetRenderTargets(s_ctx, 1, &dst, NULL);
+    vp.TopLeftX = x; vp.TopLeftY = y; vp.Width = w; vp.Height = h;
+    vp.MinDepth = 0.0f; vp.MaxDepth = 1.0f;
+    ID3D11DeviceContext_RSSetViewports(s_ctx, 1, &vp);
+    ID3D11DeviceContext_RSSetState(s_ctx, s_rs_blit);
+    ID3D11DeviceContext_OMSetBlendState(s_ctx, s_bs_blit, NULL, 0xFFFFFFFFu);
+    ID3D11DeviceContext_OMSetDepthStencilState(s_ctx, s_dss_blit, 0);
+    ID3D11DeviceContext_IASetInputLayout(s_ctx, NULL);
+    ID3D11DeviceContext_IASetPrimitiveTopology(s_ctx, D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    ID3D11DeviceContext_VSSetShader(s_ctx, s_vs_blit, NULL, 0);
+    ID3D11DeviceContext_VSSetConstantBuffers(s_ctx, 0, 1, &s_cb_blit);
+    ID3D11DeviceContext_PSSetShader(s_ctx, s_ps_blit, NULL, 0);
+    ID3D11DeviceContext_PSSetShaderResources(s_ctx, 0, 1, &src);
+    ID3D11DeviceContext_PSSetSamplers(s_ctx, 0, 1, &s_smp_lin);
+    ID3D11DeviceContext_Draw(s_ctx, 3, 0);
+    ID3D11DeviceContext_PSSetShaderResources(s_ctx, 0, 1, &none);
+
+    ID3D11DeviceContext_OMSetRenderTargets(s_ctx, old_rtv ? 1 : 0, &old_rtv, old_dsv);
+    if (nvp) ID3D11DeviceContext_RSSetViewports(s_ctx, 1, &old_vp);
+    if (nsc) ID3D11DeviceContext_RSSetScissorRects(s_ctx, 1, &old_sc);
+    if (old_rtv) ID3D11RenderTargetView_Release(old_rtv);
+    if (old_dsv) ID3D11DepthStencilView_Release(old_dsv);
+    (void)zero;
+}
+
+static UINT scaled(uint32_t v)
+{
+    return (UINT)(v * s_scale + 0.5f);
+}
+
+/* RECOMP_D3D11_MSAA=2/4/8: every render target and depth buffer has that
+ * many samples a pixel, and the title draws into those. Anything that reads
+ * a target -- a texture lookup (rt_alias), a write-back to guest memory,
+ * the window -- reads `tex`, so it is resolved first: the samples averaged
+ * into it, once per batch of drawing. Pixels going the other way (uploads)
+ * land in tex and are copied to every sample. */
+static ID3D11RenderTargetView *rt_view(const Target *t)
+{
+    return t->ms_rtv ? t->ms_rtv : t->rtv;
+}
+
+static void rt_resolve(Target *t)
+{
+    if (!t->ms || !t->ms_dirty)
+        return;
+    t->ms_dirty = 0;
+    ID3D11DeviceContext_ResolveSubresource(s_ctx, (ID3D11Resource *)t->tex, 0,
+                                           (ID3D11Resource *)t->ms, 0,
+                                           DXGI_FORMAT_B8G8R8A8_UNORM);
+}
+
+/* Guest pixels -> render target. 32-bit surfaces are B8G8R8A8 already;
+ * 16-bit ones are widened as R5G6B5, or as G8B8 into blue and green. */
+static void rt_upload(Target *t)
+{
+    uint8_t *mem = (uint8_t *)xbox_GetMemoryOffset() + t->va;
+    s_st.uploads++;
+    t->gpu_valid = 1;
+    t->guest_hash = hash_bytes(mem, (size_t)t->pitch * t->height);
+    if (t->bpp == 4) {
+        ID3D11DeviceContext_UpdateSubresource(s_ctx,
+                (ID3D11Resource *)(t->lo ? t->lo : t->tex), 0, NULL, mem, t->pitch, 0);
+    } else {
+        uint32_t *c = conv_buf((size_t)t->width * t->height), x, y;
+        if (!c) return;
+        for (y = 0; y < t->height; y++) {
+            const uint16_t *s = (const uint16_t *)(mem + (size_t)y * t->pitch);
+            uint32_t *d = c + (size_t)y * t->width;
+            if (t->g8b8) {
+                for (x = 0; x < t->width; x++)
+                    d[x] = 0xFF000000u | s[x];
+                continue;
+            }
+            for (x = 0; x < t->width; x++) {
+                uint16_t v = s[x];
+                uint32_t r = ((v >> 11) & 0x1F) * 255u / 31u;
+                uint32_t g = ((v >> 5) & 0x3F) * 255u / 63u;
+                uint32_t b = (v & 0x1F) * 255u / 31u;
+                d[x] = 0xFF000000u | (r << 16) | (g << 8) | b;
+            }
+        }
+        ID3D11DeviceContext_UpdateSubresource(s_ctx,
+                (ID3D11Resource *)(t->lo ? t->lo : t->tex), 0, NULL, c, t->width * 4, 0);
+    }
+    if (t->lo)                               /* scaled: guest size -> target */
+        blit(t->lo_srv, t->rtv, 0.0f, 0.0f, (float)t->sw, (float)t->sh,
+             0.0f, 0.0f, 1.0f, 1.0f);
+    if (t->ms) {                             /* resolved image -> every sample */
+        blit(t->srv, t->ms_rtv, 0.0f, 0.0f, (float)t->sw, (float)t->sh,
+             0.0f, 0.0f, 1.0f, 1.0f);
+        t->ms_dirty = 0;
+    }
+}
+
+/* Render target -> guest pixels. */
+static void rt_writeback(Target *t)
+{
+    D3D11_MAPPED_SUBRESOURCE m;
+    uint8_t *mem = (uint8_t *)xbox_GetMemoryOffset() + t->va;
+    uint32_t y, x;
+
+    if (!t->dirty)
+        return;
+    /* A target nothing has drawn into this frame or the last, over memory
+     * the CPU has rewritten since the two last agreed: the title has moved
+     * on and reused it, and the CPU's bytes are the newer ones. Writing the
+     * old pixels back would destroy them. MechAssault 2 loads the next
+     * level into memory the last level's targets held -- a 512x512 target
+     * at 0x80A71000 became a cube map the lighting reads -- and the first
+     * read of that cube map wrote the old level's image over it, so the
+     * level after a mission-complete transition was wrongly lit throughout.
+     * A target in use is written back as before. */
+    if (s_frame - t->drawn_frame > 1
+            && hash_bytes(mem, (size_t)t->pitch * t->height) != t->guest_hash) {
+        static int shown;
+        if (shown++ < 16)
+            fprintf(stderr, "  [D3D11] render target %08X %ux%u: not drawn for %u frames and"
+                    " its memory rewritten by the CPU; its pixels are dropped, not"
+                    " written back\n", t->va, t->width, t->height, s_frame - t->drawn_frame);
+        t->dirty = 0;
+        t->ms_dirty = 0;
+        t->gpu_valid = 0;
+        return;
+    }
+    t->dirty = 0;
+    s_st.writebacks++;
+    rt_resolve(t);
+    if (t->lo) {                             /* scaled: target -> guest size */
+        blit(t->srv, t->lo_rtv, 0.0f, 0.0f, (float)t->width, (float)t->height,
+             0.0f, 0.0f, 1.0f, 1.0f);
+        ID3D11DeviceContext_CopyResource(s_ctx, (ID3D11Resource *)t->staging,
+                                         (ID3D11Resource *)t->lo);
+    } else {
+        ID3D11DeviceContext_CopyResource(s_ctx, (ID3D11Resource *)t->staging,
+                                         (ID3D11Resource *)t->tex);
+    }
+    {
+        LARGE_INTEGER a, b, f;
+        HRESULT hr;
+        QueryPerformanceCounter(&a);
+        hr = ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)t->staging, 0,
+                                     D3D11_MAP_READ, 0, &m);
+        QueryPerformanceCounter(&b);
+        QueryPerformanceFrequency(&f);
+        s_st.wb_ms += (double)(b.QuadPart - a.QuadPart) * 1000.0 / (double)f.QuadPart;
+        if (FAILED(hr))
+            return;
+    }
+    for (y = 0; y < t->height; y++) {
+        const uint8_t *src = (const uint8_t *)m.pData + (size_t)y * m.RowPitch;
+        uint8_t *dst = mem + (size_t)y * t->pitch;
+        if (t->bpp == 4) {
+            memcpy(dst, src, (size_t)t->width * 4);
+        } else {
+            const uint32_t *s = (const uint32_t *)src;
+            uint16_t *d = (uint16_t *)dst;
+            if (t->g8b8)
+                for (x = 0; x < t->width; x++)
+                    d[x] = (uint16_t)s[x];          /* green high, blue low */
+            else
+                for (x = 0; x < t->width; x++) {
+                    uint32_t c = s[x];
+                    d[x] = (uint16_t)(((c >> 8) & 0xF800) | ((c >> 5) & 0x07E0)
+                                    | ((c >> 3) & 0x001F));
+                }
+        }
+    }
+    ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)t->staging, 0);
+    t->guest_hash = hash_bytes(mem, (size_t)t->pitch * t->height);
+    tex_invalidate(t->va, t->pitch * t->height);
+}
+
+static void rt_release(Target *t)
+{
+    if (t->rtv) ID3D11RenderTargetView_Release(t->rtv);
+    if (t->srv) ID3D11ShaderResourceView_Release(t->srv);
+    if (t->copy_srv) ID3D11ShaderResourceView_Release(t->copy_srv);
+    if (t->copy) ID3D11Texture2D_Release(t->copy);
+    if (t->tex) ID3D11Texture2D_Release(t->tex);
+    if (t->staging) ID3D11Texture2D_Release(t->staging);
+    if (t->lo_rtv) ID3D11RenderTargetView_Release(t->lo_rtv);
+    if (t->lo_srv) ID3D11ShaderResourceView_Release(t->lo_srv);
+    if (t->lo) ID3D11Texture2D_Release(t->lo);
+    if (t->ms_rtv) ID3D11RenderTargetView_Release(t->ms_rtv);
+    if (t->ms) ID3D11Texture2D_Release(t->ms);
+    memset(t, 0, sizeof *t);
+}
+
+static Target *rt_get(const Nv2aSurface *s)
+{
+    uint32_t bpp = s->bytes_per_pixel, w, h;
+    D3D11_TEXTURE2D_DESC td;
+    Target *t = NULL;
+    int i;
+
+    if ((bpp != 4 && bpp != 2) || !s->pitch || !s->color_va)
+        return NULL;
+    w = s->pitch / bpp;
+    h = s->clip_y + s->height;
+    if (!w || !h || w > 4096 || h > 4096)
+        return NULL;
+    for (i = 0; i < RT_MAX; i++)
+        if (s_rt[i].tex && s_rt[i].va == s->color_va && s_rt[i].pitch == s->pitch
+            && s_rt[i].bpp == bpp && s_rt[i].height >= h)
+            return &s_rt[i];
+    for (i = 0; i < RT_MAX; i++)
+        if (!s_rt[i].tex) { t = &s_rt[i]; break; }
+    if (!t) {                                   /* recycle one, not the current */
+        for (i = 0; i < RT_MAX; i++)
+            if (&s_rt[i] != s_cur) { t = &s_rt[i]; break; }
+        rt_writeback(t);
+        rt_release(t);
+    }
+    {
+        static int shown;
+        if (shown++ < 32)
+            fprintf(stderr, "  [D3D11] render target %08X: %ux%u (pitch %u, %u bpp), clip %ux%u+%u+%u\n",
+                    s->color_va, w, h, s->pitch, bpp * 8, s->width, s->height, s->clip_x, s->clip_y);
+    }
+    memset(&td, 0, sizeof td);
+    td.Width = scaled(w);
+    td.Height = scaled(h);
+    td.MipLevels = 1;
+    td.ArraySize = 1;
+    td.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    td.SampleDesc.Count = 1;
+    td.Usage = D3D11_USAGE_DEFAULT;
+    td.BindFlags = D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
+    if (FAILED(ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &t->tex)))
+        return NULL;
+    t->sw = td.Width;
+    t->sh = td.Height;
+    if (s_msaa > 1) {
+        td.SampleDesc.Count = s_msaa;
+        td.BindFlags = D3D11_BIND_RENDER_TARGET;
+        if (FAILED(ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &t->ms))) {
+            rt_release(t);
+            return NULL;
+        }
+        ID3D11Device_CreateRenderTargetView(s_dev, (ID3D11Resource *)t->ms, NULL, &t->ms_rtv);
+        td.SampleDesc.Count = 1;
+        td.BindFlags = D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
+    }
+    td.Width = w;
+    td.Height = h;
+    if (s_scale != 1.0f) {
+        if (FAILED(ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &t->lo))) {
+            rt_release(t);
+            return NULL;
+        }
+        ID3D11Device_CreateRenderTargetView(s_dev, (ID3D11Resource *)t->lo, NULL, &t->lo_rtv);
+        ID3D11Device_CreateShaderResourceView(s_dev, (ID3D11Resource *)t->lo, NULL, &t->lo_srv);
+    }
+    td.Usage = D3D11_USAGE_STAGING;
+    td.BindFlags = 0;
+    td.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    if (FAILED(ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &t->staging))) {
+        rt_release(t);
+        return NULL;
+    }
+    ID3D11Device_CreateRenderTargetView(s_dev, (ID3D11Resource *)t->tex, NULL, &t->rtv);
+    ID3D11Device_CreateShaderResourceView(s_dev, (ID3D11Resource *)t->tex, NULL, &t->srv);
+    t->va = s->color_va;
+    t->pitch = s->pitch;
+    t->bpp = bpp;
+    t->width = w;
+    t->height = h;
+    t->g8b8 = bpp == 2 && s->color_format == 0xA;
+    t->aa_sx = s->aa_sx ? s->aa_sx : 1;
+    t->aa_sy = s->aa_sy ? s->aa_sy : 1;
+    return t;
+}
+
+static ID3D11DepthStencilView *ds_get(uint32_t va, uint32_t w, uint32_t h)
+{
+    D3D11_TEXTURE2D_DESC td;
+    Depth *d = NULL;
+    int i;
+    static int next;
+
+    if (!va)
+        return NULL;
+    for (i = 0; i < 8; i++)
+        if (s_ds[i].tex && s_ds[i].va == va && s_ds[i].width == w && s_ds[i].height == h)
+            return s_ds[i].dsv;
+    d = &s_ds[next++ & 7];
+    if (d->dsv) ID3D11DepthStencilView_Release(d->dsv);
+    if (d->tex) ID3D11Texture2D_Release(d->tex);
+    if (d->srv_z) ID3D11ShaderResourceView_Release(d->srv_z);
+    if (d->srv_s) ID3D11ShaderResourceView_Release(d->srv_s);
+    if (d->pk_uav) ID3D11UnorderedAccessView_Release(d->pk_uav);
+    if (d->pk_srv) ID3D11ShaderResourceView_Release(d->pk_srv);
+    if (d->pk) ID3D11Texture2D_Release(d->pk);
+    memset(d, 0, sizeof *d);
+    memset(&td, 0, sizeof td);
+    td.Width = w;
+    td.Height = h;
+    td.MipLevels = 1;
+    td.ArraySize = 1;
+    /* Typeless, so ds_alias can read it as well (D32 depth, S8 stencil). */
+    td.Format = DXGI_FORMAT_R32G8X24_TYPELESS;
+    td.SampleDesc.Count = s_msaa;           /* as the colour targets */
+    td.Usage = D3D11_USAGE_DEFAULT;
+    td.BindFlags = D3D11_BIND_DEPTH_STENCIL | D3D11_BIND_SHADER_RESOURCE;
+    if (FAILED(ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &d->tex)))
+        return NULL;
+    {
+        D3D11_DEPTH_STENCIL_VIEW_DESC dv;
+        memset(&dv, 0, sizeof dv);
+        dv.Format = DXGI_FORMAT_D32_FLOAT_S8X24_UINT;
+        dv.ViewDimension = s_msaa > 1 ? D3D11_DSV_DIMENSION_TEXTURE2DMS
+                                      : D3D11_DSV_DIMENSION_TEXTURE2D;
+        ID3D11Device_CreateDepthStencilView(s_dev, (ID3D11Resource *)d->tex, &dv, &d->dsv);
+    }
+    ID3D11DeviceContext_ClearDepthStencilView(s_ctx, d->dsv,
+            D3D11_CLEAR_DEPTH | D3D11_CLEAR_STENCIL, 1.0f, 0);
+    d->va = va;
+    d->width = w;
+    d->height = h;
+    return d->dsv;
+}
+
+/* A texture over the depth buffer. MechAssault 2's shadow pass samples its
+ * Z24S8 zeta surface as a linear A8R8G8B8 texture -- the dword's depth bytes
+ * land in A, R, G and the stencil in B -- and looks A and R up in a depth
+ * falloff table (a DEPENDENT_AR stage). Depth lives in a D3D11 depth buffer
+ * here and never reaches guest memory, so the texture read whatever that
+ * memory last held, and every shadow came out at full falloff: invisible.
+ * Instead the depth buffer is packed into the guest's byte layout on the
+ * GPU, at render scale, each time a draw samples it. Z24S8 only: a linear
+ * 32-bit texture at the depth surface's address; depth = D3D11 depth *
+ * 16777215, as the vertex shader divided it. MSAA: sample 0. */
+static const char s_hlsl_zpack[] =
+"#ifdef MS\n"
+"Texture2DMS<float> Z : register(t0); Texture2DMS<uint2> S : register(t1);\n"
+"#define LD(T, c) T.Load(c, 0)\n"
+"#else\n"
+"Texture2D<float> Z : register(t0); Texture2D<uint2> S : register(t1);\n"
+"#define LD(T, c) T.Load(int3(c, 0))\n"
+"#endif\n"
+"RWTexture2D<unorm float4> O : register(u0);\n"
+"cbuffer ZC : register(b0) { uint4 g_size; };\n"
+"[numthreads(8, 8, 1)]\n"
+"void cs_zpack(uint3 id : SV_DispatchThreadID) {\n"
+"  if (id.x >= g_size.x || id.y >= g_size.y) return;\n"
+"  uint d = (uint)(saturate(LD(Z, id.xy)) * 16777215.0 + 0.5);\n"
+"  uint s = LD(S, id.xy).y;\n"
+"  O[id.xy] = float4((d >> 8) & 0xFF, d & 0xFF, s & 0xFF, d >> 16) / 255.0;\n"
+"}\n";
+
+static ID3D11ComputeShader *s_cs_zpack;
+static ID3D11Buffer *s_cb_zpack;
+
+static int zpack_init(void)
+{
+    static int done;
+    static const D3D_SHADER_MACRO ms[] = { { "MS", "1" }, { NULL, NULL } };
+    ID3DBlob *b = NULL, *err = NULL;
+    D3D11_BUFFER_DESC bd;
+
+    if (done)
+        return done > 0;
+    done = -1;
+    if (FAILED(D3DCompile(s_hlsl_zpack, sizeof s_hlsl_zpack - 1, "zpack",
+                          s_msaa > 1 ? ms : NULL, NULL, "cs_zpack", "cs_5_0",
+                          D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &b, &err))) {
+        fprintf(stderr, "  [D3D11] depth pack shader: %s\n",
+                err ? (const char *)ID3D10Blob_GetBufferPointer(err) : "?");
+        if (err) ID3D10Blob_Release(err);
+        return 0;
+    }
+    ID3D11Device_CreateComputeShader(s_dev, ID3D10Blob_GetBufferPointer(b),
+                                     ID3D10Blob_GetBufferSize(b), NULL, &s_cs_zpack);
+    ID3D10Blob_Release(b);
+    memset(&bd, 0, sizeof bd);
+    bd.ByteWidth = 16;
+    bd.Usage = D3D11_USAGE_DYNAMIC;
+    bd.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+    bd.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+    ID3D11Device_CreateBuffer(s_dev, &bd, NULL, &s_cb_zpack);
+    done = s_cs_zpack && s_cb_zpack ? 1 : -1;
+    return done > 0;
+}
+
+static ID3D11ShaderResourceView *ds_alias(const Nv2aTexture *t)
+{
+    Depth *d = NULL;
+    int i;
+
+    for (i = 0; i < 8; i++)
+        if (s_ds[i].tex && s_ds[i].va == t->offset) { d = &s_ds[i]; break; }
+    if (!d)
+        return NULL;
+    /* Pitch: the surface's, which pads past width * 4 (MA2: 720 wide, 3072). */
+    if (t->cube || t->normalized || t->depth > 1 || (t->color != 0x12 && t->color != 0x1E)
+        || t->pitch < t->width * 4)
+        return NULL;
+    if (!zpack_init())
+        return NULL;
+    if (!d->srv_z) {
+        D3D11_SHADER_RESOURCE_VIEW_DESC vd;
+        memset(&vd, 0, sizeof vd);
+        vd.ViewDimension = s_msaa > 1 ? D3D11_SRV_DIMENSION_TEXTURE2DMS
+                                      : D3D11_SRV_DIMENSION_TEXTURE2D;
+        vd.Texture2D.MipLevels = 1;
+        vd.Format = DXGI_FORMAT_R32_FLOAT_X8X24_TYPELESS;
+        ID3D11Device_CreateShaderResourceView(s_dev, (ID3D11Resource *)d->tex, &vd, &d->srv_z);
+        vd.Format = DXGI_FORMAT_X32_TYPELESS_G8X24_UINT;
+        ID3D11Device_CreateShaderResourceView(s_dev, (ID3D11Resource *)d->tex, &vd, &d->srv_s);
+    }
+    if (!d->pk) {
+        D3D11_TEXTURE2D_DESC td;
+        memset(&td, 0, sizeof td);
+        td.Width = d->width;
+        td.Height = d->height;
+        td.MipLevels = 1;
+        td.ArraySize = 1;
+        td.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+        td.SampleDesc.Count = 1;
+        td.Usage = D3D11_USAGE_DEFAULT;
+        td.BindFlags = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_UNORDERED_ACCESS;
+        if (FAILED(ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &d->pk)))
+            return NULL;
+        ID3D11Device_CreateUnorderedAccessView(s_dev, (ID3D11Resource *)d->pk, NULL, &d->pk_uav);
+        ID3D11Device_CreateShaderResourceView(s_dev, (ID3D11Resource *)d->pk, NULL, &d->pk_srv);
+    }
+    if (!d->srv_z || !d->srv_s || !d->pk_uav || !d->pk_srv)
+        return NULL;
+    {
+        ID3D11RenderTargetView *rtv = NULL;
+        ID3D11DepthStencilView *dsv = NULL;
+        ID3D11ShaderResourceView *srv[2] = { d->srv_z, d->srv_s }, *nosrv[2] = { NULL, NULL };
+        ID3D11UnorderedAccessView *nouav = NULL;
+        D3D11_MAPPED_SUBRESOURCE m;
+
+        /* Not readable while bound for writing: off the output merger for
+         * the pack, back on after. */
+        ID3D11DeviceContext_OMGetRenderTargets(s_ctx, 1, &rtv, &dsv);
+        if (dsv == d->dsv)
+            ID3D11DeviceContext_OMSetRenderTargets(s_ctx, 1, &rtv, NULL);
+        if (SUCCEEDED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)s_cb_zpack, 0,
+                                              D3D11_MAP_WRITE_DISCARD, 0, &m))) {
+            uint32_t g[4] = { d->width, d->height, 0, 0 };
+            memcpy(m.pData, g, sizeof g);
+            ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)s_cb_zpack, 0);
+        }
+        ID3D11DeviceContext_CSSetShader(s_ctx, s_cs_zpack, NULL, 0);
+        ID3D11DeviceContext_CSSetConstantBuffers(s_ctx, 0, 1, &s_cb_zpack);
+        ID3D11DeviceContext_CSSetShaderResources(s_ctx, 0, 2, srv);
+        ID3D11DeviceContext_CSSetUnorderedAccessViews(s_ctx, 0, 1, &d->pk_uav, NULL);
+        ID3D11DeviceContext_Dispatch(s_ctx, (d->width + 7) / 8, (d->height + 7) / 8, 1);
+        ID3D11DeviceContext_CSSetShaderResources(s_ctx, 0, 2, nosrv);
+        ID3D11DeviceContext_CSSetUnorderedAccessViews(s_ctx, 0, 1, &nouav, NULL);
+        if (dsv == d->dsv)
+            ID3D11DeviceContext_OMSetRenderTargets(s_ctx, 1, &rtv, dsv);
+        if (rtv) ID3D11RenderTargetView_Release(rtv);
+        if (dsv) ID3D11DepthStencilView_Release(dsv);
+    }
+    {
+        static int shown;
+        if (shown < 2) {
+            shown++;
+            fprintf(stderr, "  [D3D11] texture %08X %ux%u reads the depth buffer:"
+                    " packed as Z24S8 on the GPU (%ux%u)\n",
+                    t->offset, t->width, t->height, d->width, d->height);
+        }
+    }
+    return d->pk_srv;
+}
+
+/* Make `s` the surface being drawn: write the previous one back, upload this
+ * one's guest pixels, bind it with its depth buffer. */
+static Target *activate(const Nv2aSurface *s, const Nv2aRenderState *rs)
+{
+    Target *t = rt_get(s);
+    ID3D11DepthStencilView *dsv;
+
+    if (!t)
+        return NULL;
+    t->drawn_frame = s_frame;           /* see rt_writeback */
+    /* The same 16-bit memory drawn in the other layout (G8B8 / R5G6B5):
+     * guest memory catches up in the old one, the target reloads in the new. */
+    if (t->g8b8 != (t->bpp == 2 && s->color_format == 0xA)) {
+        static int shown;
+        if (shown < 4) {
+            shown++;
+            fprintf(stderr, "  [D3D11] target %08X pitch %u: 16-bit layout now %s\n",
+                    t->va, t->pitch, t->g8b8 ? "R5G6B5" : "G8B8");
+        }
+        rt_writeback(t);
+        t->g8b8 = !t->g8b8;
+        if (t->gpu_valid)
+            rt_upload(t);
+    }
+    if (t != s_cur) {
+        s_st.switches++;
+        /* Render targets stay on the GPU across switches. Upload guest
+         * pixels the first time, and again only if the CPU has changed
+         * them since the two last agreed -- never while the GPU is newer. */
+        if (!t->gpu_valid) {
+            rt_upload(t);
+        } else if (!t->dirty) {
+            const uint8_t *mem = (const uint8_t *)xbox_GetMemoryOffset() + t->va;
+            if (hash_bytes(mem, (size_t)t->pitch * t->height) != t->guest_hash)
+                rt_upload(t);
+        }
+        s_cur = t;
+    }
+    dsv = rs ? ds_get(rs->zeta_va, t->sw, t->sh) : NULL;
+    s_cur_zeta = dsv ? rs->zeta_va : 0;
+    {
+        ID3D11RenderTargetView *v = rt_view(t);
+        ID3D11DeviceContext_OMSetRenderTargets(s_ctx, 1, &v, dsv);
+    }
+    return t;
+}
+
+/* A texture that is a render target's own pixels: linear 32-bit at the
+ * surface's address with its pitch. Sampled straight from the GPU copy,
+ * with texel coordinates divided by the render target's size. Not while it
+ * is being drawn into (that would bind one resource both ways). */
+/* Also a swizzled A8R8G8B8 texture the size of a 32-bit target at its
+ * address: render-to-texture. The NV2A draws such a surface swizzled; the
+ * executor does not model that, so the target here holds the image in rows
+ * -- which is exactly what sampling it in normalised coordinates wants.
+ * Reading it back and decoding the rows as swizzled instead cost
+ * MechAssault 2 a GPU stall every frame (a 512x512 target at 0x81EFA000),
+ * and scrambled the texture besides. */
+/* And LIN_G8B8 (0x17) over a 16-bit target drawn as G8B8: the target holds
+ * the surface's blue and green bytes in its blue and green channels, and
+ * the texture reads (R,G,B,A) = (B,G,B,G), so *g8b8 tells the stage to
+ * swizzle. MechAssault 2 draws two 256x256 targets this way and samples
+ * them every frame. */
+static ID3D11ShaderResourceView *rt_alias(const Nv2aTexture *t, float *w, float *h,
+                                          int *g8b8)
+{
+    int i, swz, g8;
+    if (t->cube)
+        return NULL;
+    swz = t->normalized && t->color == 0x06;
+    g8 = !t->normalized && t->color == 0x17;
+    if (!swz && !g8 && (t->normalized || (t->color != 0x12 && t->color != 0x1E)))
+        return NULL;
+    for (i = 0; i < RT_MAX; i++) {
+        Target *r = &s_rt[i];
+        if (!r->tex || !r->gpu_valid || r->va != t->offset || !r->srv)
+            continue;
+        if (g8 ? (r->bpp != 2 || !r->g8b8) : r->bpp != 4)
+            continue;
+        if (swz ? (r->width != t->width || r->height != t->height
+                   || r->pitch != t->width * 4)
+                : r->pitch != t->pitch)
+            continue;
+        /* Still the target's pixels? Once a frame, while guest memory is
+         * meant to hold what the target holds (not dirty), check it does:
+         * memory a title stops drawing into gets reused. MechAssault 2
+         * loads the next level's textures where the last level's render
+         * targets were, and sampling the old image for them lit the new
+         * level with the old one's lightmaps -- only after a mission-
+         * complete transition, since a fresh boot had no old targets.
+         * rt_get already re-checks this way before drawing into a target;
+         * reading one as a texture did not. A target found replaced stops
+         * being a target until it is drawn into again (rt_upload). */
+        if (!r->dirty && r->alias_frame != s_frame) {
+            const uint8_t *mem = (const uint8_t *)xbox_GetMemoryOffset() + r->va;
+            r->alias_frame = s_frame;
+            if (hash_bytes(mem, (size_t)r->pitch * r->height) != r->guest_hash) {
+                static int shown;
+                if (shown++ < 16)
+                    fprintf(stderr, "  [D3D11] render target %08X %ux%u: guest memory"
+                            " replaced; texture fmt 0x%X there is decoded, not the"
+                            " target\n", r->va, r->width, r->height, t->color);
+                r->gpu_valid = 0;
+                continue;
+            }
+        }
+        rt_resolve(r);
+        if (r == s_cur) {
+            /* Sampling the surface being drawn (a screen effect): sample a
+             * GPU copy of it as it stands. */
+            if (!r->copy) {
+                D3D11_TEXTURE2D_DESC td;
+                ID3D11Texture2D_GetDesc(r->tex, &td);
+                td.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+                if (FAILED(ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &r->copy)))
+                    return NULL;
+                ID3D11Device_CreateShaderResourceView(s_dev, (ID3D11Resource *)r->copy,
+                                                      NULL, &r->copy_srv);
+            }
+            s_fb_copies++;
+            ID3D11DeviceContext_CopyResource(s_ctx, (ID3D11Resource *)r->copy,
+                                             (ID3D11Resource *)r->tex);
+            *w = (float)r->width;
+            *h = (float)r->height;
+            *g8b8 = g8;
+            return r->copy_srv;
+        }
+        *w = (float)r->width;
+        *h = (float)r->height;
+        *g8b8 = g8;
+        return r->srv;
+    }
+    return NULL;
+}
+
+int d3d_rt_overlaps(uint32_t va, uint32_t n)
+{
+    int i;
+    for (i = 0; i < RT_MAX; i++)
+        if (s_rt[i].tex && s_rt[i].dirty && s_rt[i].va < va + n
+            && va < s_rt[i].va + s_rt[i].pitch * s_rt[i].height)
+            return 1;
+    return 0;
+}
+
+/* Write back any render target holding newer pixels in [va, va+n). */
+static void rt_sync_overlap(uint32_t va, uint32_t n)
+{
+    int i;
+    for (i = 0; i < RT_MAX; i++) {
+        Target *r = &s_rt[i];
+        if (r->tex && r->dirty && r->va < va + n
+            && va < r->va + r->pitch * r->height) {
+            /* A texture that reads a render target's memory in a form
+             * rt_alias cannot sample in place: the GPU must finish and the
+             * pixels come back mid-frame. Say which, a few times. */
+            static int shown;
+            if (s_sync_tex && shown < 16) {
+                const Nv2aTexture *t = s_sync_tex;
+                shown++;
+                fprintf(stderr, "  [D3D11] texture %08X fmt 0x%X %ux%u pitch %u%s%s reads render"
+                        " target %08X pitch %u %ux%u (%u bpp): written back mid-frame\n",
+                        t->offset, t->color, t->width, t->height, t->pitch,
+                        t->normalized ? " swizzled/normalised" : "", t->cube ? " cube" : "",
+                        r->va, r->pitch, r->width, r->height, r->bpp * 8);
+            }
+            rt_writeback(r);
+        }
+    }
+}
+
+/* ---- pipeline state ------------------------------------------------------ */
+
+static D3D11_BLEND blend_of(uint32_t f, int alpha)
+{
+    switch (f) {
+    case 0x0000: return D3D11_BLEND_ZERO;
+    case 0x0001: return D3D11_BLEND_ONE;
+    case 0x0300: return alpha ? D3D11_BLEND_SRC_ALPHA : D3D11_BLEND_SRC_COLOR;
+    case 0x0301: return alpha ? D3D11_BLEND_INV_SRC_ALPHA : D3D11_BLEND_INV_SRC_COLOR;
+    case 0x0302: return D3D11_BLEND_SRC_ALPHA;
+    case 0x0303: return D3D11_BLEND_INV_SRC_ALPHA;
+    case 0x0304: return D3D11_BLEND_DEST_ALPHA;
+    case 0x0305: return D3D11_BLEND_INV_DEST_ALPHA;
+    case 0x0306: return alpha ? D3D11_BLEND_DEST_ALPHA : D3D11_BLEND_DEST_COLOR;
+    case 0x0307: return alpha ? D3D11_BLEND_INV_DEST_ALPHA : D3D11_BLEND_INV_DEST_COLOR;
+    case 0x0308: return D3D11_BLEND_SRC_ALPHA_SAT;
+    case 0x8001: case 0x8003: return D3D11_BLEND_BLEND_FACTOR;
+    case 0x8002: case 0x8004: return D3D11_BLEND_INV_BLEND_FACTOR;
+    default:     return f ? D3D11_BLEND_ONE : D3D11_BLEND_ZERO;
+    }
+}
+
+static D3D11_BLEND_OP blend_op_of(uint32_t e)
+{
+    switch (e) {
+    case 0x8007: return D3D11_BLEND_OP_MIN;
+    case 0x8008: return D3D11_BLEND_OP_MAX;
+    case 0x800A: return D3D11_BLEND_OP_SUBTRACT;
+    case 0x800B: return D3D11_BLEND_OP_REV_SUBTRACT;
+    default:     return D3D11_BLEND_OP_ADD;
+    }
+}
+
+static D3D11_COMPARISON_FUNC cmp_of(uint32_t f)
+{
+    switch (f) {
+    case 0x200: return D3D11_COMPARISON_NEVER;
+    case 0x201: return D3D11_COMPARISON_LESS;
+    case 0x202: return D3D11_COMPARISON_EQUAL;
+    case 0x203: return D3D11_COMPARISON_LESS_EQUAL;
+    case 0x204: return D3D11_COMPARISON_GREATER;
+    case 0x205: return D3D11_COMPARISON_NOT_EQUAL;
+    case 0x206: return D3D11_COMPARISON_GREATER_EQUAL;
+    default:    return D3D11_COMPARISON_ALWAYS;
+    }
+}
+
+static D3D11_STENCIL_OP sop_of(uint32_t o)
+{
+    switch (o) {
+    case 0x0000: return D3D11_STENCIL_OP_ZERO;
+    case 0x1E01: return D3D11_STENCIL_OP_REPLACE;
+    case 0x1E02: return D3D11_STENCIL_OP_INCR_SAT;
+    case 0x1E03: return D3D11_STENCIL_OP_DECR_SAT;
+    case 0x150A: return D3D11_STENCIL_OP_INVERT;
+    case 0x8507: return D3D11_STENCIL_OP_INCR;
+    case 0x8508: return D3D11_STENCIL_OP_DECR;
+    default:     return D3D11_STENCIL_OP_KEEP;
+    }
+}
+
+/* Small caches of state objects keyed by their descriptions. */
+#define STATE_MAX 128
+static struct { D3D11_BLEND_DESC d; ID3D11BlendState *s; } s_bs[STATE_MAX];
+static struct { D3D11_DEPTH_STENCIL_DESC d; ID3D11DepthStencilState *s; } s_dss[STATE_MAX];
+static struct { D3D11_SAMPLER_DESC d; ID3D11SamplerState *s; } s_ss[32];
+static int s_nbs, s_ndss, s_nss;
+
+static ID3D11BlendState *blend_state(const Nv2aRenderState *r)
+{
+    D3D11_BLEND_DESC d;
+    D3D11_RENDER_TARGET_BLEND_DESC *t = &d.RenderTarget[0];
+    UINT8 mask = 0;
+    int i;
+
+    memset(&d, 0, sizeof d);
+    if (r->color_mask & 0x00010000u) mask |= D3D11_COLOR_WRITE_ENABLE_RED;
+    if (r->color_mask & 0x00000100u) mask |= D3D11_COLOR_WRITE_ENABLE_GREEN;
+    if (r->color_mask & 0x00000001u) mask |= D3D11_COLOR_WRITE_ENABLE_BLUE;
+    if (r->color_mask & 0x01000000u) mask |= D3D11_COLOR_WRITE_ENABLE_ALPHA;
+    t->RenderTargetWriteMask = mask;
+    t->BlendEnable = r->blend_enable ? TRUE : FALSE;
+    t->SrcBlend = blend_of(r->blend_src, 0);
+    t->DestBlend = blend_of(r->blend_dst, 0);
+    t->BlendOp = blend_op_of(r->blend_eq);
+    t->SrcBlendAlpha = blend_of(r->blend_src, 1);
+    t->DestBlendAlpha = blend_of(r->blend_dst, 1);
+    t->BlendOpAlpha = t->BlendOp;
+    if (!t->BlendEnable) {
+        t->SrcBlend = t->SrcBlendAlpha = D3D11_BLEND_ONE;
+        t->DestBlend = t->DestBlendAlpha = D3D11_BLEND_ZERO;
+        t->BlendOp = t->BlendOpAlpha = D3D11_BLEND_OP_ADD;
+    }
+    for (i = 0; i < s_nbs; i++)
+        if (!memcmp(&s_bs[i].d, &d, sizeof d))
+            return s_bs[i].s;
+    if (s_nbs == STATE_MAX)
+        return s_bs[0].s;
+    s_bs[s_nbs].d = d;
+    ID3D11Device_CreateBlendState(s_dev, &d, &s_bs[s_nbs].s);
+    return s_bs[s_nbs++].s;
+}
+
+static ID3D11DepthStencilState *depth_state(const Nv2aRenderState *r)
+{
+    D3D11_DEPTH_STENCIL_DESC d;
+    int i;
+
+    memset(&d, 0, sizeof d);
+    /* No depth test, no depth write: the hardware (as OpenGL and D3D) only
+     * writes depth through the test. This used to follow the CPU path, which
+     * writes whenever the mask is on, as an ALWAYS test. MechAssault 2's
+     * full-screen shadow pass draws with the test off and the mask on, and
+     * stamped its own depth into every shadowed pixel: the explosions and
+     * sparks drawn after it failed the depth test there, leaving the
+     * shadows as black holes in them. */
+    d.DepthEnable = r->depth_test_enable && r->zeta_va;
+    d.DepthFunc = cmp_of(r->depth_func);
+    d.DepthWriteMask = r->depth_write ? D3D11_DEPTH_WRITE_MASK_ALL : D3D11_DEPTH_WRITE_MASK_ZERO;
+    d.StencilEnable = r->stencil_enable && r->zeta_va ? TRUE : FALSE;
+    d.StencilReadMask = (UINT8)r->stencil_func_mask;
+    d.StencilWriteMask = (UINT8)r->stencil_write_mask;
+    d.FrontFace.StencilFunc = cmp_of(r->stencil_func);
+    d.FrontFace.StencilFailOp = sop_of(r->stencil_fail);
+    d.FrontFace.StencilDepthFailOp = sop_of(r->stencil_zfail);
+    d.FrontFace.StencilPassOp = sop_of(r->stencil_zpass);
+    d.BackFace = d.FrontFace;
+    for (i = 0; i < s_ndss; i++)
+        if (!memcmp(&s_dss[i].d, &d, sizeof d))
+            return s_dss[i].s;
+    if (s_ndss == STATE_MAX)
+        return s_dss[0].s;
+    s_dss[s_ndss].d = d;
+    ID3D11Device_CreateDepthStencilState(s_dev, &d, &s_dss[s_ndss].s);
+    return s_dss[s_ndss++].s;
+}
+
+/* As rc_texel: tent when MAG is 2 or MIN is 2/4/6, else nearest; wrap mode 1
+ * wraps, everything else clamps. */
+/* RECOMP_D3D11_AF=<1-16>: a texture from guest memory that the title
+ * filters (tent, or any mipmap MIN 3-6) is sampled anisotropically instead,
+ * across the mip levels it stores (tex_levels). Nearest-sampled textures and
+ * render targets read as textures (`rt`) stay exact: one level, as before. */
+/* NV097_SET_TEXTURE_ADDRESS, one axis: 1 wrap, 2 mirror, 3 clamp to edge,
+ * 4 border, 5 clamp (OpenGL's, which on this hardware is the edge too).
+ * Mirror and border used to clamp as well: a mirrored texture tiled over a
+ * large surface -- MechAssault 2's roads -- came out as its edge texels
+ * smeared across everything past the first tile. */
+static D3D11_TEXTURE_ADDRESS_MODE tex_address(uint32_t m)
+{
+    switch (m) {
+    case 1:  return D3D11_TEXTURE_ADDRESS_WRAP;
+    case 2:  return D3D11_TEXTURE_ADDRESS_MIRROR;
+    case 4:  return D3D11_TEXTURE_ADDRESS_BORDER;
+    default: return D3D11_TEXTURE_ADDRESS_CLAMP;
+    }
+}
+
+static ID3D11SamplerState *sampler(const Nv2aTexture *t, int rt)
+{
+    D3D11_SAMPLER_DESC d;
+    uint32_t mag = t ? (t->filter >> 24) & 0xF : 0, min = t ? (t->filter >> 16) & 0xFF : 0;
+    int lin = mag == 2 || min == 2 || min == 4 || min == 6, i;
+    int aniso = s_af && t && !rt && (lin || (min >= 3 && min <= 6));
+
+    memset(&d, 0, sizeof d);
+    d.Filter = lin ? D3D11_FILTER_MIN_MAG_MIP_LINEAR : D3D11_FILTER_MIN_MAG_MIP_POINT;
+    d.AddressU = t ? tex_address(t->addr_u) : D3D11_TEXTURE_ADDRESS_CLAMP;
+    d.AddressV = t ? tex_address(t->addr_v) : D3D11_TEXTURE_ADDRESS_CLAMP;
+    if (t && (d.AddressU == D3D11_TEXTURE_ADDRESS_BORDER
+              || d.AddressV == D3D11_TEXTURE_ADDRESS_BORDER)) {
+        /* NV097_SET_TEXTURE_BORDER_COLOR is not tracked: transparent black. */
+        d.BorderColor[0] = d.BorderColor[1] = d.BorderColor[2] = d.BorderColor[3] = 0.0f;
+    }
+    if (t) {   /* which address modes a title uses, once each */
+        static uint32_t seen;
+        uint32_t bit = 1u << ((t->addr_u & 7) * 8 + (t->addr_v & 7));
+        if (!(seen & bit) && (t->addr_u & 7) < 4 && (t->addr_v & 7) < 4) {
+            seen |= bit;
+            fprintf(stderr, "  [D3D11] texture address mode u=%u v=%u in use\n",
+                    t->addr_u, t->addr_v);
+        }
+    }
+    d.AddressW = D3D11_TEXTURE_ADDRESS_CLAMP;
+    d.MaxLOD = D3D11_FLOAT32_MAX;
+    if (aniso) {
+        d.Filter = D3D11_FILTER_ANISOTROPIC;
+        d.MaxAnisotropy = (UINT)s_af;
+    } else if (s_af) {
+        d.MaxLOD = 0.0f;                /* level 0 whatever the gradients say */
+    }
+    d.ComparisonFunc = D3D11_COMPARISON_NEVER;
+    for (i = 0; i < s_nss; i++)
+        if (!memcmp(&s_ss[i].d, &d, sizeof d))
+            return s_ss[i].s;
+    if (s_nss == 32)
+        return s_ss[0].s;
+    s_ss[s_nss].d = d;
+    ID3D11Device_CreateSamplerState(s_dev, &d, &s_ss[s_nss].s);
+    return s_ss[s_nss++].s;
+}
+
+static void unpack(uint32_t c, float o[4])
+{
+    o[0] = (float)((c >> 16) & 0xFF) / 255.0f;
+    o[1] = (float)((c >> 8) & 0xFF) / 255.0f;
+    o[2] = (float)(c & 0xFF) / 255.0f;
+    o[3] = (float)(c >> 24) / 255.0f;
+}
+
+/* ---- the back end -------------------------------------------------------- */
+
+static void viewport_for(const Target *t, const Nv2aSurface *s)
+{
+    D3D11_VIEWPORT vp;
+    D3D11_RECT sc;
+    vp.TopLeftX = 0;
+    vp.TopLeftY = 0;
+    vp.Width = (float)t->sw;
+    vp.Height = (float)t->sh;
+    vp.MinDepth = 0.0f;
+    vp.MaxDepth = 1.0f;
+    ID3D11DeviceContext_RSSetViewports(s_ctx, 1, &vp);
+    /* The executor clips to SET_SURFACE_CLIP; s->width/height are its size
+     * at the origin the executor already applied. In target pixels. */
+    sc.left = (LONG)scaled(s->clip_x);
+    sc.top = (LONG)scaled(s->clip_y);
+    sc.right = (LONG)scaled(s->clip_x + s->width < t->width ? s->clip_x + s->width : t->width);
+    sc.bottom = (LONG)scaled(s->clip_y + s->height < t->height ? s->clip_y + s->height : t->height);
+    ID3D11DeviceContext_RSSetScissorRects(s_ctx, 1, &sc);
+}
+
+static void d3d_clear(const Nv2aSurface *s, const Nv2aRenderState *rs,
+                      uint32_t flags, uint32_t argb, uint32_t zstencil)
+{
+    Target *t;
+    ID3D11DepthStencilView *dsv;
+
+    (void)zstencil;
+    if (!ensure_device() || !(t = activate(s, rs)))
+        return;
+    if ((flags & 0xF0) && rs->color_mask) {
+        float c[4];
+        D3D11_RECT r;
+        unpack(argb, c);
+        r.left = (LONG)scaled(s->clip_x);
+        r.top = (LONG)scaled(s->clip_y);
+        r.right = (LONG)scaled(s->clip_x + s->width < t->width ? s->clip_x + s->width : t->width);
+        r.bottom = (LONG)scaled(s->clip_y + s->height < t->height ? s->clip_y + s->height : t->height);
+        if (s_ctx1)
+            ID3D11DeviceContext1_ClearView(s_ctx1, (ID3D11View *)rt_view(t), c, &r, 1);
+        else
+            ID3D11DeviceContext_ClearRenderTargetView(s_ctx, rt_view(t), c);
+        t->dirty = 1;
+        t->ms_dirty = 1;
+    }
+    dsv = ds_get(rs->zeta_va, t->sw, t->sh);
+    if (dsv && (flags & 3)) {
+        float z = rs->depth_scale > 0.0f ? rs->zclear / rs->depth_scale : 1.0f;
+        UINT what = ((flags & 1) ? D3D11_CLEAR_DEPTH : 0)
+                  | ((flags & 2) ? D3D11_CLEAR_STENCIL : 0);
+        if (z > 1.0f) z = 1.0f;
+        if (z < 0.0f) z = 0.0f;
+        ID3D11DeviceContext_ClearDepthStencilView(s_ctx, dsv, what, z,
+                                                  (UINT8)(zstencil & 0xFF));
+    }
+}
+
+/* ---- specialised pixel shaders ------------------------------------------ */
+
+/* Everything ps_main branches on that is not per-draw data: the combiner
+ * words, alpha-test function, mode, clip-plane modes and per-stage texture
+ * kind. Factors, fog colour, alpha reference and texture sizes stay in the
+ * constant buffer, so one shader serves every draw that differs only in
+ * those. */
+typedef struct {
+    uint32_t cicw[8], aicw[8], cocw[8], aocw[8], fin[4];
+    uint32_t misc[4];           /* alpha test enable, func, mode, clip-plane mode */
+    uint32_t tf[4];             /* per stage: 1 normalised, 2 cube, 4 G8B8 target */
+    uint32_t textured;
+} PsKey;
+
+typedef struct {
+    PsKey key;
+    uint64_t h;                 /* 0: free */
+    ID3D11PixelShader *ps;
+    volatile LONG state;        /* 1 queued, 2 ready, 3 failed */
+} PsEntry;
+
+#define PS_MAX 4096             /* power of two */
+static PsEntry s_pse[PS_MAX];
+static uint32_t s_pse_n;
+static int s_spec = -1;
+static CRITICAL_SECTION s_psq_lock;
+static HANDLE s_psq_sem;
+static uint32_t s_psq[PS_MAX], s_psq_head, s_psq_tail;
+static char s_cache_dir[MAX_PATH];
+static uint64_t s_src_hash;
+static volatile LONG s_ps_built, s_ps_loaded;
+
+static uint64_t fnv64(const void *p, size_t n, uint64_t h)
+{
+    const uint8_t *b = (const uint8_t *)p;
+    while (n--)
+        h = (h ^ *b++) * 0x100000001B3ull;
+    return h;
+}
+
+static void ps_cache_name(const PsEntry *e, char *out, size_t n)
+{
+    snprintf(out, n, "%s\\ps_%016llx.cso", s_cache_dir,
+             (unsigned long long)(e->h ^ (s_src_hash * 0x9E3779B97F4A7C15ull)));
+}
+
+static void ps_compile(PsEntry *e)
+{
+    const PsKey *k = &e->key;
+    char w[4][192], fin[96], misc[96], tf[96], tex[16], path[MAX_PATH];
+    const uint32_t *words[4] = { k->cicw, k->aicw, k->cocw, k->aocw };
+    D3D_SHADER_MACRO m[11];
+    ID3DBlob *blob = NULL, *err = NULL;
+    ID3D11PixelShader *ps = NULL;
+    int i;
+
+    for (i = 0; i < 4; i++) {
+        const uint32_t *v = words[i];
+        snprintf(w[i], sizeof w[i], "uint4(0x%Xu,0x%Xu,0x%Xu,0x%Xu),uint4(0x%Xu,0x%Xu,0x%Xu,0x%Xu)",
+                 v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7]);
+    }
+    snprintf(fin, sizeof fin, "uint4(0x%Xu,0x%Xu,0x%Xu,0x%Xu)", k->fin[0], k->fin[1], k->fin[2], k->fin[3]);
+    snprintf(misc, sizeof misc, "uint4(0x%Xu,0x%Xu,0x%Xu,0x%Xu)", k->misc[0], k->misc[1], k->misc[2], k->misc[3]);
+    snprintf(tf, sizeof tf, "uint4(0x%Xu,0x%Xu,0x%Xu,0x%Xu)", k->tf[0], k->tf[1], k->tf[2], k->tf[3]);
+    snprintf(tex, sizeof tex, "%uu", k->textured);
+    m[0].Name = "SPEC";         m[0].Definition = "1";
+    m[1].Name = "SPEC_CICW";    m[1].Definition = w[0];
+    m[2].Name = "SPEC_AICW";    m[2].Definition = w[1];
+    m[3].Name = "SPEC_COCW";    m[3].Definition = w[2];
+    m[4].Name = "SPEC_AOCW";    m[4].Definition = w[3];
+    m[5].Name = "SPEC_FIN";     m[5].Definition = fin;
+    m[6].Name = "SPEC_MISC";    m[6].Definition = misc;
+    m[7].Name = "SPEC_TF";      m[7].Definition = tf;
+    m[8].Name = "SPEC_TEXTURED"; m[8].Definition = tex;
+    m[9].Name = s_af ? "AF" : NULL; m[9].Definition = s_af ? "1" : NULL;
+    m[10].Name = NULL;          m[10].Definition = NULL;
+    if (FAILED(D3DCompile(s_hlsl, sizeof s_hlsl - 1, "nv2a_ps_spec", m, NULL, "ps_main",
+                          "ps_5_0", D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &blob, &err))
+        || FAILED(ID3D11Device_CreatePixelShader(s_dev, ID3D10Blob_GetBufferPointer(blob),
+                                                 ID3D10Blob_GetBufferSize(blob), NULL, &ps))) {
+        static int warned;
+        if (warned++ < 4)
+            fprintf(stderr, "  [D3D11] specialised pixel shader failed: %s\n",
+                    err ? (const char *)ID3D10Blob_GetBufferPointer(err) : "CreatePixelShader");
+        if (err) ID3D10Blob_Release(err);
+        if (blob) ID3D10Blob_Release(blob);
+        InterlockedExchange(&e->state, 3);
+        return;
+    }
+    if (err) ID3D10Blob_Release(err);
+    ps_cache_name(e, path, sizeof path);
+    {
+        FILE *f = fopen(path, "wb");
+        if (f) {
+            fwrite(ID3D10Blob_GetBufferPointer(blob), 1, ID3D10Blob_GetBufferSize(blob), f);
+            fclose(f);
+        }
+    }
+    ID3D10Blob_Release(blob);
+    e->ps = ps;
+    InterlockedIncrement(&s_ps_built);
+    InterlockedExchange(&e->state, 2);
+}
+
+static int ps_cache_load(PsEntry *e)
+{
+    char path[MAX_PATH];
+    FILE *f;
+    long n;
+    void *buf;
+    int ok = 0;
+
+    ps_cache_name(e, path, sizeof path);
+    if (!(f = fopen(path, "rb")))
+        return 0;
+    fseek(f, 0, SEEK_END);
+    n = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    if (n > 0 && (buf = malloc((size_t)n)) != NULL) {
+        if (fread(buf, 1, (size_t)n, f) == (size_t)n
+            && SUCCEEDED(ID3D11Device_CreatePixelShader(s_dev, buf, (SIZE_T)n, NULL, &e->ps)))
+            ok = 1;
+        free(buf);
+    }
+    fclose(f);
+    if (ok) {
+        InterlockedIncrement(&s_ps_loaded);
+        InterlockedExchange(&e->state, 2);
+    }
+    return ok;
+}
+
+static DWORD WINAPI ps_worker(LPVOID arg)
+{
+    (void)arg;
+    for (;;) {
+        uint32_t slot;
+        WaitForSingleObject(s_psq_sem, INFINITE);
+        EnterCriticalSection(&s_psq_lock);
+        slot = s_psq[s_psq_head++ % PS_MAX];
+        LeaveCriticalSection(&s_psq_lock);
+        ps_compile(&s_pse[slot]);
+    }
+}
+
+static void ps_spec_init(void)
+{
+    const char *e = getenv("RECOMP_D3D11_SPEC"), *dir = getenv("RECOMP_SHADER_CACHE");
+    int i;
+
+    /* RECOMP_D3D11_SPEC=split: odd frames use the interpreter, so frame
+     * dumps alternate the two and any difference shows as flicker. */
+    s_spec = !(e && *e == '0') ? (e && !strcmp(e, "split") ? 2 : 1) : 0;
+    if (!s_spec)
+        return;
+    snprintf(s_cache_dir, sizeof s_cache_dir, "%s", dir && *dir ? dir : "shader_cache");
+    CreateDirectoryA(s_cache_dir, NULL);
+    s_src_hash = fnv64(s_hlsl, sizeof s_hlsl - 1, 0xCBF29CE484222325ull);
+    if (s_af)                           /* its own cache files */
+        s_src_hash = fnv64("AF", 2, s_src_hash);
+    InitializeCriticalSection(&s_psq_lock);
+    s_psq_sem = CreateSemaphoreA(NULL, 0, PS_MAX, NULL);
+    for (i = 0; i < 3; i++) {
+        HANDLE t = CreateThread(NULL, 0, ps_worker, NULL, 0, NULL);
+        if (t) {
+            SetThreadPriority(t, THREAD_PRIORITY_BELOW_NORMAL);
+            CloseHandle(t);
+        }
+    }
+}
+
+/* The specialised shader for this draw's constants, or NULL while it is
+ * still being compiled (the interpreter draws meanwhile). */
+static ID3D11PixelShader *ps_for(const CB *cb)
+{
+    PsKey k;
+    PsEntry *e;
+    uint64_t h;
+    uint32_t i, slot, st;
+
+    if (s_spec < 0)
+        ps_spec_init();
+    if (!s_spec || (s_spec == 2 && (s_frame & 1)))
+        return NULL;
+    memset(&k, 0, sizeof k);
+    k.misc[0] = cb->misc[0];
+    k.misc[1] = cb->misc[0] ? cb->misc[1] : 0;
+    k.textured = cb->misc2[0];
+    if (cb->surf[3] != 0.0f) {
+        memcpy(k.cicw, cb->cicw, sizeof k.cicw);
+        memcpy(k.aicw, cb->aicw, sizeof k.aicw);
+        memcpy(k.cocw, cb->cocw, sizeof k.cocw);
+        memcpy(k.aocw, cb->aocw, sizeof k.aocw);
+        memcpy(k.fin, cb->fin, sizeof k.fin);
+        k.misc[2] = 1;
+        k.misc[3] = cb->misc[3];
+        for (st = 0; st < 4; st++)
+            k.tf[st] = (cb->tsz[st][2] != 0.0f ? 1u : 0u) | (cb->tsz[st][3] == 1.0f ? 2u : 0u)
+                     | (cb->tsz[st][3] == 2.0f ? 8u : 0u);
+    }
+    for (st = 0; st < 4; st++) {
+        if ((cb->misc2[1] >> st) & 1)
+            k.tf[st] |= 4u;
+        if ((cb->misc2[2] >> st) & 1)
+            k.tf[st] |= 16u;
+    }
+    h = fnv64(&k, sizeof k, 0xCBF29CE484222325ull);
+    if (!h)
+        h = 1;
+    slot = (uint32_t)h & (PS_MAX - 1);
+    for (i = 0; i < PS_MAX; i++, slot = (slot + 1) & (PS_MAX - 1)) {
+        e = &s_pse[slot];
+        if (!e->h)
+            break;
+        if (e->h == h && !memcmp(&e->key, &k, sizeof k))
+            return e->state == 2 ? e->ps : NULL;
+    }
+    if (i == PS_MAX || s_pse_n >= PS_MAX * 3 / 4)
+        return NULL;
+    e = &s_pse[slot];
+    e->key = k;
+    e->h = h;
+    s_pse_n++;
+    if (ps_cache_load(e))
+        return e->ps;
+    e->state = 1;
+    EnterCriticalSection(&s_psq_lock);
+    s_psq[s_psq_tail++ % PS_MAX] = slot;
+    LeaveCriticalSection(&s_psq_lock);
+    ReleaseSemaphore(s_psq_sem, 1, NULL);
+    return NULL;
+}
+
+static void gp_mark(uint32_t kind, uint32_t count, const Target *t);
+static void gp_pre(void);
+static uint32_t gp_kind(const Nv2aBatch *b, int program);
+
+/* NV2A culling: SET_CULL_FACE_ENABLE, SET_CULL_FACE (GL_FRONT 0x404, GL_BACK
+ * 0x405, GL_FRONT_AND_BACK 0x408) and SET_FRONT_FACE (GL_CW 0x900, GL_CCW
+ * 0x901). XDK D3D writes its D3DRS_FRONTFACE / D3DCULL_* values (the same
+ * numbers) straight into these, and D3D's clockwise is as seen on screen,
+ * y down -- the render target's own orientation here -- so GL_CCW is
+ * FrontCounterClockwise. Unset (0) reads as D3D's default, CW.
+ *
+ * Every draw used to rasterise both windings. A closed mesh looks the same
+ * either way; a stencil shadow volume does not. MechAssault 2 draws each
+ * volume twice, back faces incrementing and front faces decrementing, and
+ * with both windings in both passes the counts cancelled: no shadows at
+ * all. RECOMP_D3D11_CULL=0 draws both windings again. */
+static int cull_on(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char *e = getenv("RECOMP_D3D11_CULL");
+        on = !(e && *e == '0');
+    }
+    return on;
+}
+
+static ID3D11RasterizerState *cull_state(const Nv2aRenderState *r)
+{
+    if (!cull_on() || !r->cull_enable)
+        return s_rs;
+    switch (r->cull_face) {
+    case 0x404: return s_rs_cull[0][r->front_face == 0x901];
+    case 0x405: return s_rs_cull[1][r->front_face == 0x901];
+    default:    return s_rs;
+    }
+}
+
+/* GL_FRONT_AND_BACK culls every triangle: the batch draws nothing. */
+static int cull_all(const Nv2aRenderState *r)
+{
+    return cull_on() && r->cull_enable && r->cull_face == 0x408;
+}
+
+/* Everything a batch needs but its vertices: the target, viewport, the
+ * pixel-side constants, textures and samplers, and the output-merger state. */
+static Target *bind_pipeline(const Nv2aSurface *s, const Nv2aBatch *b)
+{
+    Target *t;
+    CB cb;
+    D3D11_MAPPED_SUBRESOURCE m;
+    ID3D11ShaderResourceView *srv[13];     /* 2D t0-3, cube t4-7, volume t9-12 */
+    ID3D11SamplerState *smp[4];
+    const Nv2aRenderState *r = b->state;
+    UINT i, st;
+    float bf[4];
+
+    if (!ensure_device() || !(t = activate(s, r)))
+        return NULL;
+    viewport_for(t, s);
+
+    /* Constants. */
+    memset(&cb, 0, sizeof cb);
+    cb.surf[0] = (float)t->width;
+    cb.surf[1] = (float)t->height;
+    cb.surf[2] = r->depth_scale > 0.0f ? 1.0f / r->depth_scale : 1.0f / 16777215.0f;
+    cb.surf[3] = b->rc ? 1.0f : 0.0f;
+    cb.misc[0] = r->alpha_test_enable;
+    cb.misc[1] = r->alpha_func;
+    cb.misc[2] = r->alpha_ref;
+    cb.misc[3] = b->clip_plane_mode;
+    for (st = 0; st < 8; st++) srv[st] = st < 4 ? s_white2d : s_whitecube;
+    for (st = 8; st < 13; st++) srv[st] = NULL;    /* t8 (the VS's), volumes */
+    for (st = 0; st < 4; st++) smp[st] = sampler(NULL, 0);
+    if (b->rc) {
+        const Nv2aCombiner *rc = b->rc;
+        float fogc[4];
+        for (i = 0; i < 8; i++) {
+            cb.cicw[i] = rc->color_icw[i]; cb.aicw[i] = rc->alpha_icw[i];
+            cb.cocw[i] = rc->color_ocw[i]; cb.aocw[i] = rc->alpha_ocw[i];
+            unpack(rc->factor0[i], cb.f0[i]);
+            unpack(rc->factor1[i], cb.f1[i]);
+        }
+        cb.fin[0] = rc->final0; cb.fin[1] = rc->final1;
+        cb.fin[2] = rc->control; cb.fin[3] = rc->stage_program;
+        unpack(rc->final_c0, cb.fc0);
+        unpack(rc->final_c1, cb.fc1);
+        unpack(b->fog_color, fogc);         /* R in bits 0-7: swap R and B */
+        cb.fogc[0] = fogc[2]; cb.fogc[1] = fogc[1]; cb.fogc[2] = fogc[0]; cb.fogc[3] = fogc[3];
+        for (st = 0; st < 4; st++) {
+            const Nv2aTexture *tx = b->stages[st];
+            uint32_t sm = (rc->stage_program >> (st * 5)) & 0x1F;
+            /* Only stages whose program samples (2D, 3D, cube, dependent
+             * AR/GB) bind their texture. A title leaves stale textures on
+             * unused stages -- MechAssault 2 leaves the back buffer on one,
+             * which cost a full-surface copy per draw to sample nothing. */
+            /* Modes the shader does not implement (BRDF, DOT_ZW,
+             * DOT_RFLCT_DIFF, DOT_RFLCT_SPEC_CONST) still read black: say
+             * which, once each. The dot-product modes it does say so too,
+             * once, with the mapping and inputs they read. */
+            {
+                static uint32_t shown[4];
+                int done = sm <= 7 || sm == 9 || (sm >= 12 && sm <= 17);
+                if ((sm > 7 && sm != 15 && sm != 16) && !(shown[st] & (1u << (sm & 31)))) {
+                    shown[st] |= 1u << (sm & 31);
+                    fprintf(stderr, "  [D3D11] texture shader stage %u mode %u in use: %s"
+                            " (dot mapping 0x%X, stage input 0x%X)\n", st, sm,
+                            done ? "dot product" : "not implemented, reads black",
+                            rc->dot_mapping, rc->stage_input);
+                }
+            }
+            cb.dot[0] = rc->dot_mapping;
+            cb.dot[1] = rc->stage_input;
+            {
+                /* RECOMP_D3D11_DOT=0: the bump-env and dot-product stages
+                 * read black again, as before they were implemented. */
+                static int on = -1;
+                if (on < 0) {
+                    const char *e = getenv("RECOMP_D3D11_DOT");
+                    on = !(e && *e == '0');
+                    if (e && *e == '2')
+                        on = 2;             /* paint those stages magenta */
+                }
+                cb.dot[2] = (uint32_t)on;
+            }
+            /* 2D/3D/cube, bump-env, DOT_ST, DOT_RFLCT_SPEC, DOT_STR_3D/CUBE
+             * and the dependent reads sample their stage's texture;
+             * PASSTHRU, CLIPPLANE and DOTPRODUCT do not. */
+            if (!tx || ((sm < 1 || sm > 3) && sm != 6 && sm != 7 && sm != 9
+                        && sm != 12 && sm != 13 && sm != 14 && sm != 15 && sm != 16))
+                continue;
+            if (sm == 6 || sm == 7) {
+                static uint32_t shown;
+                memcpy(cb.bm[st], tx->bump_mat, sizeof cb.bm[st]);
+                cb.bl[st][0] = tx->bump_scale;
+                cb.bl[st][1] = tx->bump_offset;
+                if (shown++ < 4)
+                    fprintf(stderr, "  [D3D11] texture shader stage %u mode %u (BUMPENVMAP%s):"
+                            " texture %08X fmt 0x%X, matrix %g %g %g %g, lum %g %+g\n",
+                            st, sm, sm == 7 ? "_LUM" : "", tx->offset, tx->color,
+                            tx->bump_mat[0], tx->bump_mat[1], tx->bump_mat[2],
+                            tx->bump_mat[3], tx->bump_scale, tx->bump_offset);
+            }
+            cb.tsz[st][2] = tx->normalized ? 1.0f : 0.0f;
+            cb.tsz[st][3] = tx->cube ? 1.0f : tx->depth > 1 ? 2.0f : 0.0f;
+            {
+                int g8;
+                ID3D11ShaderResourceView *v = tex_get(tx, &cb.tsz[st][0], &cb.tsz[st][1], &g8);
+                if (v) srv[tx->cube ? 4 + st : tx->depth > 1 ? 9 + st : st] = v;
+                if (g8) cb.misc2[1] |= 1u << st;
+                if (tx->alpha_kill) {           /* the first 8 textures, once each */
+                    static uint32_t seen[8];
+                    int q;
+                    cb.misc2[2] |= 1u << st;
+                    for (q = 0; q < 8 && seen[q] && seen[q] != tx->offset; q++)
+                        ;
+                    if (q < 8 && !seen[q]) {
+                        seen[q] = tx->offset;
+                        fprintf(stderr, "  [D3D11] alpha kill on stage %u mode %u: texture %08X"
+                                " fmt 0x%X %ux%u\n", st, sm, tx->offset, tx->color,
+                                tx->width, tx->height);
+                    }
+                }
+                {   /* RECOMP_D3D11_CONST_DUMP=<hex>: how a stage binds that texture */
+                    static int init, shown;
+                    static uint32_t want;
+                    if (!init) {
+                        const char *e = getenv("RECOMP_D3D11_CONST_DUMP");
+                        want = e ? (uint32_t)strtoul(e, NULL, 16) & 0x0FFFFFFFu : 0;
+                        init = 1;
+                    }
+                    static uint32_t seen[64];
+                    uint32_t key = (tx->width << 20) ^ (tx->height << 8) ^ (sm << 4) ^ st
+                                 ^ (s->color_va * 2654435761u);
+                    int q, dup = 0;
+                    for (q = 0; q < shown && q < 64; q++)
+                        dup |= seen[q] == key;
+                    if (want && (tx->offset & 0x0FFFFFFFu) == want && !dup && shown < 64) {
+                        seen[shown++] = key;
+                        fprintf(stderr, "  [D3D11] stage %u mode %u binds %08X %ux%u fmt 0x%X %s, sampled as %gx%g%s; drawing to %08X %ux%u\n",
+                                st, sm, tx->offset, tx->width, tx->height, tx->color,
+                                tx->normalized ? "normalized" : "texel coords",
+                                cb.tsz[st][0], cb.tsz[st][1], s_tex_rt ? " (render target)" : "",
+                                s->color_va, s->width, s->height);
+                    }
+                }
+            }
+            if (s_tex_z) {                  /* packed depth bytes: never blend */
+                Nv2aTexture pt = *tx;
+                pt.filter = 0;
+                smp[st] = sampler(&pt, 1);
+            } else {
+                smp[st] = sampler(tx, s_tex_rt);
+            }
+        }
+    } else if (b->texture) {
+        cb.misc2[0] = 1;
+        cb.tsz[0][2] = b->texture->normalized ? 1.0f : 0.0f;
+        {
+            int g8;
+            ID3D11ShaderResourceView *v = tex_get(b->texture, &cb.tsz[0][0], &cb.tsz[0][1], &g8);
+            if (v) srv[0] = v;
+            if (g8) cb.misc2[1] = 1;
+            if (b->texture->alpha_kill) cb.misc2[2] = 1;
+        }
+        /* The CPU's screen-space path samples the nearest texel. */
+        {
+            Nv2aTexture pt = *b->texture;
+            pt.filter = 0;
+            smp[0] = sampler(&pt, 0);
+        }
+    }
+    if (SUCCEEDED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)s_cb, 0,
+                                          D3D11_MAP_WRITE_DISCARD, 0, &m))) {
+        memcpy(m.pData, &cb, sizeof cb);
+        ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)s_cb, 0);
+    }
+
+    {
+        ID3D11PixelShader *ps = ps_for(&cb);
+        if (ps)
+            s_st.spec++;
+        ID3D11DeviceContext_PSSetShader(s_ctx, ps ? ps : s_ps, NULL, 0);
+    }
+    ID3D11DeviceContext_PSSetConstantBuffers(s_ctx, 0, 1, &s_cb);
+    ID3D11DeviceContext_PSSetShaderResources(s_ctx, 0, 13, srv);
+    ID3D11DeviceContext_PSSetSamplers(s_ctx, 0, 4, smp);
+    ID3D11DeviceContext_RSSetState(s_ctx, cull_state(r));
+    unpack(r->blend_color, bf);
+    {
+        float f[4] = { bf[0], bf[1], bf[2], bf[3] };
+        /* CONSTANT_ALPHA factors read the constant's alpha in every channel. */
+        if (r->blend_src == 0x8003 || r->blend_src == 0x8004
+            || r->blend_dst == 0x8003 || r->blend_dst == 0x8004)
+            f[0] = f[1] = f[2] = bf[3];
+        ID3D11DeviceContext_OMSetBlendState(s_ctx, blend_state(r), f, 0xFFFFFFFFu);
+    }
+    ID3D11DeviceContext_OMSetDepthStencilState(s_ctx, depth_state(r), r->stencil_ref & 0xFF);
+    ID3D11DeviceContext_IASetPrimitiveTopology(s_ctx, D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    return t;
+}
+
+static void d3d_draw(const Nv2aSurface *s, const Nv2aBatch *b)
+{
+    Target *t;
+    D3D11_MAPPED_SUBRESOURCE m;
+    UINT stride = sizeof(GV), offset, bytes, i;
+
+    if (!b->count || cull_all(b->state) || !(t = bind_pipeline(s, b)))
+        return;
+    /* RECOMP_D3D11_CONST_DUMP=<hex address>, fixed-function draws: the first
+     * 3 that bind that texture log their vertices' screen position and
+     * texture coordinates, to see how the two relate. */
+    {
+        static int init, shown;
+        static uint32_t want;
+        int k;
+        if (!init) {
+            const char *e = getenv("RECOMP_D3D11_CONST_DUMP");
+            want = e ? (uint32_t)strtoul(e, NULL, 16) & 0x0FFFFFFFu : 0;
+            init = 1;
+        }
+        for (k = 0; want && shown < 3 && k < 4; k++)
+            if (b->stages[k] && (b->stages[k]->offset & 0x0FFFFFFFu) == want) {
+                uint32_t n;
+                shown++;
+                fprintf(stderr, "  [D3D11] fixed-function draw with texture %08X on stage %d (surface %08X %ux%u, %u verts):\n",
+                        want, k, s->color_va, s->width, s->height, b->count);
+                for (n = 0; n < b->count && n < 6; n++) {
+                    const Nv2aVertex *v = &b->vertices[n];
+                    fprintf(stderr, "    x %8.2f y %8.2f rhw %8.4f | t%d %9.3f %9.3f %9.3f %9.3f\n",
+                            v->x, v->y, v->rhw, k, v->tex[k][0], v->tex[k][1], v->tex[k][2], v->tex[k][3]);
+                }
+                break;
+            }
+    }
+
+    /* Vertices. */
+    if (s_gv_cap < b->count) {
+        free(s_gv);
+        s_gv = (GV *)malloc(sizeof(GV) * b->count);
+        s_gv_cap = s_gv ? b->count : 0;
+        if (!s_gv) return;
+    }
+    for (i = 0; i < b->count; i++) {
+        const Nv2aVertex *v = &b->vertices[i];
+        GV *g = &s_gv[i];
+        g->pos[0] = v->x; g->pos[1] = v->y; g->pos[2] = v->z; g->pos[3] = v->rhw;
+        memcpy(g->d0, v->d0, 16);
+        memcpy(g->d1, v->d1, 16);
+        g->fog = v->fog;
+        g->uv[0] = v->u; g->uv[1] = v->v;
+        memcpy(g->t, v->tex, sizeof g->t);
+    }
+    bytes = b->count * (UINT)sizeof(GV);
+    if (bytes > s_vb_size)
+        return;
+    if (s_vb_pos + bytes > s_vb_size)
+        s_vb_pos = 0;
+    if (FAILED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)s_vb, 0,
+            s_vb_pos ? D3D11_MAP_WRITE_NO_OVERWRITE : D3D11_MAP_WRITE_DISCARD, 0, &m)))
+        return;
+    memcpy((uint8_t *)m.pData + s_vb_pos, s_gv, bytes);
+    ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)s_vb, 0);
+    offset = s_vb_pos;
+    s_vb_pos += bytes;
+
+    ID3D11DeviceContext_IASetInputLayout(s_ctx, s_il);
+    ID3D11DeviceContext_IASetVertexBuffers(s_ctx, 0, 1, &s_vb, &stride, &offset);
+    ID3D11DeviceContext_VSSetShader(s_ctx, s_vs, NULL, 0);
+    ID3D11DeviceContext_VSSetConstantBuffers(s_ctx, 0, 1, &s_cb);
+    gp_pre();
+    ID3D11DeviceContext_Draw(s_ctx, b->count, 0);
+    gp_mark(gp_kind(b, 0), b->count, t);
+    t->dirty = 1;
+    t->ms_dirty = 1;
+    s_st.draws++;
+    s_st.verts += b->count;
+}
+
+/* RECOMP_D3D11_GPUPROF=1: once every 120 frames, a timestamp after every
+ * draw of one frame; the frame's GPU time is then printed by kind of draw
+ * (vertex program or not, combiner stages) with the costliest draws. */
+#define GP_MAX 4096
+static struct {
+    int on, active, pending;
+    uint32_t frame, n;
+    ID3D11Query *dj, *ts[GP_MAX + 1], *pre[GP_MAX];
+    uint32_t kind[GP_MAX], count[GP_MAX], tw[GP_MAX], th[GP_MAX];
+    /* what the draw's set-up did on the GPU: feedback copies, texture
+     * decodes, write-backs (counted since the previous draw) */
+    uint32_t fb[GP_MAX], dec[GP_MAX], wb[GP_MAX];
+    uint32_t dec_at, wb_at;
+} s_gp;
+
+/* Just before a draw call: separates set-up (copies, uploads) from the draw. */
+static void gp_pre(void)
+{
+    if (!s_gp.active || s_gp.n >= GP_MAX)
+        return;
+    s_gp.fb[s_gp.n] = s_fb_copies;
+    s_gp.dec[s_gp.n] = s_st.decodes - s_gp.dec_at;
+    s_gp.wb[s_gp.n] = s_st.writebacks - s_gp.wb_at;
+    s_fb_copies = 0;
+    s_gp.dec_at = s_st.decodes;
+    s_gp.wb_at = s_st.writebacks;
+    ID3D11DeviceContext_End(s_ctx, (ID3D11Asynchronous *)s_gp.pre[s_gp.n]);
+}
+
+static void gp_begin_frame(void)
+{
+    if (s_gp.on < 0 || s_gp.pending)
+        return;
+    if (!s_gp.on) {
+        const char *e = getenv("RECOMP_D3D11_GPUPROF");
+        s_gp.on = e && *e == '1' ? 1 : -1;
+        if (s_gp.on < 0)
+            return;
+    }
+    if (s_frame % 120)
+        return;
+    if (!s_gp.dj) {
+        D3D11_QUERY_DESC qd;
+        int i;
+        qd.MiscFlags = 0;
+        qd.Query = D3D11_QUERY_TIMESTAMP_DISJOINT;
+        ID3D11Device_CreateQuery(s_dev, &qd, &s_gp.dj);
+        qd.Query = D3D11_QUERY_TIMESTAMP;
+        for (i = 0; i <= GP_MAX; i++)
+            ID3D11Device_CreateQuery(s_dev, &qd, &s_gp.ts[i]);
+        for (i = 0; i < GP_MAX; i++)
+            ID3D11Device_CreateQuery(s_dev, &qd, &s_gp.pre[i]);
+    }
+    s_gp.active = 1;
+    s_gp.n = 0;
+    s_fb_copies = 0;
+    s_gp.dec_at = s_st.decodes;
+    s_gp.wb_at = s_st.writebacks;
+    s_gp.frame = s_frame;
+    ID3D11DeviceContext_Begin(s_ctx, (ID3D11Asynchronous *)s_gp.dj);
+    ID3D11DeviceContext_End(s_ctx, (ID3D11Asynchronous *)s_gp.ts[0]);
+}
+
+static void gp_mark(uint32_t kind, uint32_t count, const Target *t)
+{
+    if (!s_gp.active || s_gp.n >= GP_MAX)
+        return;
+    s_gp.kind[s_gp.n] = kind;
+    s_gp.count[s_gp.n] = count;
+    s_gp.tw[s_gp.n] = t->width;
+    s_gp.th[s_gp.n] = t->height;
+    s_gp.n++;
+    ID3D11DeviceContext_End(s_ctx, (ID3D11Asynchronous *)s_gp.ts[s_gp.n]);
+}
+
+static void gp_end_frame(void)
+{
+    if (s_gp.active) {
+        ID3D11DeviceContext_End(s_ctx, (ID3D11Asynchronous *)s_gp.dj);
+        s_gp.active = 0;
+        s_gp.pending = 1;
+        return;
+    }
+    if (s_gp.pending && s_frame >= s_gp.frame + 3) {
+        D3D11_QUERY_DATA_TIMESTAMP_DISJOINT d;
+        static UINT64 t[GP_MAX + 1], tp[GP_MAX];
+        double setup_total = 0;
+        double bykind[64] = {0}, total = 0;
+        uint32_t nk[64] = {0}, i, top[8] = {0};
+        double topv[8] = {0};
+        s_gp.pending = 0;
+        while (ID3D11DeviceContext_GetData(s_ctx, (ID3D11Asynchronous *)s_gp.dj, &d, sizeof d, 0) == S_FALSE)
+            ;
+        if (d.Disjoint || !d.Frequency)
+            return;
+        for (i = 0; i <= s_gp.n; i++)
+            while (ID3D11DeviceContext_GetData(s_ctx, (ID3D11Asynchronous *)s_gp.ts[i], &t[i], 8, 0) == S_FALSE)
+                ;
+        for (i = 0; i < s_gp.n; i++) {
+            while (ID3D11DeviceContext_GetData(s_ctx, (ID3D11Asynchronous *)s_gp.pre[i], &tp[i], 8, 0) == S_FALSE)
+                ;
+            setup_total += (double)(tp[i] - t[i]) * 1000.0 / (double)d.Frequency;
+        }
+        for (i = 0; i < s_gp.n; i++) {
+            double ms = (double)(t[i + 1] - t[i]) * 1000.0 / (double)d.Frequency;
+            int j, k = (int)(s_gp.kind[i] & 63);
+            bykind[k] += ms;
+            nk[k]++;
+            total += ms;
+            for (j = 0; j < 8; j++)
+                if (ms > topv[j]) {
+                    memmove(&topv[j + 1], &topv[j], (7 - j) * sizeof topv[0]);
+                    memmove(&top[j + 1], &top[j], (7 - j) * sizeof top[0]);
+                    topv[j] = ms;
+                    top[j] = i;
+                    break;
+                }
+        }
+        fprintf(stderr, "  [GPUPROF] frame %u: %u draws, %.2f ms GPU (first draw to last),"
+                " of it %.2f ms in set-up between draws\n",
+                s_gp.frame, s_gp.n, total, setup_total);
+        for (i = 0; i < 64; i++)
+            if (nk[i])
+                fprintf(stderr, "  [GPUPROF]   %s, %u stages: %u draws, %.2f ms\n",
+                        (i & 32) ? "program" : "pre-transformed", i & 31, nk[i], bykind[i]);
+        for (i = 0; i < 8 && topv[i] > 0; i++)
+            fprintf(stderr, "  [GPUPROF]   #%u %.3f ms (set-up %.3f): %s, %u stages, %u indices,"
+                    " target %ux%u, %u feedback copies, %u decodes, %u write-backs\n",
+                    top[i], topv[i],
+                    (double)(tp[top[i]] - t[top[i]]) * 1000.0 / (double)d.Frequency,
+                    (s_gp.kind[top[i]] & 32) ? "program" : "pre",
+                    s_gp.kind[top[i]] & 31, s_gp.count[top[i]], s_gp.tw[top[i]], s_gp.th[top[i]],
+                    s_gp.fb[top[i]], s_gp.dec[top[i]], s_gp.wb[top[i]]);
+        fflush(stderr);
+    }
+}
+
+static uint32_t gp_kind(const Nv2aBatch *b, int program)
+{
+    uint32_t st = b->rc ? (b->rc->control & 0xFF) : 0;
+    return (program ? 32u : 0u) | (st > 31 ? 31 : st);
+}
+
+/* Hand queued work to the GPU every so many draws, so it renders while the
+ * executor is still decoding the rest of the frame instead of all at once
+ * when the flip reads the frame back. RECOMP_D3D11_FLUSH=<draws>, 0 = off. */
+static void maybe_flush(void)
+{
+    static int every = -1, n;
+    if (every < 0) {
+        const char *e = getenv("RECOMP_D3D11_FLUSH");
+        every = e ? atoi(e) : 0;
+    }
+    if (every > 0 && ++n >= every) {
+        n = 0;
+        ID3D11DeviceContext_Flush(s_ctx);
+    }
+}
+
+/* Replace a whole dynamic constant buffer. */
+static void cb_put(ID3D11Buffer *cb, const void *data, size_t n)
+{
+    D3D11_MAPPED_SUBRESOURCE m;
+    if (SUCCEEDED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)cb, 0,
+                                          D3D11_MAP_WRITE_DISCARD, 0, &m))) {
+        memcpy(m.pData, data, n);
+        ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)cb, 0);
+    }
+}
+
+/* Room for n bytes in a dynamic ring: no-overwrite while it fits, a fresh
+ * buffer (discard) when it wraps or when no-overwrite is not allowed. */
+static uint8_t *ring_map(ID3D11Buffer *buf, UINT size, UINT *pos, UINT n, int nooverwrite)
+{
+    D3D11_MAPPED_SUBRESOURCE m;
+    D3D11_MAP how = D3D11_MAP_WRITE_NO_OVERWRITE;
+    if (!nooverwrite || *pos + n > size) {
+        *pos = 0;
+        how = D3D11_MAP_WRITE_DISCARD;
+    }
+    if (FAILED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)buf, 0, how, 0, &m)))
+        return NULL;
+    return (uint8_t *)m.pData;
+}
+
+/* Does the program at the start slot end within program memory, and leave
+ * the constants alone? (A program that writes c[] changes them for the next
+ * vertex, which one constant buffer per draw cannot do: CPU path.) */
+static int program_ok(const Nv2aProgramBatch *p)
+{
+    uint32_t s;
+    if (p->program_gen == s_check_gen && p->start_slot == s_check_start)
+        return s_check_ok;
+    s_check_gen = p->program_gen;
+    s_check_start = p->start_slot;
+    s_check_ok = 0;
+    for (s = p->start_slot; s < 136; s++) {
+        const uint32_t *ins = p->program[s];
+        if (p->cxt_write && ((ins[3] >> 12) & 0xF) && !((ins[3] >> 11) & 1))
+            return s_check_ok = -1;
+        if (ins[3] & 1)
+            return s_check_ok = 1;
+    }
+    return 0;                       /* no FINAL: nothing is drawn, as on the CPU */
+}
+
+static int d3d_draw_program(const Nv2aSurface *s, const Nv2aBatch *b,
+                            const Nv2aProgramBatch *p)
+{
+    struct { uint64_t lo, hi; UINT pos; } rg[16];
+    const uint8_t *src = p->inline_data ? p->inline_data
+                                        : (const uint8_t *)xbox_GetMemoryOffset();
+    uint32_t span = p->index_max - p->index_min, a, j;
+    int nrg = 0, ok;
+    UINT total = 0, ib_bytes = p->count * 4, ib_off;
+    VACB va;
+    uint8_t *dst;
+    Target *t;
+    ID3D11Buffer *cbs[4];
+
+    if ((ok = program_ok(p)) <= 0)
+        return ok == 0;             /* -1: let the CPU run it */
+    /* RECOMP_D3D11_SKIP_TEX=<hex>[,...]: draws whose stage-0 texture is one
+     * of these are dropped -- for finding which pass draws an artefact. */
+    {
+        static int init, n;
+        static uint32_t skip[16];
+        if (!init) {
+            const char *e = getenv("RECOMP_D3D11_SKIP_TEX");
+            char *end;
+            while (e && *e && n < 16) {
+                skip[n++] = (uint32_t)strtoul(e, &end, 16) & 0x0FFFFFFFu;
+                e = (*end == ',') ? end + 1 : NULL;
+            }
+            init = 1;
+        }
+        if (n) {
+            const Nv2aTexture *t0 = b->stages[0] ? b->stages[0] : b->texture;
+            int k;
+            for (k = 0; t0 && k < n; k++)
+                if ((t0->offset & 0x0FFFFFFFu) == skip[k])
+                    return 1;
+        }
+    }
+    /* RECOMP_D3D11_CONST_DUMP=<hex address>: the first 3 draws that bind
+     * that texture on any stage log every non-zero vertex constant -- for
+     * finding which constant a title's texture-coordinate maths uses. */
+    {
+        static int init, shown;
+        static uint32_t want;
+        int k;
+        if (!init) {
+            const char *e = getenv("RECOMP_D3D11_CONST_DUMP");
+            want = e ? (uint32_t)strtoul(e, NULL, 16) & 0x0FFFFFFFu : 0;
+            init = 1;
+        }
+        for (k = 0; want && shown < 3 && k < 4; k++)
+            if (b->stages[k] && (b->stages[k]->offset & 0x0FFFFFFFu) == want
+                && b->stages[k]->width >= 640) {
+                int c;
+                shown++;
+                fprintf(stderr, "  [D3D11] draw with texture %08X on stage %d (surface %08X %ux%u):\n",
+                        want, k, s->color_va, s->width, s->height);
+                for (c = 0; c < 192; c++) {
+                    const float *v = p->constants[c];
+                    if (v[0] != 0.0f || v[1] != 0.0f || v[2] != 0.0f || v[3] != 0.0f)
+                        fprintf(stderr, "    c%-3d %12.6g %12.6g %12.6g %12.6g\n", c - 96, v[0], v[1], v[2], v[3]);
+                }
+                break;
+            }
+    }
+    /* RECOMP_D3D11_VSH=split: odd frames transform on the CPU, so frame
+     * dumps alternate the two paths and any difference shows as flicker. */
+    {
+        static int split = -1;
+        if (split < 0) {
+            const char *e = getenv("RECOMP_D3D11_VSH");
+            split = e && !strcmp(e, "split");
+        }
+        if (split && (s_frame & 1))
+            return 0;
+    }
+    if (!ensure_device() || ib_bytes > s_ib_size)
+        return 0;
+
+    /* The byte ranges the streams cover, merged where they overlap
+     * (interleaved attributes share one). */
+    for (a = 0; a < 16; a++) {
+        const Nv2aAttr *at = &p->attr[a];
+        uint64_t lo, hi;
+        int r;
+        if (!at->size)
+            continue;
+        lo = (uint64_t)at->offset + (uint64_t)p->index_min * at->stride;
+        hi = lo + (uint64_t)span * at->stride + at->bytes;
+        for (r = 0; r < nrg; r++)
+            if (lo <= rg[r].hi + 64 && rg[r].lo <= hi + 64) {
+                if (lo < rg[r].lo) rg[r].lo = lo;
+                if (hi > rg[r].hi) rg[r].hi = hi;
+                break;
+            }
+        if (r == nrg) {
+            rg[nrg].lo = lo;
+            rg[nrg].hi = hi;
+            nrg++;
+        }
+    }
+    for (j = 0; j < (uint32_t)nrg; j++) {         /* merging can chain */
+        int r;
+        for (r = (int)j + 1; r < nrg; r++)
+            if (rg[r].lo <= rg[j].hi + 64 && rg[j].lo <= rg[r].hi + 64) {
+                if (rg[r].lo < rg[j].lo) rg[j].lo = rg[r].lo;
+                if (rg[r].hi > rg[j].hi) rg[j].hi = rg[r].hi;
+                rg[r] = rg[--nrg];
+                r = (int)j;
+            }
+    }
+    for (j = 0; j < (uint32_t)nrg; j++) {
+        uint64_t a0 = rg[j].lo & ~3ull;
+        total += (UINT)(((rg[j].hi - a0) + 8 + 15) & ~15ull);
+        if (total > s_raw_size / 2)
+            return 0;
+    }
+
+    if (cull_all(b->state))
+        return 1;                               /* drawn: nothing survives */
+    if (!(t = bind_pipeline(s, b)))
+        return 0;
+
+    /* Streams. */
+    memset(&va, 0, sizeof va);
+    if (total) {
+        UINT pos;
+        if (!(dst = ring_map(s_raw, s_raw_size, &s_raw_pos, total, s_raw_nooverwrite)))
+            return 0;
+        pos = s_raw_pos;
+        for (j = 0; j < (uint32_t)nrg; j++) {
+            uint64_t a0 = rg[j].lo & ~3ull;
+            UINT n = (UINT)(rg[j].hi - a0);
+            memcpy(dst + pos, src + a0, n);
+            memset(dst + pos + n, 0, 8);
+            rg[j].pos = pos;
+            pos += (n + 8 + 15) & ~15u;
+        }
+        ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)s_raw, 0);
+        s_raw_pos = pos;
+        s_st.raw_bytes += total;
+        for (a = 0; a < 16; a++) {
+            const Nv2aAttr *at = &p->attr[a];
+            uint64_t lo;
+            if (!at->size)
+                continue;
+            lo = (uint64_t)at->offset + (uint64_t)p->index_min * at->stride;
+            for (j = 0; j < (uint32_t)nrg; j++)
+                if (rg[j].lo <= lo && lo < rg[j].hi)
+                    break;
+            va.attr[a][0] = rg[j].pos + (uint32_t)(lo - (rg[j].lo & ~3ull));
+            va.attr[a][1] = at->stride;
+            va.attr[a][2] = at->type;
+            va.attr[a][3] = at->size;
+        }
+    }
+    va.vm[0] = p->start_slot;
+    va.vm[1] = p->fog_enable;
+    va.vm[2] = p->fog_mode;
+    va.vf[0] = p->aa_sx;
+    va.vf[1] = p->aa_sy;
+    va.vf[2] = p->fog_param[0];
+    va.vf[3] = p->fog_param[1];
+
+    /* Triangles. */
+    if (!(dst = ring_map(s_ib, s_ib_size, &s_ib_pos, ib_bytes, 1)))
+        return 0;
+    memcpy(dst + s_ib_pos, p->indices, ib_bytes);
+    ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)s_ib, 0);
+    ib_off = s_ib_pos;
+    s_ib_pos += ib_bytes;
+
+    /* Program and constants, when they changed. */
+    if (p->program_gen != s_prog_gen) {
+        cb_put(s_cb_prog, p->program, 136 * 16);
+        s_prog_gen = p->program_gen;
+    }
+    if (p->constant_gen != s_const_gen) {
+        cb_put(s_cb_const, p->constants, 192 * 16);
+        s_const_gen = p->constant_gen;
+    }
+    cb_put(s_cb_va, &va, sizeof va);
+
+    cbs[0] = s_cb; cbs[1] = s_cb_prog; cbs[2] = s_cb_const; cbs[3] = s_cb_va;
+    ID3D11DeviceContext_IASetInputLayout(s_ctx, NULL);
+    ID3D11DeviceContext_IASetIndexBuffer(s_ctx, s_ib, DXGI_FORMAT_R32_UINT, ib_off);
+    ID3D11DeviceContext_VSSetShader(s_ctx, s_vs_prog, NULL, 0);
+    ID3D11DeviceContext_VSSetConstantBuffers(s_ctx, 0, 4, cbs);
+    ID3D11DeviceContext_VSSetShaderResources(s_ctx, 8, 1, &s_raw_srv);
+    gp_pre();
+    if (p->lines) {
+        /* RECOMP_D3D11_LINES=0 drops them as before; =2 paints them magenta,
+         * to see where a title draws lines. */
+        static int mode = -1;
+        static ID3D11PixelShader *magenta;
+        ID3D11PixelShader *was = NULL;
+        if (mode < 0) {
+            const char *e = getenv("RECOMP_D3D11_LINES");
+            static const char src[] =
+                "float4 ps(float4 p : SV_Position) : SV_Target { return float4(1, 0, 1, 1); }";
+            ID3D10Blob *blob = NULL;
+            mode = e ? atoi(e) : 1;
+            if (mode == 2 && SUCCEEDED(D3DCompile(src, sizeof src - 1, "magenta", NULL, NULL,
+                                                  "ps", "ps_5_0", 0, 0, &blob, NULL))) {
+                ID3D11Device_CreatePixelShader(s_dev, ID3D10Blob_GetBufferPointer(blob),
+                                               ID3D10Blob_GetBufferSize(blob), NULL, &magenta);
+                ID3D10Blob_Release(blob);
+            }
+        }
+        if (mode == 0)
+            return 1;
+        if (magenta) {
+            ID3D11DeviceContext_PSGetShader(s_ctx, &was, NULL, NULL);
+            ID3D11DeviceContext_PSSetShader(s_ctx, magenta, NULL, 0);
+        }
+        ID3D11DeviceContext_IASetPrimitiveTopology(s_ctx, D3D11_PRIMITIVE_TOPOLOGY_LINELIST);
+        ID3D11DeviceContext_DrawIndexed(s_ctx, p->count, 0, 0);
+        ID3D11DeviceContext_IASetPrimitiveTopology(s_ctx, D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+        if (magenta) {
+            ID3D11DeviceContext_PSSetShader(s_ctx, was, NULL, 0);
+            if (was)
+                ID3D11PixelShader_Release(was);
+        }
+    } else {
+        ID3D11DeviceContext_DrawIndexed(s_ctx, p->count, 0, 0);
+    }
+    gp_mark(gp_kind(b, 1), p->count, t);
+    maybe_flush();
+    t->dirty = 1;
+    t->ms_dirty = 1;
+    s_st.draws++;
+    s_st.pdraws++;
+    s_st.pverts += p->count;
+    return 1;
+}
+
+
+/* The finished frame, straight to the window. Returns 1 if it was shown. */
+static IDXGISwapChain1 *s_swap;
+static ID3D11RenderTargetView *s_bb_rtv;
+static UINT s_bb_w, s_bb_h;
+
+static int present_to_window(uint32_t pva)
+{
+    static int mode = -1, vsync;
+    HWND hwnd;
+    RECT cr;
+    UINT cw, ch;
+    uint32_t dw = 640, dh = 480;
+    Target *t = NULL;
+    int i;
+
+    if (mode < 0) {
+        const char *e = getenv("RECOMP_D3D11_PRESENT"), *v = getenv("RECOMP_VSYNC");
+        mode = !(e && *e == '0');
+        vsync = v && *v && *v != '0';
+    }
+    if (!mode || !pva || !(hwnd = xbox_FramebufferWindowHwnd()))
+        return 0;
+    for (i = 0; i < RT_MAX; i++)
+        if (s_rt[i].tex && s_rt[i].va == pva) { t = &s_rt[i]; break; }
+    if (!t || !t->gpu_valid || !blit_init())
+        return 0;
+    if (!GetClientRect(hwnd, &cr) || cr.right <= 0 || cr.bottom <= 0)
+        return 0;                               /* minimised */
+    cw = (UINT)cr.right;
+    ch = (UINT)cr.bottom;
+
+    if (!s_swap) {
+        IDXGIDevice *dxd = NULL;
+        IDXGIAdapter *ad = NULL;
+        IDXGIFactory2 *fac = NULL;
+        DXGI_SWAP_CHAIN_DESC1 sd;
+        HRESULT hr = ID3D11Device_QueryInterface(s_dev, &IID_IDXGIDevice, (void **)&dxd);
+        if (SUCCEEDED(hr)) hr = IDXGIDevice_GetAdapter(dxd, &ad);
+        if (SUCCEEDED(hr)) hr = IDXGIAdapter_GetParent(ad, &IID_IDXGIFactory2, (void **)&fac);
+        if (SUCCEEDED(hr)) {
+            memset(&sd, 0, sizeof sd);
+            sd.Width = cw;
+            sd.Height = ch;
+            sd.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+            sd.SampleDesc.Count = 1;
+            sd.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+            sd.BufferCount = 2;
+            sd.Scaling = DXGI_SCALING_STRETCH;
+            sd.SwapEffect = DXGI_SWAP_EFFECT_FLIP_DISCARD;
+            sd.AlphaMode = DXGI_ALPHA_MODE_IGNORE;
+            hr = IDXGIFactory2_CreateSwapChainForHwnd(fac, (IUnknown *)s_dev, hwnd, &sd,
+                                                      NULL, NULL, &s_swap);
+            if (SUCCEEDED(hr))  /* the window does its own F11 / Alt+Enter */
+                IDXGIFactory2_MakeWindowAssociation(fac, hwnd,
+                        DXGI_MWA_NO_ALT_ENTER | DXGI_MWA_NO_WINDOW_CHANGES);
+        }
+        if (fac) IDXGIFactory2_Release(fac);
+        if (ad) IDXGIAdapter_Release(ad);
+        if (dxd) IDXGIDevice_Release(dxd);
+        if (FAILED(hr) || !s_swap) {
+            d3d_log("CreateSwapChainForHwnd (falling back to the GDI window)", hr);
+            mode = 0;
+            return 0;
+        }
+        s_bb_w = cw;
+        s_bb_h = ch;
+        xbox_FramebufferWindowGpuPresent(1);
+        fprintf(stderr, "  [D3D11] presenting straight to the window (render scale %.2f%s)\n",
+                s_scale, vsync ? ", vsync" : "");
+        fflush(stderr);
+    }
+    if (cw != s_bb_w || ch != s_bb_h) {             /* resized, fullscreen */
+        if (s_bb_rtv) { ID3D11RenderTargetView_Release(s_bb_rtv); s_bb_rtv = NULL; }
+        ID3D11DeviceContext_OMSetRenderTargets(s_ctx, 0, NULL, NULL);
+        if (FAILED(IDXGISwapChain1_ResizeBuffers(s_swap, 0, cw, ch, DXGI_FORMAT_UNKNOWN, 0)))
+            return 0;
+        s_bb_w = cw;
+        s_bb_h = ch;
+    }
+    if (!s_bb_rtv) {
+        ID3D11Texture2D *bb = NULL;
+        if (FAILED(IDXGISwapChain1_GetBuffer(s_swap, 0, &IID_ID3D11Texture2D, (void **)&bb)))
+            return 0;
+        ID3D11Device_CreateRenderTargetView(s_dev, (ID3D11Resource *)bb, NULL, &s_bb_rtv);
+        ID3D11Texture2D_Release(bb);
+        if (!s_bb_rtv)
+            return 0;
+    }
+    {
+        static const float black[4] = { 0, 0, 0, 1 };
+        float sx, sy, vw, vh, ax, ay;
+        uint32_t aw = 4, ah = 3;
+        xbox_FramebufferWindowDisplaySize(&dw, &dh);
+        xbox_FramebufferWindowDisplayAspect(&aw, &ah);
+        if (!dw || !dh) { dw = 640; dh = 480; }
+        /* The display mode's TV shape (4:3, or 16:9 for a widescreen
+         * title's 720x480), letterboxed into the client area. Not dw:dh:
+         * Xbox pixels are not square. */
+        vw = (float)cw;
+        vh = vw * ah / aw;
+        if (vh > ch) { vh = (float)ch; vw = vh * aw / ah; }
+        ax = (cw - vw) * 0.5f;
+        ay = (ch - vh) * 0.5f;
+        sx = (float)(dw * t->aa_sx) / (float)t->width;
+        sy = (float)(dh * t->aa_sy) / (float)t->height;
+        if (sx > 1.0f) sx = 1.0f;
+        if (sy > 1.0f) sy = 1.0f;
+        ID3D11DeviceContext_ClearRenderTargetView(s_ctx, s_bb_rtv, black);
+        rt_resolve(t);
+        blit(t->srv, s_bb_rtv, ax, ay, vw, vh, 0.0f, 0.0f, sx, sy);
+    }
+    /* RECOMP_PRESENT_DUMP=<file.bmp>[:<n>]: the n-th presented frame
+     * (default 600), as the window shows it -- the check that scaled
+     * rendering reaches the screen. */
+    {
+        static int dump_at = -1, presents;
+        static char dump_path[MAX_PATH];
+        if (dump_at < 0) {
+            const char *e = getenv("RECOMP_PRESENT_DUMP");
+            dump_at = 0;
+            if (e && *e) {
+                const char *c = strrchr(e, ':');
+                snprintf(dump_path, sizeof dump_path, "%s", e);
+                dump_at = 600;
+                if (c && c > e + 2 && c[1] >= '0' && c[1] <= '9') {
+                    dump_path[c - e] = 0;
+                    dump_at = atoi(c + 1);
+                }
+            }
+        }
+        if (dump_at && ++presents == dump_at) {
+            ID3D11Texture2D *bb = NULL, *st = NULL;
+            D3D11_TEXTURE2D_DESC td;
+            D3D11_MAPPED_SUBRESOURCE m;
+            if (SUCCEEDED(IDXGISwapChain1_GetBuffer(s_swap, 0, &IID_ID3D11Texture2D, (void **)&bb))) {
+                ID3D11Texture2D_GetDesc(bb, &td);
+                td.Usage = D3D11_USAGE_STAGING;
+                td.BindFlags = 0;
+                td.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+                td.MiscFlags = 0;
+                if (SUCCEEDED(ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &st))) {
+                    ID3D11DeviceContext_CopyResource(s_ctx, (ID3D11Resource *)st, (ID3D11Resource *)bb);
+                    if (SUCCEEDED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)st, 0,
+                                                          D3D11_MAP_READ, 0, &m))) {
+                        FILE *f = fopen(dump_path, "wb");
+                        if (f) {
+                            uint32_t row = td.Width * 4, img = row * td.Height, total = 54 + img, y;
+                            int32_t hh = -(int32_t)td.Height;
+                            uint8_t hdr[54];
+                            memset(hdr, 0, sizeof hdr);
+                            hdr[0] = 'B'; hdr[1] = 'M';
+                            memcpy(hdr + 2, &total, 4);
+                            hdr[10] = 54; hdr[14] = 40;
+                            memcpy(hdr + 18, &td.Width, 4);
+                            memcpy(hdr + 22, &hh, 4);
+                            hdr[26] = 1; hdr[28] = 32;
+                            memcpy(hdr + 34, &img, 4);
+                            fwrite(hdr, 1, 54, f);
+                            for (y = 0; y < td.Height; y++)
+                                fwrite((const uint8_t *)m.pData + (size_t)y * m.RowPitch, 1, row, f);
+                            fclose(f);
+                            fprintf(stderr, "  [D3D11] presented frame %d (%ux%u) -> %s\n",
+                                    presents, td.Width, td.Height, dump_path);
+                        }
+                        ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)st, 0);
+                    }
+                    ID3D11Texture2D_Release(st);
+                }
+                ID3D11Texture2D_Release(bb);
+            }
+        }
+    }
+    IDXGISwapChain1_Present(s_swap, vsync ? 1 : 0, 0);
+    /* RECOMP_PRESENT_TRACE=1: the time of every present, for frame pacing. */
+    {
+        static int tr = -1, n;
+        static LARGE_INTEGER f;
+        LARGE_INTEGER t;
+        if (tr < 0) {
+            tr = getenv("RECOMP_PRESENT_TRACE") != NULL;
+            QueryPerformanceFrequency(&f);
+        }
+        if (tr && n < 40000) {
+            n++;
+            QueryPerformanceCounter(&t);
+            fprintf(stderr, "[PRESENT] %.3f\n",
+                    (double)(t.QuadPart % (f.QuadPart * 100000)) * 1000.0 / (double)f.QuadPart);
+        }
+    }
+    return 1;
+}
+
+static void d3d_flip(void)
+{
+    static int dumping = -1;
+    int presented;
+    if (!s_dev)
+        return;
+    if (dumping < 0)
+        dumping = getenv("RECOMP_FB_DUMP") != NULL;
+    /* RECOMP_FPS_CAP=<fps>: hold each flip to that rate. The executor stalls
+     * here, the title's next fence wait stalls on it, and the title runs at
+     * the rate its console did (a fixed 30 or 60). For telling timing bugs
+     * from others: uncapped, MA2 runs 100-160 fps. */
+    {
+        static double cap = -1.0, period;
+        static LARGE_INTEGER qf, next;
+        LARGE_INTEGER now;
+        if (cap < 0.0) {
+            const char *c = getenv("RECOMP_FPS_CAP");
+            cap = c && *c ? atof(c) : 0.0;
+            QueryPerformanceFrequency(&qf);
+            period = cap > 0.0 ? (double)qf.QuadPart / cap : 0.0;
+        }
+        if (cap > 0.0) {
+            QueryPerformanceCounter(&now);
+            if (next.QuadPart && now.QuadPart < next.QuadPart) {
+                LONGLONG ms = (next.QuadPart - now.QuadPart) * 1000 / qf.QuadPart;
+                if (ms > 1)
+                    Sleep((DWORD)(ms - 1));
+                do QueryPerformanceCounter(&now); while (now.QuadPart < next.QuadPart);
+                next.QuadPart += (LONGLONG)period;
+            } else {
+                next.QuadPart = now.QuadPart + (LONGLONG)period;
+            }
+        }
+    }
+    presented = present_to_window(nv2a_backend_present_va());
+    /* Write back every target drawn this frame: the window and the dumps
+     * read the finished frame from guest memory, and the one being shown is
+     * not always the one drawn last (MA2 draws effects into offscreen
+     * targets after the scene). Targets still aliased as textures stay
+     * resident on the GPU as well. */
+    {
+        uint32_t pva = nv2a_backend_present_va();
+        int i;
+        for (i = 0; i < RT_MAX; i++) {
+            Target *r = &s_rt[i];
+            if (!r->tex || !r->dirty)
+                continue;
+            /* Only the presented surface; offscreen targets stay on the GPU
+             * (anything that reads one as ordinary memory syncs it first). */
+            if (pva && !(r->va <= pva && pva < r->va + r->pitch * r->height))
+                continue;
+            /* Shown from the GPU already: guest memory catches up only when
+             * something reads it (or frame dumps want it). */
+            if (presented && !dumping)
+                continue;
+            rt_writeback(r);
+        }
+    }
+    s_cur = NULL;
+    ID3D11DeviceContext_OMSetRenderTargets(s_ctx, 0, NULL, NULL);
+    gp_end_frame();
+    /* GPU time per frame: timestamps around everything between two flips,
+     * read back four frames later so nothing waits for them. */
+    {
+        static ID3D11Query *dj[4], *t0[4], *t1[4];
+        static int open[4];
+        int k = (int)(s_frame & 3), nk = (int)((s_frame + 1) & 3);
+        if (!dj[0]) {
+            D3D11_QUERY_DESC qd;
+            int i;
+            for (i = 0; i < 4; i++) {
+                qd.MiscFlags = 0;
+                qd.Query = D3D11_QUERY_TIMESTAMP_DISJOINT;
+                ID3D11Device_CreateQuery(s_dev, &qd, &dj[i]);
+                qd.Query = D3D11_QUERY_TIMESTAMP;
+                ID3D11Device_CreateQuery(s_dev, &qd, &t0[i]);
+                ID3D11Device_CreateQuery(s_dev, &qd, &t1[i]);
+            }
+        }
+        if (open[k]) {
+            ID3D11DeviceContext_End(s_ctx, (ID3D11Asynchronous *)t1[k]);
+            ID3D11DeviceContext_End(s_ctx, (ID3D11Asynchronous *)dj[k]);
+            open[k] = 2;
+        }
+        if (open[nk] == 2) {
+            D3D11_QUERY_DATA_TIMESTAMP_DISJOINT d;
+            UINT64 a, b;
+            if (ID3D11DeviceContext_GetData(s_ctx, (ID3D11Asynchronous *)dj[nk], &d, sizeof d, 0) == S_OK
+                && ID3D11DeviceContext_GetData(s_ctx, (ID3D11Asynchronous *)t0[nk], &a, sizeof a, 0) == S_OK
+                && ID3D11DeviceContext_GetData(s_ctx, (ID3D11Asynchronous *)t1[nk], &b, sizeof b, 0) == S_OK
+                && !d.Disjoint && d.Frequency) {
+                s_st.gpu_ms += (double)(b - a) * 1000.0 / (double)d.Frequency;
+                s_st.gpu_frames++;
+            }
+            open[nk] = 0;
+        }
+        if (!open[nk]) {
+            ID3D11DeviceContext_Begin(s_ctx, (ID3D11Asynchronous *)dj[nk]);
+            ID3D11DeviceContext_End(s_ctx, (ID3D11Asynchronous *)t0[nk]);
+            open[nk] = 1;
+        }
+    }
+    s_frame++;
+    gp_begin_frame();
+    /* RECOMP_D3D11_RT_DUMP=<hex address>: every 120 frames, write that 32-bit
+     * render target back to guest memory and save it as
+     * d3d11_rt_<address>_<frame>.bmp in the working directory (debugging a
+     * title's off-screen passes). */
+    {
+        static int init;
+        static uint32_t want;
+        int i;
+        if (!init) {
+            const char *e = getenv("RECOMP_D3D11_RT_DUMP");
+            want = e ? (uint32_t)strtoul(e, NULL, 16) & 0x0FFFFFFFu : 0;
+            init = 1;
+        }
+        for (i = 0; want && s_frame % 120 == 0 && i < RT_MAX; i++) {
+            Target *t = &s_rt[i];
+            const uint8_t *mem;
+            char name[64];
+            FILE *f;
+            uint32_t x, y, row;
+            if (!t->tex || (t->va & 0x0FFFFFFFu) != want || t->bpp != 4)
+                continue;
+            t->dirty = 1;                   /* the GPU's pixels, now */
+            rt_writeback(t);
+            mem = (const uint8_t *)xbox_GetMemoryOffset() + t->va;
+            row = (t->width * 3 + 3) & ~3u;
+            snprintf(name, sizeof name, "d3d11_rt_%08X_%u.bmp", want, s_frame);
+            if ((f = fopen(name, "wb")) != NULL) {
+                uint8_t hdr[54] = { 'B', 'M' }, *line = (uint8_t *)calloc(row, 1);
+                uint32_t sz = 54 + row * t->height;
+                int32_t ww = (int32_t)t->width, hh = -(int32_t)t->height;
+                memcpy(hdr + 2, &sz, 4); hdr[10] = 54; hdr[14] = 40;
+                memcpy(hdr + 18, &ww, 4); memcpy(hdr + 22, &hh, 4);
+                hdr[26] = 1; hdr[28] = 24;
+                fwrite(hdr, 1, 54, f);
+                for (y = 0; line && y < t->height; y++) {
+                    for (x = 0; x < t->width; x++)
+                        memcpy(line + x * 3, mem + (size_t)y * t->pitch + x * 4, 3);
+                    fwrite(line, 1, row, f);
+                }
+                free(line);
+                fclose(f);
+            }
+        }
+    }
+    if (s_frame % 300 == 0) {
+        static int quiet = -1;
+        if (quiet < 0) {
+            const char *e = getenv("RECOMP_D3D11_STATS");
+            quiet = e && *e == '0';
+        }
+        if (!quiet) {
+            fprintf(stderr, "  [D3D11] per frame: %.0f draws (%.0f programs, %.0f indices,"
+                    " %.1f MB streams), %.0f verts, %.1f switches,"
+                    " %.1f uploads, %.1f writebacks, %.1f decodes (%.0f Ktexels),"
+                    " %.0f hashes (%.1f MB)\n",
+                    s_st.draws / 300.0, s_st.pdraws / 300.0, s_st.pverts / 300.0,
+                    s_st.raw_bytes / 300.0 / 1048576.0,
+                    s_st.verts / 300.0, s_st.switches / 300.0,
+                    s_st.uploads / 300.0, s_st.writebacks / 300.0, s_st.decodes / 300.0,
+                    s_st.decode_texels / 300.0 / 1000.0, s_st.hashes / 300.0,
+                    s_st.hash_bytes / 300.0 / 1048576.0);
+            fprintf(stderr, "  [D3D11] per frame: GPU span %.2f ms, write-back wait %.2f ms;"
+                    " %.0f%% of draws on specialised shaders (%ld compiled, %ld from cache)\n",
+                    s_st.gpu_frames ? s_st.gpu_ms / s_st.gpu_frames : 0.0,
+                    s_st.wb_ms / 300.0, s_st.draws ? 100.0 * s_st.spec / s_st.draws : 0.0,
+                    (long)s_ps_built, (long)s_ps_loaded);
+            fflush(stderr);
+        }
+        memset(&s_st, 0, sizeof s_st);
+    }
+}
+
+static Nv2aBackend s_d3d11 = { d3d_clear, d3d_draw, d3d_flip, d3d_draw_program };
+
+/* RECOMP_D3D11=1: rasterise on the host GPU. */
+void xbox_D3D11BackendInstall(void)
+{
+    const char *e = getenv("RECOMP_D3D11");
+    if (!e || !*e || *e == '0')
+        return;
+    e = getenv("RECOMP_D3D11_VSH");
+    if (e && *e == '0')
+        s_d3d11.draw_program = NULL;        /* vertex programs on the CPU */
+    nv2a_backend_register(&s_d3d11);
+    fprintf(stderr, "  [D3D11] GPU back end registered\n");
+    fflush(stderr);
+}
+
+#else
+
+void xbox_D3D11BackendInstall(void) { }
+
+#endif
diff --git a/templates/new-game/src/recomp_manual.c b/templates/new-game/src/recomp_manual.c
index a8de77d..f43c33d 100644
--- a/templates/new-game/src/recomp_manual.c
+++ b/templates/new-game/src/recomp_manual.c
@@ -111,18 +111,50 @@ recomp_func_t recomp_lookup_manual(uint32_t xbox_va)
  * During early bring-up you will see many of these. Most are harmless
  * (the ICALL macro pops the dummy return address and continues).
  * Focus on the ones that cause crashes or incorrect behavior.
+ *
+ * Rate-limited per address, like recomp_icall_not_code_log below: reported
+ * at 1, 10, 100, 1000 ... calls, with the recent targets on the first. A
+ * vtable method missing from the dispatch table fails every frame, and
+ * printing all 18 lines each time cost MechAssault 2 half its frame rate in
+ * combat: ~18,000 lines a second, one WriteFile each (stderr is unbuffered),
+ * on the thread running the game. The addresses are what tools.seed_from_log
+ * needs, and the first line per address carries them.
  */
 void recomp_icall_fail_log(uint32_t va)
 {
-    fprintf(stderr, "[ICALL] Failed to resolve VA 0x%08X (total calls: %llu)\n",
-            va, (unsigned long long)g_icall_count);
-
-    /* Dump last 16 call targets from the ring buffer */
-    fprintf(stderr, "  Recent ICALL targets:\n");
-    for (int i = 0; i < 16; i++) {
-        int idx = (g_icall_trace_idx - 16 + i) & 15;
-        if (g_icall_trace[idx])
-            fprintf(stderr, "    [%2d] 0x%08X\n", i, g_icall_trace[idx]);
+    enum { SLOTS = 64 };
+    static uint32_t seen[SLOTS];
+    static uint64_t hits[SLOTS + 1];    /* [SLOTS]: addresses past the table */
+    static int count;
+    uint64_t n;
+    int i, c = count;
+
+    /* Unlocked, like the logger below: two threads failing at once may
+     * share a slot or miss a count, but every index stays in bounds. */
+    for (i = 0; i < c && seen[i] != va; i++)
+        ;
+    if (i == c && c < SLOTS) {
+        seen[c] = va;
+        count = c + 1;
+    }
+    n = ++hits[i];
+    while (n >= 10 && n % 10 == 0)
+        n /= 10;
+    if (n != 1)
+        return;
+
+    fprintf(stderr, "[ICALL] Failed to resolve VA 0x%08X -- %llu time(s)%s (total calls: %llu)\n",
+            va, (unsigned long long)hits[i], i == SLOTS ? " (all addresses past the first 64)" : "",
+            (unsigned long long)g_icall_count);
+
+    if (hits[i] == 1) {
+        /* Dump last 16 call targets from the ring buffer */
+        fprintf(stderr, "  Recent ICALL targets:\n");
+        for (int k = 0; k < 16; k++) {
+            int idx = (g_icall_trace_idx - 16 + k) & 15;
+            if (g_icall_trace[idx])
+                fprintf(stderr, "    [%2d] 0x%08X\n", k, g_icall_trace[idx]);
+        }
     }
     fflush(stderr);
 }
