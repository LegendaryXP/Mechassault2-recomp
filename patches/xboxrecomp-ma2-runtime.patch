+            ID3D10Blob_GetBufferSize(psb), NULL, &s_ps);
+    if (FAILED(hr)) { d3d_log("CreatePixelShader", hr); return 0; }
+    hr = ID3D11Device_CreateInputLayout(s_dev, il, sizeof il / sizeof il[0],
+            ID3D10Blob_GetBufferPointer(vsb), ID3D10Blob_GetBufferSize(vsb), &s_il);
+    ID3D10Blob_Release(vsb);
+    ID3D10Blob_Release(psb);
+    if (FAILED(hr)) { d3d_log("CreateInputLayout", hr); return 0; }
+
+    memset(&bd, 0, sizeof bd);
+    bd.ByteWidth = (sizeof(CB) + 15) & ~15u;
+    bd.Usage = D3D11_USAGE_DYNAMIC;
+    bd.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+    bd.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+    hr = ID3D11Device_CreateBuffer(s_dev, &bd, NULL, &s_cb);
+    if (FAILED(hr)) { d3d_log("CreateBuffer(cb)", hr); return 0; }
+
+    s_vb_size = 16u << 20;
+    memset(&bd, 0, sizeof bd);
+    bd.ByteWidth = s_vb_size;
+    bd.Usage = D3D11_USAGE_DYNAMIC;
+    bd.BindFlags = D3D11_BIND_VERTEX_BUFFER;
+    bd.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+    hr = ID3D11Device_CreateBuffer(s_dev, &bd, NULL, &s_vb);
+    if (FAILED(hr)) { d3d_log("CreateBuffer(vb)", hr); return 0; }
+
+    {
+        static const UINT cbsz[3] = { 136 * 16, 192 * 16, (sizeof(VACB) + 15) & ~15u };
+        ID3D11Buffer **cbs[3] = { &s_cb_prog, &s_cb_const, &s_cb_va };
+        D3D11_SHADER_RESOURCE_VIEW_DESC vd;
+        D3D11_FEATURE_DATA_D3D11_OPTIONS fo;
+        int k;
+        for (k = 0; k < 3; k++) {
+            memset(&bd, 0, sizeof bd);
+            bd.ByteWidth = cbsz[k];
+            bd.Usage = D3D11_USAGE_DYNAMIC;
+            bd.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+            bd.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+            hr = ID3D11Device_CreateBuffer(s_dev, &bd, NULL, cbs[k]);
+            if (FAILED(hr)) { d3d_log("CreateBuffer(vs cb)", hr); return 0; }
+        }
+        s_ib_size = 16u << 20;
+        memset(&bd, 0, sizeof bd);
+        bd.ByteWidth = s_ib_size;
+        bd.Usage = D3D11_USAGE_DYNAMIC;
+        bd.BindFlags = D3D11_BIND_INDEX_BUFFER;
+        bd.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+        hr = ID3D11Device_CreateBuffer(s_dev, &bd, NULL, &s_ib);
+        if (FAILED(hr)) { d3d_log("CreateBuffer(ib)", hr); return 0; }
+        s_raw_size = 64u << 20;
+        memset(&bd, 0, sizeof bd);
+        bd.ByteWidth = s_raw_size;
+        bd.Usage = D3D11_USAGE_DYNAMIC;
+        bd.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+        bd.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+        bd.MiscFlags = D3D11_RESOURCE_MISC_BUFFER_ALLOW_RAW_VIEWS;
+        hr = ID3D11Device_CreateBuffer(s_dev, &bd, NULL, &s_raw);
+        if (FAILED(hr)) { d3d_log("CreateBuffer(raw)", hr); return 0; }
+        memset(&vd, 0, sizeof vd);
+        vd.Format = DXGI_FORMAT_R32_TYPELESS;
+        vd.ViewDimension = D3D11_SRV_DIMENSION_BUFFEREX;
+        vd.BufferEx.NumElements = s_raw_size / 4;
+        vd.BufferEx.Flags = D3D11_BUFFEREX_SRV_FLAG_RAW;
+        hr = ID3D11Device_CreateShaderResourceView(s_dev, (ID3D11Resource *)s_raw, &vd, &s_raw_srv);
+        if (FAILED(hr)) { d3d_log("CreateShaderResourceView(raw)", hr); return 0; }
+        memset(&fo, 0, sizeof fo);
+        if (SUCCEEDED(ID3D11Device_CheckFeatureSupport(s_dev, D3D11_FEATURE_D3D11_OPTIONS,
+                                                       &fo, sizeof fo)))
