diff --git a/src/video/nv2a_d3d11.c b/src/video/nv2a_d3d11.c
new file mode 100644
index 0000000..5d2b73c
--- /dev/null
+++ b/src/video/nv2a_d3d11.c
@@ -0,0 +1,1356 @@
+/*
+ * nv2a_d3d11.c -- a Direct3D 11 render back end for the pushbuffer executor.
+ *
+ * The executor (src/kernel/nv2a_pb_exec.c) still walks the pushbuffer, runs
+ * the vertex programs and clips at the near plane; everything after that --
+ * rasterisation, texturing, the register combiners, alpha/depth/stencil and
+ * blending -- runs on the host GPU here. On MechAssault 2 the CPU rasteriser
+ * spent about a microsecond per pixel interpreting combiners; this does the
+ * same work in one pixel shader.
+ *
+ * The pixel shader is an interpreter, not a translator: nv2a_combiner.c's
+ * evaluation ported to HLSL, with the combiner program (ICW/OCW words,
+ * factors, final combiner) in a constant buffer. One shader serves every
+ * program a title sets, nothing is compiled at run time after start-up, and
+ * a GPU runs eight stages per pixel in nanoseconds. Texture stage fetch
+ * (rc_stage_fetch) and the screen-space "texel * diffuse" path are ported
+ * the same way, so the image matches the CPU rasteriser's.
+ *
+ * Guest memory stays the source of truth between frames. Each colour surface
+ * the title draws into gets a render target; making a surface current
+ * uploads its guest pixels (so anything the CPU wrote is kept), and leaving
+ * it -- for another surface, or at a flip -- writes the result back, so the
+ * framebuffer window, the BMP dumps and render-to-texture all read the
+ * finished image from guest memory exactly as before. Textures are decoded
+ * with the executor's own decoder (nv2a_backend_decode_texture) and cached,
+ * keyed by address and format and re-checked once per frame by hashing their
+ * bytes; a write-back over a cached texture invalidates it.
+ *
+ * Opt-in: RECOMP_D3D11=1 (xbox_D3D11BackendInstall). Calls arrive one at a
+ * time on the executor's poll thread, so the immediate context needs no
+ * locking.
+ */
+#if defined(_WIN32)
+
+#define COBJMACROS
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <d3d11_1.h>
+#include <d3dcompiler.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "kernel/nv2a_backend.h"
+#include "d3d/d3d8_swizzle.h"
+
+#include <stddef.h>
+extern ptrdiff_t xbox_GetMemoryOffset(void);
+
+/* ---- shaders ----------------------------------------------------------- */
+
+static const char s_hlsl[] =
+"cbuffer B : register(b0) {\n"
+"  float4 g_surf;\n"           /* W, H, 1/zscale, mode (0 modulate, 1 combiners) */
+"  uint4  g_cicw[2]; uint4 g_aicw[2]; uint4 g_cocw[2]; uint4 g_aocw[2];\n"
+"  float4 g_f0[8]; float4 g_f1[8];\n"
+"  uint4  g_fin;\n"            /* final0, final1, control, stage_program */
+"  float4 g_fc0; float4 g_fc1; float4 g_fogc;\n"
+"  uint4  g_misc;\n"           /* alpha test enable, func, ref, clip plane mode */
+"  float4 g_tsz[4];\n"         /* w, h, normalized, cube */
+"  uint4  g_misc2;\n"          /* textured (modulate mode) */
+"};\n"
+"Texture2D T0 : register(t0); Texture2D T1 : register(t1);\n"
+"Texture2D T2 : register(t2); Texture2D T3 : register(t3);\n"
+"TextureCube C0 : register(t4); TextureCube C1 : register(t5);\n"
+"TextureCube C2 : register(t6); TextureCube C3 : register(t7);\n"
+"SamplerState S0 : register(s0); SamplerState S1 : register(s1);\n"
+"SamplerState S2 : register(s2); SamplerState S3 : register(s3);\n"
+"struct VI { float4 pos : POSITION; float4 d0 : COLOR0; float4 d1 : COLOR1;\n"
+"  float fog : FOGF; float2 uv : TEXCOORD4; float4 t0 : TEXCOORD0;\n"
+"  float4 t1 : TEXCOORD1; float4 t2 : TEXCOORD2; float4 t3 : TEXCOORD3; };\n"
+"struct VO { float4 pos : SV_Position; noperspective float4 d0 : COLOR0;\n"
+"  noperspective float4 d1 : COLOR1; noperspective float fog : FOGF;\n"
+"  float2 uv : TEXCOORD4; float4 t0 : TEXCOORD0; float4 t1 : TEXCOORD1;\n"
+"  float4 t2 : TEXCOORD2; float4 t3 : TEXCOORD3; };\n"
+"VO vs_main(VI i) {\n"
+"  VO o;\n"
+"  float w = (i.pos.w != 0.0) ? 1.0 / i.pos.w : 1.0;\n"
+"  float nx = i.pos.x / g_surf.x * 2.0 - 1.0;\n"
+"  float ny = 1.0 - i.pos.y / g_surf.y * 2.0;\n"
+"  float nz = saturate(i.pos.z * g_surf.z);\n"
+"  o.pos = float4(nx * w, ny * w, nz * w, w);\n"
+"  o.d0 = i.d0; o.d1 = i.d1; o.fog = i.fog; o.uv = i.uv;\n"
+"  o.t0 = i.t0; o.t1 = i.t1; o.t2 = i.t2; o.t3 = i.t3;\n"
+"  return o;\n"
+"}\n"
+"static float4 R[16];\n"
+"float map_in(float x, uint m) {\n"
+"  float p = max(x, 0.0);\n"
+"  if (m == 0) return p;\n"
+"  if (m == 1) return 1.0 - saturate(x);\n"
+"  if (m == 2) return 2.0 * p - 1.0;\n"
+"  if (m == 3) return -2.0 * p + 1.0;\n"
+"  if (m == 4) return p - 0.5;\n"
+"  if (m == 5) return -p + 0.5;\n"
+"  if (m == 6) return x;\n"
+"  return -x;\n"
+"}\n"
+"float map_out(float x, uint m) {\n"
+"  if (m == 0x08) return x - 0.5;\n"
+"  if (m == 0x10) return x * 2.0;\n"
+"  if (m == 0x18) return (x - 0.5) * 2.0;\n"
+"  if (m == 0x20) return x * 4.0;\n"
+"  if (m == 0x30) return x * 0.5;\n"
+"  return x;\n"
+"}\n"
+"float3 read_rgb(uint b) {\n"
+"  float4 r = R[b & 0xF]; uint m = (b >> 5) & 7;\n"
+"  float3 v = (b & 0x10) ? r.aaa : r.rgb;\n"
+"  return float3(map_in(v.x, m), map_in(v.y, m), map_in(v.z, m));\n"
+"}\n"
+"float read_alpha(uint b) {\n"
+"  float4 r = R[b & 0xF];\n"
+"  return map_in((b & 0x10) ? r.a : r.b, (b >> 5) & 7);\n"
+"}\n"
+"float4 tex2d(uint st, float2 uv) {\n"
+"  if (st == 0) return T0.SampleLevel(S0, uv, 0);\n"
+"  if (st == 1) return T1.SampleLevel(S1, uv, 0);\n"
+"  if (st == 2) return T2.SampleLevel(S2, uv, 0);\n"
+"  return T3.SampleLevel(S3, uv, 0);\n"
+"}\n"
+"float4 texcube(uint st, float3 d) {\n"
+"  if (st == 0) return C0.SampleLevel(S0, d, 0);\n"
+"  if (st == 1) return C1.SampleLevel(S1, d, 0);\n"
+"  if (st == 2) return C2.SampleLevel(S2, d, 0);\n"
+"  return C3.SampleLevel(S3, d, 0);\n"
+"}\n"
+"float4 stage_fetch(uint st, float4 c, inout bool keep) {\n"
+"  uint mode = (g_fin.w >> (st * 5)) & 0x1F;\n"
+"  float4 sz = g_tsz[st];\n"
+"  if (mode == 0) return float4(0, 0, 0, 1);\n"
+"  if (mode == 1 || mode == 2) {\n"
+"    float q = (c.w != 0.0) ? c.w : 1.0;\n"
+"    float2 uv = c.xy / q;\n"
+"    if (sz.z == 0.0) uv /= max(sz.xy, 1.0);\n"
+"    return tex2d(st, uv);\n"
+"  }\n"
+"  if (mode == 3) {\n"
+"    if (sz.w == 0.0) { float2 uv = c.xy; if (sz.z == 0.0) uv /= max(sz.xy, 1.0);\n"
+"                       return tex2d(st, uv); }\n"
+"    return texcube(st, c.xyz);\n"
+"  }\n"
+"  if (mode == 4) return saturate(c);\n"
+"  if (mode == 5) {\n"
+"    [unroll] for (uint j = 0; j < 4; j++) {\n"
+"      uint ge = (g_misc.w >> (st * 4 + j)) & 1;\n"
+"      if (ge ? (c[j] >= 0.0) : (c[j] < 0.0)) keep = false;\n"
+"    }\n"
+"    return float4(0, 0, 0, 0);\n"
+"  }\n"
+"  return float4(0, 0, 0, 0);\n"
+"}\n"
+"bool alpha_pass(float a) {\n"
+"  if (g_misc.x == 0) return true;\n"
+"  int v = (int)(a * 255.0 + 0.5), r = (int)(g_misc.z & 0xFF);\n"
+"  uint f = g_misc.y;\n"
+"  if (f == 0x200) return false;\n"
+"  if (f == 0x201) return v < r;\n"
+"  if (f == 0x202) return v == r;\n"
+"  if (f == 0x203) return v <= r;\n"
+"  if (f == 0x204) return v > r;\n"
+"  if (f == 0x205) return v != r;\n"
+"  if (f == 0x206) return v >= r;\n"
+"  return true;\n"
+"}\n"
+"float4 ps_main(VO i) : SV_Target {\n"
+"  float4 col = i.d0;\n"
+"  if (g_surf.w == 0.0) {\n"                         /* texel * diffuse */
+"    float4 o = col;\n"
+"    if (g_misc2.x != 0) o = T0.SampleLevel(S0, i.uv / max(g_tsz[0].xy, 1.0), 0) * col;\n"
+"    o = saturate(o);\n"
+"    if (!alpha_pass(o.a)) discard;\n"
+"    return o;\n"
+"  }\n"
+"  float4 t[4]; bool keep = true;\n"
+"  t[0] = stage_fetch(0, i.t0, keep); t[1] = stage_fetch(1, i.t1, keep);\n"
+"  t[2] = stage_fetch(2, i.t2, keep); t[3] = stage_fetch(3, i.t3, keep);\n"
+"  if (!keep) discard;\n"
+"  [unroll] for (uint k = 0; k < 16; k++) R[k] = float4(0, 0, 0, 0);\n"
+"  R[3] = float4(g_fogc.rgb, i.fog); R[4] = col; R[5] = i.d1;\n"
+"  R[8] = t[0]; R[9] = t[1]; R[10] = t[2]; R[11] = t[3];\n"
+"  R[12].a = (g_fin.w & 0x1F) ? t[0].a : 1.0;\n"
+"  uint n = min(g_fin.z & 0xFF, 8u), flags = g_fin.z >> 8;\n"
+"  for (uint s = 0; s < n; s++) {\n"
+"    uint icw = g_cicw[s >> 2][s & 3], ocw = g_cocw[s >> 2][s & 3];\n"
+"    uint aicw = g_aicw[s >> 2][s & 3], aocw = g_aocw[s >> 2][s & 3];\n"
+"    uint fl = ocw >> 12, afl = aocw >> 12;\n"
+"    R[1] = g_f0[(flags & 0x010) ? s : 0];\n"
+"    R[2] = g_f1[(flags & 0x100) ? s : 0];\n"
+"    bool mux = (flags & 1) ? (R[12].a >= 0.5) : (((int)(R[12].a * 255.0)) & 1) != 0;\n"
+"    float3 A = read_rgb(icw >> 24), Bv = read_rgb(icw >> 16);\n"
+"    float3 Cv = read_rgb(icw >> 8), D = read_rgb(icw);\n"
+"    float aA = read_alpha(aicw >> 24), aB = read_alpha(aicw >> 16);\n"
+"    float aC = read_alpha(aicw >> 8), aD = read_alpha(aicw);\n"
+"    float dab = dot(A, Bv), dcd = dot(Cv, D);\n"
+"    float3 pab = (fl & 2) ? dab.xxx : A * Bv;\n"
+"    float3 pcd = (fl & 1) ? dcd.xxx : Cv * D;\n"
+"    float3 sum = (fl & 4) ? (mux ? pcd : pab) : pab + pcd;\n"
+"    uint om = fl & 0x38;\n"
+"    float3 ab = clamp(float3(map_out(pab.x, om), map_out(pab.y, om), map_out(pab.z, om)), -1.0, 1.0);\n"
+"    float3 cd = clamp(float3(map_out(pcd.x, om), map_out(pcd.y, om), map_out(pcd.z, om)), -1.0, 1.0);\n"
+"    float3 ms = clamp(float3(map_out(sum.x, om), map_out(sum.y, om), map_out(sum.z, om)), -1.0, 1.0);\n"
+"    float apab = aA * aB, apcd = aC * aD;\n"
+"    float asum = (afl & 4) ? (mux ? apcd : apab) : apab + apcd;\n"
+"    uint aom = afl & 0x38;\n"
+"    float aab = clamp(map_out(apab, aom), -1.0, 1.0);\n"
+"    float acd = clamp(map_out(apcd, aom), -1.0, 1.0);\n"
+"    float ams = clamp(map_out(asum, aom), -1.0, 1.0);\n"
+"    uint d;\n"
+"    d = (ocw >> 4) & 0xF; if (d) { R[d].rgb = ab; if (fl & 0x80) R[d].a = ab.z; }\n"
+"    d = ocw & 0xF;        if (d) { R[d].rgb = cd; if (fl & 0x40) R[d].a = cd.z; }\n"
+"    d = (ocw >> 8) & 0xF; if (d) R[d].rgb = ms;\n"
+"    d = (aocw >> 4) & 0xF; if (d) R[d].a = aab;\n"
+"    d = aocw & 0xF;        if (d) R[d].a = acd;\n"
+"    d = (aocw >> 8) & 0xF; if (d) R[d].a = ams;\n"
+"    R[0] = float4(0, 0, 0, 0);\n"
+"  }\n"
+"  float4 o;\n"
+"  if (g_fin.x != 0 || g_fin.y != 0) {\n"
+"    uint f0 = g_fin.x, f1 = g_fin.y, ff = f1 & 0xFF;\n"
+"    R[1] = g_fc0; R[2] = g_fc1;\n"
+"    float3 a = (ff & 0x40) ? 1.0 - R[5].rgb : R[5].rgb;\n"
+"    float3 b = (ff & 0x20) ? 1.0 - R[12].rgb : R[12].rgb;\n"
+"    R[14] = float4((ff & 0x80) ? saturate(a + b) : a + b, 0.0);\n"
+"    float3 E = read_rgb(f1 >> 24), F = read_rgb(f1 >> 16);\n"
+"    R[15] = float4(E * F, 0.0);\n"
+"    float3 A = read_rgb(f0 >> 24), Bv = read_rgb(f0 >> 16);\n"
+"    float3 Cv = read_rgb(f0 >> 8), D = read_rgb(f0);\n"
+"    o.rgb = D + Cv * (1.0 - A) + Bv * A;\n"
+"    o.a = read_alpha(f1 >> 8);\n"
+"  } else {\n"
+"    o = R[12];\n"
+"  }\n"
+"  o = saturate(o);\n"
+"  if (!alpha_pass(o.a)) discard;\n"
+"  return o;\n"
+"}\n";
+
+/* Matches cbuffer B above (16-byte rows). */
+typedef struct {
+    float    surf[4];
+    uint32_t cicw[8], aicw[8], cocw[8], aocw[8];
+    float    f0[8][4], f1[8][4];
+    uint32_t fin[4];
+    float    fc0[4], fc1[4], fogc[4];
+    uint32_t misc[4];
+    float    tsz[4][4];
+    uint32_t misc2[4];
+} CB;
+
+typedef struct {
+    float pos[4], d0[4], d1[4];
+    float fog;
+    float uv[2];
+    float t[4][4];
+} GV;
+
+/* ---- device state ------------------------------------------------------ */
+
+static ID3D11Device *s_dev;
+static ID3D11DeviceContext *s_ctx;
+static ID3D11DeviceContext1 *s_ctx1;
+static ID3D11VertexShader *s_vs;
+static ID3D11PixelShader *s_ps;
+static ID3D11InputLayout *s_il;
+static ID3D11Buffer *s_cb, *s_vb;
+static UINT s_vb_size, s_vb_pos;
+static ID3D11ShaderResourceView *s_white2d, *s_whitecube;
+static ID3D11RasterizerState *s_rs;
+static int s_failed;
+static uint32_t s_frame = 1;
+static GV *s_gv;
+static UINT s_gv_cap;
+
+/* Per-frame work, printed every 300 flips (RECOMP_D3D11_STATS=0 hushes). */
+static struct {
+    uint32_t draws, verts, switches, uploads, writebacks, decodes, hashes;
+    uint64_t decode_texels, hash_bytes;
+} s_st;
+
+static void d3d_log(const char *what, HRESULT hr)
+{
+    fprintf(stderr, "  [D3D11] %s failed (0x%08lX)\n", what, (unsigned long)hr);
+    fflush(stderr);
+}
+
+static int compile(const char *entry, const char *target, ID3DBlob **out)
+{
+    ID3DBlob *err = NULL;
+    HRESULT hr = D3DCompile(s_hlsl, sizeof s_hlsl - 1, "nv2a_d3d11", NULL, NULL,
+                            entry, target, D3DCOMPILE_OPTIMIZATION_LEVEL3, 0,
+                            out, &err);
+    if (FAILED(hr)) {
+        fprintf(stderr, "  [D3D11] shader %s: %s\n", entry,
+                err ? (const char *)ID3D10Blob_GetBufferPointer(err) : "?");
+        if (err) ID3D10Blob_Release(err);
+        return 0;
+    }
+    if (err) ID3D10Blob_Release(err);
+    return 1;
+}
+
+static ID3D11ShaderResourceView *make_white(int cube)
+{
+    D3D11_TEXTURE2D_DESC td;
+    D3D11_SUBRESOURCE_DATA sd[6];
+    D3D11_SHADER_RESOURCE_VIEW_DESC vd;
+    ID3D11Texture2D *t = NULL;
+    ID3D11ShaderResourceView *v = NULL;
+    static const uint32_t white = 0xFFFFFFFFu;
+    int i;
+
+    memset(&td, 0, sizeof td);
+    td.Width = td.Height = 1;
+    td.MipLevels = 1;
+    td.ArraySize = cube ? 6 : 1;
+    td.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    td.SampleDesc.Count = 1;
+    td.Usage = D3D11_USAGE_IMMUTABLE;
+    td.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+    td.MiscFlags = cube ? D3D11_RESOURCE_MISC_TEXTURECUBE : 0;
+    for (i = 0; i < 6; i++) {
+        sd[i].pSysMem = &white;
+        sd[i].SysMemPitch = 4;
+        sd[i].SysMemSlicePitch = 4;
+    }
+    if (FAILED(ID3D11Device_CreateTexture2D(s_dev, &td, sd, &t)))
+        return NULL;
+    memset(&vd, 0, sizeof vd);
+    vd.Format = td.Format;
+    if (cube) {
+        vd.ViewDimension = D3D11_SRV_DIMENSION_TEXTURECUBE;
+        vd.TextureCube.MipLevels = 1;
+    } else {
+        vd.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE2D;
+        vd.Texture2D.MipLevels = 1;
+    }
+    ID3D11Device_CreateShaderResourceView(s_dev, (ID3D11Resource *)t, &vd, &v);
+    ID3D11Texture2D_Release(t);
+    return v;
+}
+
+static int ensure_device(void)
+{
+    static const D3D11_INPUT_ELEMENT_DESC il[] = {
+        { "POSITION", 0, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 0,   D3D11_INPUT_PER_VERTEX_DATA, 0 },
+        { "COLOR",    0, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 16,  D3D11_INPUT_PER_VERTEX_DATA, 0 },
+        { "COLOR",    1, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 32,  D3D11_INPUT_PER_VERTEX_DATA, 0 },
+        { "FOGF",     0, DXGI_FORMAT_R32_FLOAT,          0, 48,  D3D11_INPUT_PER_VERTEX_DATA, 0 },
+        { "TEXCOORD", 4, DXGI_FORMAT_R32G32_FLOAT,       0, 52,  D3D11_INPUT_PER_VERTEX_DATA, 0 },
+        { "TEXCOORD", 0, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 60,  D3D11_INPUT_PER_VERTEX_DATA, 0 },
+        { "TEXCOORD", 1, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 76,  D3D11_INPUT_PER_VERTEX_DATA, 0 },
+        { "TEXCOORD", 2, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 92,  D3D11_INPUT_PER_VERTEX_DATA, 0 },
+        { "TEXCOORD", 3, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 108, D3D11_INPUT_PER_VERTEX_DATA, 0 },
+    };
+    D3D_FEATURE_LEVEL fl;
+    ID3DBlob *vsb = NULL, *psb = NULL;
+    D3D11_BUFFER_DESC bd;
+    D3D11_RASTERIZER_DESC rd;
+    HRESULT hr;
+
+    if (s_dev)
+        return 1;
+    if (s_failed)
+        return 0;
+    s_failed = 1;
+    hr = D3D11CreateDevice(NULL, D3D_DRIVER_TYPE_HARDWARE, NULL,
+                           D3D11_CREATE_DEVICE_BGRA_SUPPORT, NULL, 0,
+                           D3D11_SDK_VERSION, &s_dev, &fl, &s_ctx);
+    if (FAILED(hr)) { d3d_log("D3D11CreateDevice", hr); return 0; }
+    ID3D11DeviceContext_QueryInterface(s_ctx, &IID_ID3D11DeviceContext1, (void **)&s_ctx1);
+    if (!compile("vs_main", "vs_5_0", &vsb) || !compile("ps_main", "ps_5_0", &psb))
+        return 0;
+    hr = ID3D11Device_CreateVertexShader(s_dev, ID3D10Blob_GetBufferPointer(vsb),
+            ID3D10Blob_GetBufferSize(vsb), NULL, &s_vs);
+    if (FAILED(hr)) { d3d_log("CreateVertexShader", hr); return 0; }
+    hr = ID3D11Device_CreatePixelShader(s_dev, ID3D10Blob_GetBufferPointer(psb),
+            ID3D10Blob_GetBufferSize(psb), NULL, &s_ps);
+    if (FAILED(hr)) { d3d_log("CreatePixelShader", hr); return 0; }
+    hr = ID3D11Device_CreateInputLayout(s_dev, il, sizeof il / sizeof il[0],
+            ID3D10Blob_GetBufferPointer(vsb), ID3D10Blob_GetBufferSize(vsb), &s_il);
+    ID3D10Blob_Release(vsb);
+    ID3D10Blob_Release(psb);
+    if (FAILED(hr)) { d3d_log("CreateInputLayout", hr); return 0; }
+
+    memset(&bd, 0, sizeof bd);
+    bd.ByteWidth = (sizeof(CB) + 15) & ~15u;
+    bd.Usage = D3D11_USAGE_DYNAMIC;
+    bd.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+    bd.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+    hr = ID3D11Device_CreateBuffer(s_dev, &bd, NULL, &s_cb);
+    if (FAILED(hr)) { d3d_log("CreateBuffer(cb)", hr); return 0; }
+
+    s_vb_size = 16u << 20;
+    memset(&bd, 0, sizeof bd);
+    bd.ByteWidth = s_vb_size;
+    bd.Usage = D3D11_USAGE_DYNAMIC;
+    bd.BindFlags = D3D11_BIND_VERTEX_BUFFER;
+    bd.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+    hr = ID3D11Device_CreateBuffer(s_dev, &bd, NULL, &s_vb);
+    if (FAILED(hr)) { d3d_log("CreateBuffer(vb)", hr); return 0; }
+
+    memset(&rd, 0, sizeof rd);
+    rd.FillMode = D3D11_FILL_SOLID;
+    rd.CullMode = D3D11_CULL_NONE;      /* the CPU rasteriser draws both windings */
+    rd.DepthClipEnable = FALSE;         /* window z is clamped, not clipped */
+    rd.ScissorEnable = TRUE;
+    hr = ID3D11Device_CreateRasterizerState(s_dev, &rd, &s_rs);
+    if (FAILED(hr)) { d3d_log("CreateRasterizerState", hr); return 0; }
+
+    s_white2d = make_white(0);
+    s_whitecube = make_white(1);
+    s_failed = 0;
+    fprintf(stderr, "  [D3D11] back end up (feature level 0x%X)\n", (unsigned)fl);
+    fflush(stderr);
+    return 1;
+}
+
+/* ---- textures ----------------------------------------------------------- */
+
+typedef struct {
+    Nv2aTexture key;
+    uint64_t hash;
+    uint32_t checked;               /* frame of the last hash check */
+    uint32_t bytes;                 /* hashed span, all faces */
+    ID3D11ShaderResourceView *srv;
+    uint32_t used;                  /* frame last used, for eviction */
+} TexEntry;
+
+#define TEX_MAX 512
+static uint8_t s_fmt_bad[256];      /* see tex_get */
+static TexEntry s_tex[TEX_MAX];
+static uint32_t *s_decode;
+static size_t s_decode_cap;
+
+static uint64_t hash_bytes(const uint8_t *p, size_t n)
+{
+    uint64_t h = 0x9E3779B97F4A7C15ull ^ n;
+    size_t i;
+    for (i = 0; i + 8 <= n; i += 8) {
+        uint64_t w;
+        memcpy(&w, p + i, 8);
+        h = (h ^ w) * 0xFF51AFD7ED558CCDull;
+        h ^= h >> 32;
+    }
+    for (; i < n; i++)
+        h = (h ^ p[i]) * 0x100000001B3ull;
+    return h;
+}
+
+static int tex_same(const Nv2aTexture *a, const Nv2aTexture *b)
+{
+    return a->offset == b->offset && a->width == b->width && a->height == b->height
+        && a->pitch == b->pitch && a->color == b->color && a->cube == b->cube
+        && a->palette == b->palette && a->face_stride == b->face_stride;
+}
+
+static uint32_t tex_span(const Nv2aTexture *t)
+{
+    uint32_t one = nv2a_backend_texture_bytes(t);
+    return t->cube ? t->face_stride * 5 + one : one;
+}
+
+static ID3D11ShaderResourceView *tex_create(const Nv2aTexture *t)
+{
+    D3D11_TEXTURE2D_DESC td;
+    D3D11_SUBRESOURCE_DATA sd[6];
+    D3D11_SHADER_RESOURCE_VIEW_DESC vd;
+    ID3D11Texture2D *tx = NULL;
+    ID3D11ShaderResourceView *v = NULL;
+    uint32_t faces = t->cube ? 6 : 1, f;
+    size_t texels = (size_t)t->width * t->height;
+
+    if (!t->width || !t->height || t->width > 4096 || t->height > 4096)
+        return NULL;
+    if (s_decode_cap < texels * faces) {
+        free(s_decode);
+        s_decode_cap = texels * faces;
+        s_decode = (uint32_t *)malloc(s_decode_cap * 4);
+        if (!s_decode) { s_decode_cap = 0; return NULL; }
+    }
+    /* DXT goes to the GPU as it is: BC1/BC2/BC3 are the same blocks. */
+    if ((t->color == 0x0C || t->color == 0x0E || t->color == 0x0F)
+        && !(t->width & 3) && !(t->height & 3)) {
+        const uint8_t *mem = (const uint8_t *)xbox_GetMemoryOffset();
+        UINT bb = t->color == 0x0C ? 8 : 16;
+        for (f = 0; f < faces; f++) {
+            sd[f].pSysMem = mem + t->offset + f * t->face_stride;
+            sd[f].SysMemPitch = (t->width / 4) * bb;
+            sd[f].SysMemSlicePitch = (t->width / 4) * (t->height / 4) * bb;
+        }
+        memset(&td, 0, sizeof td);
+        td.Width = t->width;
+        td.Height = t->height;
+        td.MipLevels = 1;
+        td.ArraySize = faces;
+        td.Format = t->color == 0x0C ? DXGI_FORMAT_BC1_UNORM
+                  : t->color == 0x0E ? DXGI_FORMAT_BC2_UNORM : DXGI_FORMAT_BC3_UNORM;
+        goto create;
+    }
+    for (f = 0; f < faces; f++) {
+        Nv2aTexture one = *t;
+        uint32_t *dst = s_decode + texels * f;
+        const uint8_t *src = (const uint8_t *)xbox_GetMemoryOffset() + t->offset
+                           + f * t->face_stride;
+        int pow2 = !(t->width & (t->width - 1)) && !(t->height & (t->height - 1));
+        one.offset = t->offset + f * t->face_stride;
+        sd[f].pSysMem = dst;
+        sd[f].SysMemPitch = t->width * 4;
+        sd[f].SysMemSlicePitch = (UINT)(texels * 4);
+        /* 32-bit ARGB in bulk: the same bytes as B8G8R8A8, just placed. */
+        if ((t->color == 0x06 || t->color == 0x07) && pow2) {       /* swizzled */
+            xbox_unswizzle_rect(dst, src, t->width, t->height, 4);
+            if (t->color == 0x07) {
+                size_t k;
+                for (k = 0; k < texels; k++) dst[k] |= 0xFF000000u;
+            }
+            continue;
+        }
+        if ((t->color == 0x12 || t->color == 0x1E) && t->pitch >= t->width * 4) {
+            uint32_t y;
+            for (y = 0; y < t->height; y++) {
+                memcpy(dst + (size_t)y * t->width, src + (size_t)y * t->pitch,
+                       (size_t)t->width * 4);
+                if (t->color == 0x1E) {
+                    uint32_t x;
+                    for (x = 0; x < t->width; x++)
+                        dst[(size_t)y * t->width + x] |= 0xFF000000u;
+                }
+            }
+            continue;
+        }
+        if (!nv2a_backend_decode_texture(&one, dst)) {
+            s_fmt_bad[t->color & 0xFF] = 1;
+            fprintf(stderr, "  [D3D11] texture format 0x%X not decodable: sampled as white\n",
+                    t->color);
+            return NULL;                /* unsupported format: white */
+        }
+    }
+    memset(&td, 0, sizeof td);
+    td.Width = t->width;
+    td.Height = t->height;
+    td.MipLevels = 1;
+    td.ArraySize = faces;
+    td.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+create:
+    td.SampleDesc.Count = 1;
+    td.Usage = D3D11_USAGE_IMMUTABLE;
+    td.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+    td.MiscFlags = t->cube ? D3D11_RESOURCE_MISC_TEXTURECUBE : 0;
+    if (FAILED(ID3D11Device_CreateTexture2D(s_dev, &td, sd, &tx)))
+        return NULL;
+    memset(&vd, 0, sizeof vd);
+    vd.Format = td.Format;
+    if (t->cube) {
+        vd.ViewDimension = D3D11_SRV_DIMENSION_TEXTURECUBE;
+        vd.TextureCube.MipLevels = 1;
+    } else {
+        vd.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE2D;
+        vd.Texture2D.MipLevels = 1;
+    }
+    ID3D11Device_CreateShaderResourceView(s_dev, (ID3D11Resource *)tx, &vd, &v);
+    ID3D11Texture2D_Release(tx);
+    return v;
+}
+
+static ID3D11ShaderResourceView *rt_alias(const Nv2aTexture *t, float *w, float *h);
+static void rt_sync_overlap(uint32_t va, uint32_t n);
+static ID3D11ShaderResourceView *tex_get_decoded(const Nv2aTexture *t);
+
+/* The view a stage samples, and the size its texel coordinates divide by:
+ * a render target the title draws into and then samples is used where it
+ * is, on the GPU; anything else comes from guest memory, decoded. */
+/* Colour formats the executor's decoder cannot read. The CPU rasteriser
+ * samples white for them; so does this, without hashing or writing anything
+ * back first (MA2 samples two 16-bit render targets as format 0x17 every
+ * frame, and syncing them cost more than the rest of the frame). */
+static ID3D11ShaderResourceView *tex_get(const Nv2aTexture *t, float *w, float *h)
+{
+    ID3D11ShaderResourceView *a;
+    if (s_fmt_bad[t->color & 0xFF])
+        return NULL;
+    *w = (float)t->width;
+    *h = (float)t->height;
+    a = rt_alias(t, w, h);
+    if (a)
+        return a;
+    /* Memory a render target has drawn newer pixels into must be written
+     * back before it can be read as an ordinary texture. */
+    rt_sync_overlap(t->offset, tex_span(t));
+    return tex_get_decoded(t);
+}
+
+static ID3D11ShaderResourceView *tex_get_decoded(const Nv2aTexture *t)
+{
+    const uint8_t *mem = (const uint8_t *)xbox_GetMemoryOffset();
+    TexEntry *e = NULL, *victim = &s_tex[0];
+    int i;
+
+    for (i = 0; i < TEX_MAX; i++) {
+        if (s_tex[i].bytes && tex_same(&s_tex[i].key, t)) { e = &s_tex[i]; break; }
+        if (s_tex[i].used < victim->used) victim = &s_tex[i];
+    }
+    if (e && e->checked == s_frame) {
+        e->used = s_frame;
+        return e->srv;
+    }
+    {
+        uint32_t span = tex_span(t);
+        uint64_t h = span ? hash_bytes(mem + t->offset, span) : 0;
+        s_st.hashes++;
+        s_st.hash_bytes += span;
+        if (e && e->hash == h) {
+            e->checked = s_frame;
+            e->used = s_frame;
+            return e->srv;
+        }
+        if (!e) {
+            e = victim;
+            if (e->srv) ID3D11ShaderResourceView_Release(e->srv);
+            memset(e, 0, sizeof *e);
+        } else if (e->srv) {
+            ID3D11ShaderResourceView_Release(e->srv);
+            e->srv = NULL;
+        }
+        e->key = *t;
+        e->hash = h;
+        e->bytes = span ? span : 1;
+        e->checked = s_frame;
+        e->used = s_frame;
+        e->srv = tex_create(t);
+        s_st.decodes++;
+        s_st.decode_texels += (uint64_t)t->width * t->height * (t->cube ? 6 : 1);
+        return e->srv;
+    }
+}
+
+/* A write-back landed on [va, va+n): re-check any texture there. */
+static void tex_invalidate(uint32_t va, uint32_t n)
+{
+    int i;
+    for (i = 0; i < TEX_MAX; i++)
+        if (s_tex[i].bytes && s_tex[i].key.offset < va + n
+            && va < s_tex[i].key.offset + s_tex[i].bytes)
+            s_tex[i].checked = 0;
+}
+
+/* ---- render targets ----------------------------------------------------- */
+
+typedef struct {
+    uint32_t va, pitch, width, height, bpp;
+    ID3D11Texture2D *tex, *staging;
+    ID3D11RenderTargetView *rtv;
+    ID3D11ShaderResourceView *srv;
+    ID3D11Texture2D *copy;              /* for sampling while drawn into */
+    ID3D11ShaderResourceView *copy_srv;
+    int dirty;              /* the GPU holds pixels guest memory does not */
+    int gpu_valid;          /* the render target holds the surface at all */
+    uint64_t guest_hash;    /* guest bytes when the two last agreed */
+} Target;
+
+typedef struct {
+    uint32_t va, width, height;
+    ID3D11Texture2D *tex;
+    ID3D11DepthStencilView *dsv;
+} Depth;
+
+#define RT_MAX 16
+static Target s_rt[RT_MAX];
+static Depth s_ds[8];
+static Target *s_cur;
+static uint32_t *s_conv;
+static size_t s_conv_cap;
+
+static uint32_t *conv_buf(size_t texels)
+{
+    if (s_conv_cap < texels) {
+        free(s_conv);
+        s_conv = (uint32_t *)malloc(texels * 4);
+        s_conv_cap = s_conv ? texels : 0;
+    }
+    return s_conv;
+}
+
+/* Guest pixels -> render target. 32-bit surfaces are B8G8R8A8 already. */
+static void rt_upload(Target *t)
+{
+    uint8_t *mem = (uint8_t *)xbox_GetMemoryOffset() + t->va;
+    s_st.uploads++;
+    t->gpu_valid = 1;
+    t->guest_hash = hash_bytes(mem, (size_t)t->pitch * t->height);
+    if (t->bpp == 4) {
+        ID3D11DeviceContext_UpdateSubresource(s_ctx, (ID3D11Resource *)t->tex, 0,
+                                              NULL, mem, t->pitch, 0);
+    } else {
+        uint32_t *c = conv_buf((size_t)t->width * t->height), x, y;
+        if (!c) return;
+        for (y = 0; y < t->height; y++) {
+            const uint16_t *s = (const uint16_t *)(mem + (size_t)y * t->pitch);
+            for (x = 0; x < t->width; x++) {
+                uint16_t v = s[x];
+                uint32_t r = ((v >> 11) & 0x1F) * 255u / 31u;
+                uint32_t g = ((v >> 5) & 0x3F) * 255u / 63u;
+                uint32_t b = (v & 0x1F) * 255u / 31u;
+                c[(size_t)y * t->width + x] = 0xFF000000u | (r << 16) | (g << 8) | b;
+            }
+        }
+        ID3D11DeviceContext_UpdateSubresource(s_ctx, (ID3D11Resource *)t->tex, 0,
+                                              NULL, c, t->width * 4, 0);
+    }
+}
+
+/* Render target -> guest pixels. */
+static void rt_writeback(Target *t)
+{
+    D3D11_MAPPED_SUBRESOURCE m;
+    uint8_t *mem = (uint8_t *)xbox_GetMemoryOffset() + t->va;
+    uint32_t y, x;
+
+    if (!t->dirty)
+        return;
+    t->dirty = 0;
+    s_st.writebacks++;
+    ID3D11DeviceContext_CopyResource(s_ctx, (ID3D11Resource *)t->staging,
+                                     (ID3D11Resource *)t->tex);
+    if (FAILED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)t->staging, 0,
+                                       D3D11_MAP_READ, 0, &m)))
+        return;
+    for (y = 0; y < t->height; y++) {
+        const uint8_t *src = (const uint8_t *)m.pData + (size_t)y * m.RowPitch;
+        uint8_t *dst = mem + (size_t)y * t->pitch;
+        if (t->bpp == 4) {
+            memcpy(dst, src, (size_t)t->width * 4);
+        } else {
+            const uint32_t *s = (const uint32_t *)src;
+            uint16_t *d = (uint16_t *)dst;
+            for (x = 0; x < t->width; x++) {
+                uint32_t c = s[x];
+                d[x] = (uint16_t)(((c >> 8) & 0xF800) | ((c >> 5) & 0x07E0)
+                                | ((c >> 3) & 0x001F));
+            }
+        }
+    }
+    ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)t->staging, 0);
+    t->guest_hash = hash_bytes(mem, (size_t)t->pitch * t->height);
+    tex_invalidate(t->va, t->pitch * t->height);
+}
+
+static void rt_release(Target *t)
+{
+    if (t->rtv) ID3D11RenderTargetView_Release(t->rtv);
+    if (t->srv) ID3D11ShaderResourceView_Release(t->srv);
+    if (t->copy_srv) ID3D11ShaderResourceView_Release(t->copy_srv);
+    if (t->copy) ID3D11Texture2D_Release(t->copy);
+    if (t->tex) ID3D11Texture2D_Release(t->tex);
+    if (t->staging) ID3D11Texture2D_Release(t->staging);
+    memset(t, 0, sizeof *t);
+}
+
+static Target *rt_get(const Nv2aSurface *s)
+{
+    uint32_t bpp = s->bytes_per_pixel, w, h;
+    D3D11_TEXTURE2D_DESC td;
+    Target *t = NULL;
+    int i;
+
+    if ((bpp != 4 && bpp != 2) || !s->pitch || !s->color_va)
+        return NULL;
+    w = s->pitch / bpp;
+    h = s->clip_y + s->height;
+    if (!w || !h || w > 4096 || h > 4096)
+        return NULL;
+    for (i = 0; i < RT_MAX; i++)
+        if (s_rt[i].tex && s_rt[i].va == s->color_va && s_rt[i].pitch == s->pitch
+            && s_rt[i].bpp == bpp && s_rt[i].height >= h)
+            return &s_rt[i];
+    for (i = 0; i < RT_MAX; i++)
+        if (!s_rt[i].tex) { t = &s_rt[i]; break; }
+    if (!t) {                                   /* recycle one, not the current */
+        for (i = 0; i < RT_MAX; i++)
+            if (&s_rt[i] != s_cur) { t = &s_rt[i]; break; }
+        rt_writeback(t);
+        rt_release(t);
+    }
+    memset(&td, 0, sizeof td);
+    td.Width = w;
+    td.Height = h;
+    td.MipLevels = 1;
+    td.ArraySize = 1;
+    td.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    td.SampleDesc.Count = 1;
+    td.Usage = D3D11_USAGE_DEFAULT;
+    td.BindFlags = D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
+    if (FAILED(ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &t->tex)))
+        return NULL;
+    td.Usage = D3D11_USAGE_STAGING;
+    td.BindFlags = 0;
+    td.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    if (FAILED(ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &t->staging))) {
+        rt_release(t);
+        return NULL;
+    }
+    ID3D11Device_CreateRenderTargetView(s_dev, (ID3D11Resource *)t->tex, NULL, &t->rtv);
+    ID3D11Device_CreateShaderResourceView(s_dev, (ID3D11Resource *)t->tex, NULL, &t->srv);
+    t->va = s->color_va;
+    t->pitch = s->pitch;
+    t->bpp = bpp;
+    t->width = w;
+    t->height = h;
+    return t;
+}
+
+static ID3D11DepthStencilView *ds_get(uint32_t va, uint32_t w, uint32_t h)
+{
+    D3D11_TEXTURE2D_DESC td;
+    Depth *d = NULL;
+    int i;
+    static int next;
+
+    if (!va)
+        return NULL;
+    for (i = 0; i < 8; i++)
+        if (s_ds[i].tex && s_ds[i].va == va && s_ds[i].width == w && s_ds[i].height == h)
+            return s_ds[i].dsv;
+    d = &s_ds[next++ & 7];
+    if (d->dsv) ID3D11DepthStencilView_Release(d->dsv);
+    if (d->tex) ID3D11Texture2D_Release(d->tex);
+    memset(d, 0, sizeof *d);
+    memset(&td, 0, sizeof td);
+    td.Width = w;
+    td.Height = h;
+    td.MipLevels = 1;
+    td.ArraySize = 1;
+    td.Format = DXGI_FORMAT_D32_FLOAT_S8X24_UINT;
+    td.SampleDesc.Count = 1;
+    td.Usage = D3D11_USAGE_DEFAULT;
+    td.BindFlags = D3D11_BIND_DEPTH_STENCIL;
+    if (FAILED(ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &d->tex)))
+        return NULL;
+    ID3D11Device_CreateDepthStencilView(s_dev, (ID3D11Resource *)d->tex, NULL, &d->dsv);
+    ID3D11DeviceContext_ClearDepthStencilView(s_ctx, d->dsv,
+            D3D11_CLEAR_DEPTH | D3D11_CLEAR_STENCIL, 1.0f, 0);
+    d->va = va;
+    d->width = w;
+    d->height = h;
+    return d->dsv;
+}
+
+/* Make `s` the surface being drawn: write the previous one back, upload this
+ * one's guest pixels, bind it with its depth buffer. */
+static Target *activate(const Nv2aSurface *s, const Nv2aRenderState *rs)
+{
+    Target *t = rt_get(s);
+    ID3D11DepthStencilView *dsv;
+
+    if (!t)
+        return NULL;
+    if (t != s_cur) {
+        s_st.switches++;
+        /* Render targets stay on the GPU across switches. Upload guest
+         * pixels the first time, and again only if the CPU has changed
+         * them since the two last agreed -- never while the GPU is newer. */
+        if (!t->gpu_valid) {
+            rt_upload(t);
+        } else if (!t->dirty) {
+            const uint8_t *mem = (const uint8_t *)xbox_GetMemoryOffset() + t->va;
+            if (hash_bytes(mem, (size_t)t->pitch * t->height) != t->guest_hash)
+                rt_upload(t);
+        }
+        s_cur = t;
+    }
+    dsv = rs ? ds_get(rs->zeta_va, t->width, t->height) : NULL;
+    ID3D11DeviceContext_OMSetRenderTargets(s_ctx, 1, &t->rtv, dsv);
+    return t;
+}
+
+/* A texture that is a render target's own pixels: linear 32-bit at the
+ * surface's address with its pitch. Sampled straight from the GPU copy,
+ * with texel coordinates divided by the render target's size. Not while it
+ * is being drawn into (that would bind one resource both ways). */
+static ID3D11ShaderResourceView *rt_alias(const Nv2aTexture *t, float *w, float *h)
+{
+    int i;
+    if (t->cube || t->normalized || (t->color != 0x12 && t->color != 0x1E))
+        return NULL;
+    for (i = 0; i < RT_MAX; i++) {
+        Target *r = &s_rt[i];
+        if (!r->tex || !r->gpu_valid || r->va != t->offset || r->bpp != 4
+            || r->pitch != t->pitch || !r->srv)
+            continue;
+        if (r == s_cur) {
+            /* Sampling the surface being drawn (a screen effect): sample a
+             * GPU copy of it as it stands. */
+            if (!r->copy) {
+                D3D11_TEXTURE2D_DESC td;
+                ID3D11Texture2D_GetDesc(r->tex, &td);
+                td.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+                if (FAILED(ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &r->copy)))
+                    return NULL;
+                ID3D11Device_CreateShaderResourceView(s_dev, (ID3D11Resource *)r->copy,
+                                                      NULL, &r->copy_srv);
+            }
+            ID3D11DeviceContext_CopyResource(s_ctx, (ID3D11Resource *)r->copy,
+                                             (ID3D11Resource *)r->tex);
+            *w = (float)r->width;
+            *h = (float)r->height;
+            return r->copy_srv;
+        }
+        *w = (float)r->width;
+        *h = (float)r->height;
+        return r->srv;
+    }
+    return NULL;
+}
+
+int d3d_rt_overlaps(uint32_t va, uint32_t n)
+{
+    int i;
+    for (i = 0; i < RT_MAX; i++)
+        if (s_rt[i].tex && s_rt[i].dirty && s_rt[i].va < va + n
+            && va < s_rt[i].va + s_rt[i].pitch * s_rt[i].height)
+            return 1;
+    return 0;
+}
+
+/* Write back any render target holding newer pixels in [va, va+n). */
+static void rt_sync_overlap(uint32_t va, uint32_t n)
+{
+    int i;
+    for (i = 0; i < RT_MAX; i++) {
+        Target *r = &s_rt[i];
+        if (r->tex && r->dirty && r->va < va + n
+            && va < r->va + r->pitch * r->height) {
+            rt_writeback(r);
+        }
+    }
+}
+
+/* ---- pipeline state ------------------------------------------------------ */
+
+static D3D11_BLEND blend_of(uint32_t f, int alpha)
+{
+    switch (f) {
+    case 0x0000: return D3D11_BLEND_ZERO;
+    case 0x0001: return D3D11_BLEND_ONE;
+    case 0x0300: return alpha ? D3D11_BLEND_SRC_ALPHA : D3D11_BLEND_SRC_COLOR;
+    case 0x0301: return alpha ? D3D11_BLEND_INV_SRC_ALPHA : D3D11_BLEND_INV_SRC_COLOR;
+    case 0x0302: return D3D11_BLEND_SRC_ALPHA;
+    case 0x0303: return D3D11_BLEND_INV_SRC_ALPHA;
+    case 0x0304: return D3D11_BLEND_DEST_ALPHA;
+    case 0x0305: return D3D11_BLEND_INV_DEST_ALPHA;
+    case 0x0306: return alpha ? D3D11_BLEND_DEST_ALPHA : D3D11_BLEND_DEST_COLOR;
+    case 0x0307: return alpha ? D3D11_BLEND_INV_DEST_ALPHA : D3D11_BLEND_INV_DEST_COLOR;
+    case 0x0308: return D3D11_BLEND_SRC_ALPHA_SAT;
+    case 0x8001: case 0x8003: return D3D11_BLEND_BLEND_FACTOR;
+    case 0x8002: case 0x8004: return D3D11_BLEND_INV_BLEND_FACTOR;
+    default:     return f ? D3D11_BLEND_ONE : D3D11_BLEND_ZERO;
+    }
+}
+
+static D3D11_BLEND_OP blend_op_of(uint32_t e)
+{
+    switch (e) {
+    case 0x8007: return D3D11_BLEND_OP_MIN;
+    case 0x8008: return D3D11_BLEND_OP_MAX;
+    case 0x800A: return D3D11_BLEND_OP_SUBTRACT;
+    case 0x800B: return D3D11_BLEND_OP_REV_SUBTRACT;
+    default:     return D3D11_BLEND_OP_ADD;
+    }
+}
+
+static D3D11_COMPARISON_FUNC cmp_of(uint32_t f)
+{
+    switch (f) {
+    case 0x200: return D3D11_COMPARISON_NEVER;
+    case 0x201: return D3D11_COMPARISON_LESS;
+    case 0x202: return D3D11_COMPARISON_EQUAL;
+    case 0x203: return D3D11_COMPARISON_LESS_EQUAL;
+    case 0x204: return D3D11_COMPARISON_GREATER;
+    case 0x205: return D3D11_COMPARISON_NOT_EQUAL;
+    case 0x206: return D3D11_COMPARISON_GREATER_EQUAL;
+    default:    return D3D11_COMPARISON_ALWAYS;
+    }
+}
+
+static D3D11_STENCIL_OP sop_of(uint32_t o)
+{
+    switch (o) {
+    case 0x0000: return D3D11_STENCIL_OP_ZERO;
+    case 0x1E01: return D3D11_STENCIL_OP_REPLACE;
+    case 0x1E02: return D3D11_STENCIL_OP_INCR_SAT;
+    case 0x1E03: return D3D11_STENCIL_OP_DECR_SAT;
+    case 0x150A: return D3D11_STENCIL_OP_INVERT;
+    case 0x8507: return D3D11_STENCIL_OP_INCR;
+    case 0x8508: return D3D11_STENCIL_OP_DECR;
+    default:     return D3D11_STENCIL_OP_KEEP;
+    }
+}
+
+/* Small caches of state objects keyed by their descriptions. */
+#define STATE_MAX 128
+static struct { D3D11_BLEND_DESC d; ID3D11BlendState *s; } s_bs[STATE_MAX];
+static struct { D3D11_DEPTH_STENCIL_DESC d; ID3D11DepthStencilState *s; } s_dss[STATE_MAX];
+static struct { D3D11_SAMPLER_DESC d; ID3D11SamplerState *s; } s_ss[32];
+static int s_nbs, s_ndss, s_nss;
+
+static ID3D11BlendState *blend_state(const Nv2aRenderState *r)
+{
+    D3D11_BLEND_DESC d;
+    D3D11_RENDER_TARGET_BLEND_DESC *t = &d.RenderTarget[0];
+    UINT8 mask = 0;
+    int i;
+
+    memset(&d, 0, sizeof d);
+    if (r->color_mask & 0x00010000u) mask |= D3D11_COLOR_WRITE_ENABLE_RED;
+    if (r->color_mask & 0x00000100u) mask |= D3D11_COLOR_WRITE_ENABLE_GREEN;
+    if (r->color_mask & 0x00000001u) mask |= D3D11_COLOR_WRITE_ENABLE_BLUE;
+    if (r->color_mask & 0x01000000u) mask |= D3D11_COLOR_WRITE_ENABLE_ALPHA;
+    t->RenderTargetWriteMask = mask;
+    t->BlendEnable = r->blend_enable ? TRUE : FALSE;
+    t->SrcBlend = blend_of(r->blend_src, 0);
+    t->DestBlend = blend_of(r->blend_dst, 0);
+    t->BlendOp = blend_op_of(r->blend_eq);
+    t->SrcBlendAlpha = blend_of(r->blend_src, 1);
+    t->DestBlendAlpha = blend_of(r->blend_dst, 1);
+    t->BlendOpAlpha = t->BlendOp;
+    if (!t->BlendEnable) {
+        t->SrcBlend = t->SrcBlendAlpha = D3D11_BLEND_ONE;
+        t->DestBlend = t->DestBlendAlpha = D3D11_BLEND_ZERO;
+        t->BlendOp = t->BlendOpAlpha = D3D11_BLEND_OP_ADD;
+    }
+    for (i = 0; i < s_nbs; i++)
+        if (!memcmp(&s_bs[i].d, &d, sizeof d))
+            return s_bs[i].s;
+    if (s_nbs == STATE_MAX)
+        return s_bs[0].s;
+    s_bs[s_nbs].d = d;
+    ID3D11Device_CreateBlendState(s_dev, &d, &s_bs[s_nbs].s);
+    return s_bs[s_nbs++].s;
+}
+
+static ID3D11DepthStencilState *depth_state(const Nv2aRenderState *r)
+{
+    D3D11_DEPTH_STENCIL_DESC d;
+    int i;
+
+    memset(&d, 0, sizeof d);
+    /* The CPU path writes depth whenever the mask is on, test or not; D3D
+     * only writes with the test enabled, so "no test" is ALWAYS. */
+    d.DepthEnable = (r->depth_test_enable || r->depth_write) && r->zeta_va;
+    d.DepthFunc = r->depth_test_enable ? cmp_of(r->depth_func) : D3D11_COMPARISON_ALWAYS;
+    d.DepthWriteMask = r->depth_write ? D3D11_DEPTH_WRITE_MASK_ALL : D3D11_DEPTH_WRITE_MASK_ZERO;
+    d.StencilEnable = r->stencil_enable && r->zeta_va ? TRUE : FALSE;
+    d.StencilReadMask = (UINT8)r->stencil_func_mask;
+    d.StencilWriteMask = (UINT8)r->stencil_write_mask;
+    d.FrontFace.StencilFunc = cmp_of(r->stencil_func);
+    d.FrontFace.StencilFailOp = sop_of(r->stencil_fail);
+    d.FrontFace.StencilDepthFailOp = sop_of(r->stencil_zfail);
+    d.FrontFace.StencilPassOp = sop_of(r->stencil_zpass);
+    d.BackFace = d.FrontFace;
+    for (i = 0; i < s_ndss; i++)
+        if (!memcmp(&s_dss[i].d, &d, sizeof d))
+            return s_dss[i].s;
+    if (s_ndss == STATE_MAX)
+        return s_dss[0].s;
+    s_dss[s_ndss].d = d;
+    ID3D11Device_CreateDepthStencilState(s_dev, &d, &s_dss[s_ndss].s);
+    return s_dss[s_ndss++].s;
+}
+
+/* As rc_texel: tent when MAG is 2 or MIN is 2/4/6, else nearest; wrap mode 1
+ * wraps, everything else clamps. */
+static ID3D11SamplerState *sampler(const Nv2aTexture *t)
+{
+    D3D11_SAMPLER_DESC d;
+    uint32_t mag = t ? (t->filter >> 24) & 0xF : 0, min = t ? (t->filter >> 16) & 0xFF : 0;
+    int lin = mag == 2 || min == 2 || min == 4 || min == 6, i;
+
+    memset(&d, 0, sizeof d);
+    d.Filter = lin ? D3D11_FILTER_MIN_MAG_MIP_LINEAR : D3D11_FILTER_MIN_MAG_MIP_POINT;
+    d.AddressU = t && t->addr_u == 1 ? D3D11_TEXTURE_ADDRESS_WRAP : D3D11_TEXTURE_ADDRESS_CLAMP;
+    d.AddressV = t && t->addr_v == 1 ? D3D11_TEXTURE_ADDRESS_WRAP : D3D11_TEXTURE_ADDRESS_CLAMP;
+    d.AddressW = D3D11_TEXTURE_ADDRESS_CLAMP;
+    d.MaxLOD = D3D11_FLOAT32_MAX;
+    d.ComparisonFunc = D3D11_COMPARISON_NEVER;
+    for (i = 0; i < s_nss; i++)
+        if (!memcmp(&s_ss[i].d, &d, sizeof d))
+            return s_ss[i].s;
+    if (s_nss == 32)
+        return s_ss[0].s;
+    s_ss[s_nss].d = d;
+    ID3D11Device_CreateSamplerState(s_dev, &d, &s_ss[s_nss].s);
+    return s_ss[s_nss++].s;
+}
+
+static void unpack(uint32_t c, float o[4])
+{
+    o[0] = (float)((c >> 16) & 0xFF) / 255.0f;
+    o[1] = (float)((c >> 8) & 0xFF) / 255.0f;
+    o[2] = (float)(c & 0xFF) / 255.0f;
+    o[3] = (float)(c >> 24) / 255.0f;
+}
+
+/* ---- the back end -------------------------------------------------------- */
+
+static void viewport_for(const Target *t, const Nv2aSurface *s)
+{
+    D3D11_VIEWPORT vp;
+    D3D11_RECT sc;
+    vp.TopLeftX = 0;
+    vp.TopLeftY = 0;
+    vp.Width = (float)t->width;
+    vp.Height = (float)t->height;
+    vp.MinDepth = 0.0f;
+    vp.MaxDepth = 1.0f;
+    ID3D11DeviceContext_RSSetViewports(s_ctx, 1, &vp);
+    /* The executor clips to SET_SURFACE_CLIP; s->width/height are its size
+     * at the origin the executor already applied. */
+    sc.left = (LONG)s->clip_x;
+    sc.top = (LONG)s->clip_y;
+    sc.right = (LONG)(s->clip_x + s->width < t->width ? s->clip_x + s->width : t->width);
+    sc.bottom = (LONG)(s->clip_y + s->height < t->height ? s->clip_y + s->height : t->height);
+    ID3D11DeviceContext_RSSetScissorRects(s_ctx, 1, &sc);
+}
+
+static void d3d_clear(const Nv2aSurface *s, const Nv2aRenderState *rs,
+                      uint32_t flags, uint32_t argb, uint32_t zstencil)
+{
+    Target *t;
+    ID3D11DepthStencilView *dsv;
+
+    (void)zstencil;
+    if (!ensure_device() || !(t = activate(s, rs)))
+        return;
+    if ((flags & 0xF0) && rs->color_mask) {
+        float c[4];
+        D3D11_RECT r;
+        unpack(argb, c);
+        r.left = (LONG)s->clip_x;
+        r.top = (LONG)s->clip_y;
+        r.right = (LONG)(s->clip_x + s->width < t->width ? s->clip_x + s->width : t->width);
+        r.bottom = (LONG)(s->clip_y + s->height < t->height ? s->clip_y + s->height : t->height);
+        if (s_ctx1)
+            ID3D11DeviceContext1_ClearView(s_ctx1, (ID3D11View *)t->rtv, c, &r, 1);
+        else
+            ID3D11DeviceContext_ClearRenderTargetView(s_ctx, t->rtv, c);
+        t->dirty = 1;
+    }
+    dsv = ds_get(rs->zeta_va, t->width, t->height);
+    if (dsv && (flags & 3)) {
+        float z = rs->depth_scale > 0.0f ? rs->zclear / rs->depth_scale : 1.0f;
+        UINT what = ((flags & 1) ? D3D11_CLEAR_DEPTH : 0)
+                  | ((flags & 2) ? D3D11_CLEAR_STENCIL : 0);
+        if (z > 1.0f) z = 1.0f;
+        if (z < 0.0f) z = 0.0f;
+        ID3D11DeviceContext_ClearDepthStencilView(s_ctx, dsv, what, z,
+                                                  (UINT8)(zstencil & 0xFF));
+    }
+}
+
+static void d3d_draw(const Nv2aSurface *s, const Nv2aBatch *b)
+{
+    Target *t;
+    CB cb;
+    D3D11_MAPPED_SUBRESOURCE m;
+    ID3D11ShaderResourceView *srv[8];
+    ID3D11SamplerState *smp[4];
+    const Nv2aRenderState *r = b->state;
+    UINT stride = sizeof(GV), offset, bytes, i, st;
+    float bf[4];
+
+    if (!b->count || !ensure_device() || !(t = activate(s, r)))
+        return;
+    viewport_for(t, s);
+
+    /* Vertices. */
+    if (s_gv_cap < b->count) {
+        free(s_gv);
+        s_gv = (GV *)malloc(sizeof(GV) * b->count);
+        s_gv_cap = s_gv ? b->count : 0;
+        if (!s_gv) return;
+    }
+    for (i = 0; i < b->count; i++) {
+        const Nv2aVertex *v = &b->vertices[i];
+        GV *g = &s_gv[i];
+        g->pos[0] = v->x; g->pos[1] = v->y; g->pos[2] = v->z; g->pos[3] = v->rhw;
+        memcpy(g->d0, v->d0, 16);
+        memcpy(g->d1, v->d1, 16);
+        g->fog = v->fog;
+        g->uv[0] = v->u; g->uv[1] = v->v;
+        memcpy(g->t, v->tex, sizeof g->t);
+    }
+    bytes = b->count * (UINT)sizeof(GV);
+    if (bytes > s_vb_size)
+        return;
+    if (s_vb_pos + bytes > s_vb_size)
+        s_vb_pos = 0;
+    if (FAILED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)s_vb, 0,
+            s_vb_pos ? D3D11_MAP_WRITE_NO_OVERWRITE : D3D11_MAP_WRITE_DISCARD, 0, &m)))
+        return;
+    memcpy((uint8_t *)m.pData + s_vb_pos, s_gv, bytes);
+    ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)s_vb, 0);
+    offset = s_vb_pos;
+    s_vb_pos += bytes;
+
+    /* Constants. */
+    memset(&cb, 0, sizeof cb);
+    cb.surf[0] = (float)t->width;
+    cb.surf[1] = (float)t->height;
+    cb.surf[2] = r->depth_scale > 0.0f ? 1.0f / r->depth_scale : 1.0f / 16777215.0f;
+    cb.surf[3] = b->rc ? 1.0f : 0.0f;
+    cb.misc[0] = r->alpha_test_enable;
+    cb.misc[1] = r->alpha_func;
+    cb.misc[2] = r->alpha_ref;
+    cb.misc[3] = b->clip_plane_mode;
+    for (st = 0; st < 8; st++) srv[st] = st < 4 ? s_white2d : s_whitecube;
+    for (st = 0; st < 4; st++) smp[st] = sampler(NULL);
+    if (b->rc) {
+        const Nv2aCombiner *rc = b->rc;
+        float fogc[4];
+        for (i = 0; i < 8; i++) {
+            cb.cicw[i] = rc->color_icw[i]; cb.aicw[i] = rc->alpha_icw[i];
+            cb.cocw[i] = rc->color_ocw[i]; cb.aocw[i] = rc->alpha_ocw[i];
+            unpack(rc->factor0[i], cb.f0[i]);
+            unpack(rc->factor1[i], cb.f1[i]);
+        }
+        cb.fin[0] = rc->final0; cb.fin[1] = rc->final1;
+        cb.fin[2] = rc->control; cb.fin[3] = rc->stage_program;
+        unpack(rc->final_c0, cb.fc0);
+        unpack(rc->final_c1, cb.fc1);
+        unpack(b->fog_color, fogc);         /* R in bits 0-7: swap R and B */
+        cb.fogc[0] = fogc[2]; cb.fogc[1] = fogc[1]; cb.fogc[2] = fogc[0]; cb.fogc[3] = fogc[3];
+        for (st = 0; st < 4; st++) {
+            const Nv2aTexture *tx = b->stages[st];
+            if (!tx)
+                continue;
+            cb.tsz[st][2] = tx->normalized ? 1.0f : 0.0f;
+            cb.tsz[st][3] = tx->cube ? 1.0f : 0.0f;
+            {
+                ID3D11ShaderResourceView *v = tex_get(tx, &cb.tsz[st][0], &cb.tsz[st][1]);
+                if (v) srv[tx->cube ? 4 + st : st] = v;
+            }
+            smp[st] = sampler(tx);
+        }
+    } else if (b->texture) {
+        cb.misc2[0] = 1;
+        {
+            ID3D11ShaderResourceView *v = tex_get(b->texture, &cb.tsz[0][0], &cb.tsz[0][1]);
+            if (v) srv[0] = v;
+        }
+        /* The CPU's screen-space path samples the nearest texel. */
+        {
+            Nv2aTexture pt = *b->texture;
+            pt.filter = 0;
+            smp[0] = sampler(&pt);
+        }
+    }
+    if (SUCCEEDED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource *)s_cb, 0,
+                                          D3D11_MAP_WRITE_DISCARD, 0, &m))) {
+        memcpy(m.pData, &cb, sizeof cb);
+        ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource *)s_cb, 0);
+    }
+
+    ID3D11DeviceContext_IASetInputLayout(s_ctx, s_il);
+    ID3D11DeviceContext_IASetPrimitiveTopology(s_ctx, D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    ID3D11DeviceContext_IASetVertexBuffers(s_ctx, 0, 1, &s_vb, &stride, &offset);
+    ID3D11DeviceContext_VSSetShader(s_ctx, s_vs, NULL, 0);
+    ID3D11DeviceContext_VSSetConstantBuffers(s_ctx, 0, 1, &s_cb);
+    ID3D11DeviceContext_PSSetShader(s_ctx, s_ps, NULL, 0);
+    ID3D11DeviceContext_PSSetConstantBuffers(s_ctx, 0, 1, &s_cb);
+    ID3D11DeviceContext_PSSetShaderResources(s_ctx, 0, 8, srv);
+    ID3D11DeviceContext_PSSetSamplers(s_ctx, 0, 4, smp);
+    ID3D11DeviceContext_RSSetState(s_ctx, s_rs);
+    unpack(r->blend_color, bf);
+    {
+        float f[4] = { bf[0], bf[1], bf[2], bf[3] };
+        /* CONSTANT_ALPHA factors read the constant's alpha in every channel. */
+        if (r->blend_src == 0x8003 || r->blend_src == 0x8004
+            || r->blend_dst == 0x8003 || r->blend_dst == 0x8004)
+            f[0] = f[1] = f[2] = bf[3];
+        ID3D11DeviceContext_OMSetBlendState(s_ctx, blend_state(r), f, 0xFFFFFFFFu);
+    }
+    ID3D11DeviceContext_OMSetDepthStencilState(s_ctx, depth_state(r), r->stencil_ref & 0xFF);
+    ID3D11DeviceContext_Draw(s_ctx, b->count, 0);
+    t->dirty = 1;
+    s_st.draws++;
+    s_st.verts += b->count;
+}
+
+static void d3d_flip(void)
+{
+    if (!s_dev)
+        return;
+    /* Write back every target drawn this frame: the window and the dumps
+     * read the finished frame from guest memory, and the one being shown is
+     * not always the one drawn last (MA2 draws effects into offscreen
+     * targets after the scene). Targets still aliased as textures stay
+     * resident on the GPU as well. */
+    {
+        uint32_t pva = nv2a_backend_present_va();
+        int i;
+        for (i = 0; i < RT_MAX; i++) {
+            Target *r = &s_rt[i];
+            if (!r->tex || !r->dirty)
+                continue;
+            /* Only the presented surface; offscreen targets stay on the GPU
+             * (anything that reads one as ordinary memory syncs it first). */
+            if (pva && !(r->va <= pva && pva < r->va + r->pitch * r->height))
+                continue;
+            rt_writeback(r);
+        }
+    }
+    s_cur = NULL;
+    ID3D11DeviceContext_OMSetRenderTargets(s_ctx, 0, NULL, NULL);
+    s_frame++;
+    if (s_frame % 300 == 0) {
+        static int quiet = -1;
+        if (quiet < 0) {
+            const char *e = getenv("RECOMP_D3D11_STATS");
+            quiet = e && *e == '0';
+        }
+        if (!quiet) {
+            fprintf(stderr, "  [D3D11] per frame: %.0f draws, %.0f verts, %.1f switches,"
+                    " %.1f uploads, %.1f writebacks, %.1f decodes (%.0f Ktexels),"
+                    " %.0f hashes (%.1f MB)\n",
+                    s_st.draws / 300.0, s_st.verts / 300.0, s_st.switches / 300.0,
+                    s_st.uploads / 300.0, s_st.writebacks / 300.0, s_st.decodes / 300.0,
+                    s_st.decode_texels / 300.0 / 1000.0, s_st.hashes / 300.0,
+                    s_st.hash_bytes / 300.0 / 1048576.0);
+            fflush(stderr);
+        }
+        memset(&s_st, 0, sizeof s_st);
+    }
+}
+
+static const Nv2aBackend s_d3d11 = { d3d_clear, d3d_draw, d3d_flip };
+
+/* RECOMP_D3D11=1: rasterise on the host GPU. */
+void xbox_D3D11BackendInstall(void)
+{
+    const char *e = getenv("RECOMP_D3D11");
+    if (!e || !*e || *e == '0')
+        return;
+    nv2a_backend_register(&s_d3d11);
+    fprintf(stderr, "  [D3D11] GPU back end registered\n");
+    fflush(stderr);
+}
+
+#else
+
+void xbox_D3D11BackendInstall(void) { }
+
+#endif
