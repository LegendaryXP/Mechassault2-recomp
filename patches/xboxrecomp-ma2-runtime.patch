+def test_a_zero_flag_join_survives_a_write_to_its_register():
+    # MSVC's signed `x % 2`, then the division by 2 that follows it
+    # (MechAssault 2's ray-vs-box face normal, 0x00255AFD):
+    #   +0  and edx, 80000001h ; ZF from edx
+    #   +6  jns +5             -> the cdq
+    #   +8  dec edx            ; negative fix-up, ZF from edx again
+    #   +9  or  edx, -2
+    #   +C  inc edx
+    #   +D L: cdq              ; rewrites edx, leaves EFLAGS alone
+    #   +E  jne +1             ; asks about the remainder, not about cdq
+    #   +10 nop
+    #   +11 ret
+    image = (b"\x81\xE2\x01\x00\x00\x80"  # and edx, 80000001h
+             b"\x79\x05"                  # jns +5 -> +0xD
+             b"\x4A"                      # dec edx
+             b"\x83\xCA\xFE"              # or edx, -2
+             b"\x42"                      # inc edx
+             b"\x99"                      # cdq
+             b"\x75\x01"                  # jne +1 -> +0x11
+             b"\x90"                      # nop
+             b"\xC3")                     # ret
+    code = _translate(image)
+    assert "if ((_fa != 0)) goto loc_00010011;" in code, code
+    assert "(edx != 0)" not in code, code
+
