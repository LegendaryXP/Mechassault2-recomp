+"  if (f == 0x201) return v < r;\n"
+"  if (f == 0x202) return v == r;\n"
+"  if (f == 0x203) return v <= r;\n"
+"  if (f == 0x204) return v > r;\n"
+"  if (f == 0x205) return v != r;\n"
+"  if (f == 0x206) return v >= r;\n"
+"  return true;\n"
+"}\n"
+"float4 ps_main(VO i) : SV_Target {\n"
+"#ifdef AF\n"
+"  grads(0, i.t0); grads(1, i.t1); grads(2, i.t2); grads(3, i.t3);\n"
+"#endif\n"
+"  float4 col = i.d0;\n"
+"  if (K_MISC.z == 0) {\n"                         /* texel * diffuse */
+"    float4 o = col;\n"
+"    if (K_TEXTURED != 0) {\n"
+"      float4 tx = tex2d(0, i.uv / max(g_tsz[0].xy, 1.0));\n"
+"      if (K_TFK(0) && tx.a == 0.0) discard;\n"
+"      o = tx * col;\n"
+"    }\n"
+"    o = saturate(o);\n"
+"    if (!alpha_pass(o.a)) discard;\n"
+"    return o;\n"
+"  }\n"
+"  float4 t[4]; bool keep = true;\n"
+"  TC[0] = i.t0; TC[1] = i.t1; TC[2] = i.t2; TC[3] = i.t3;\n"
+"  DT[0] = DT[1] = DT[2] = DT[3] = 0.0;\n"
+"  t[0] = stage_fetch(0, i.t0, float4(0, 0, 0, 0), keep); TS[0] = t[0];\n"
+"  t[1] = stage_fetch(1, i.t1, t[0], keep); TS[1] = t[1];\n"
+"  t[2] = stage_fetch(2, i.t2, t[1], keep); TS[2] = t[2];\n"
+"  t[3] = stage_fetch(3, i.t3, t[2], keep); TS[3] = t[3];\n"
+/* ALPHA_KILL_ENABLE (xemu psh.c): a stage that sampled a texel with alpha
+ * 0 drops the pixel. MechAssault 2's jump-jet heat haze is opaque quads
+ * whose bump map (a puff with 1-bit alpha) kills everything outside the
+ * puff; without it each quad drew whole, a smeared square whose edges cut
+ * across the one before. */
+"  [unroll] for (uint q = 0; q < 4; q++) if (K_TFK(q) && t[q].a == 0.0) keep = false;\n"
+"  if (!keep) discard;\n"
+"  [unroll] for (uint k = 0; k < 16; k++) R[k] = float4(0, 0, 0, 0);\n"
+"  R[3] = float4(g_fogc.rgb, saturate(i.fog)); R[4] = col; R[5] = i.d1;\n"
+"  R[8] = t[0]; R[9] = t[1]; R[10] = t[2]; R[11] = t[3];\n"
+"  R[12].a = (K_FIN.w & 0x1F) ? t[0].a : 1.0;\n"
+"  uint n = min(K_FIN.z & 0xFF, 8u), flags = K_FIN.z >> 8;\n"
+"  STAGE_LOOP for (uint s = 0; s < n; s++) {\n"
+"    uint icw = K_CICW[s >> 2][s & 3], ocw = K_COCW[s >> 2][s & 3];\n"
+"    uint aicw = K_AICW[s >> 2][s & 3], aocw = K_AOCW[s >> 2][s & 3];\n"
+"    uint fl = ocw >> 12, afl = aocw >> 12;\n"
+"    R[1] = g_f0[(flags & 0x010) ? s : 0];\n"
+"    R[2] = g_f1[(flags & 0x100) ? s : 0];\n"
+"    bool mux = (flags & 1) ? (R[12].a >= 0.5) : (((int)(R[12].a * 255.0)) & 1) != 0;\n"
+"    float3 A = read_rgb(icw >> 24), Bv = read_rgb(icw >> 16);\n"
+"    float3 Cv = read_rgb(icw >> 8), D = read_rgb(icw);\n"
+"    float aA = read_alpha(aicw >> 24), aB = read_alpha(aicw >> 16);\n"
+"    float aC = read_alpha(aicw >> 8), aD = read_alpha(aicw);\n"
+"    float dab = dot(A, Bv), dcd = dot(Cv, D);\n"
+"    float3 pab = (fl & 2) ? dab.xxx : A * Bv;\n"
+"    float3 pcd = (fl & 1) ? dcd.xxx : Cv * D;\n"
+"    float3 sum = (fl & 4) ? (mux ? pcd : pab) : pab + pcd;\n"
+"    uint om = fl & 0x38;\n"
+"    float3 ab = clamp(float3(map_out(pab.x, om), map_out(pab.y, om), map_out(pab.z, om)), -1.0, 1.0);\n"
+"    float3 cd = clamp(float3(map_out(pcd.x, om), map_out(pcd.y, om), map_out(pcd.z, om)), -1.0, 1.0);\n"
+"    float3 ms = clamp(float3(map_out(sum.x, om), map_out(sum.y, om), map_out(sum.z, om)), -1.0, 1.0);\n"
+"    float apab = aA * aB, apcd = aC * aD;\n"
+"    float asum = (afl & 4) ? (mux ? apcd : apab) : apab + apcd;\n"
+"    uint aom = afl & 0x38;\n"
+"    float aab = clamp(map_out(apab, aom), -1.0, 1.0);\n"
+"    float acd = clamp(map_out(apcd, aom), -1.0, 1.0);\n"
+"    float ams = clamp(map_out(asum, aom), -1.0, 1.0);\n"
+"    uint d;\n"
+"    d = (ocw >> 4) & 0xF; if (d) { R[d].rgb = ab; if (fl & 0x80) R[d].a = ab.z; }\n"
+"    d = ocw & 0xF;        if (d) { R[d].rgb = cd; if (fl & 0x40) R[d].a = cd.z; }\n"
+"    d = (ocw >> 8) & 0xF; if (d) R[d].rgb = ms;\n"
+"    d = (aocw >> 4) & 0xF; if (d) R[d].a = aab;\n"
+"    d = aocw & 0xF;        if (d) R[d].a = acd;\n"
+"    d = (aocw >> 8) & 0xF; if (d) R[d].a = ams;\n"
+"    R[0] = float4(0, 0, 0, 0);\n"
+"  }\n"
+"  float4 o;\n"
+"  if (K_FIN.x != 0 || K_FIN.y != 0) {\n"
+"    uint f0 = K_FIN.x, f1 = K_FIN.y, ff = f1 & 0xFF;\n"
+"    R[1] = g_fc0; R[2] = g_fc1;\n"
+"    float3 a = (ff & 0x40) ? 1.0 - R[5].rgb : R[5].rgb;\n"
+"    float3 b = (ff & 0x20) ? 1.0 - R[12].rgb : R[12].rgb;\n"
+"    R[14] = float4((ff & 0x80) ? saturate(a + b) : a + b, 0.0);\n"
+"    float3 E = read_rgb(f1 >> 24), F = read_rgb(f1 >> 16);\n"
+"    R[15] = float4(E * F, 0.0);\n"
+"    float3 A = read_rgb(f0 >> 24), Bv = read_rgb(f0 >> 16);\n"
+"    float3 Cv = read_rgb(f0 >> 8), D = read_rgb(f0);\n"
+"    o.rgb = D + Cv * (1.0 - A) + Bv * A;\n"
+"    o.a = read_alpha(f1 >> 8);\n"
+"  } else {\n"
+"    o = R[12];\n"
+"  }\n"
+"  o = saturate(o);\n"
+"  if (!alpha_pass(o.a)) discard;\n"
+"  return o;\n"
+"}\n";
+
+/* Matches cbuffer B above (16-byte rows). */
+typedef struct {
+    float    surf[4];
+    uint32_t cicw[8], aicw[8], cocw[8], aocw[8];
+    float    f0[8][4], f1[8][4];
+    uint32_t fin[4];
+    float    fc0[4], fc1[4], fogc[4];
+    uint32_t misc[4];
+    float    tsz[4][4];
+    uint32_t misc2[4];
+    float    bm[4][4], bl[4][4];
+    uint32_t dot[4];
+} CB;
+
+typedef struct {
+    float pos[4], d0[4], d1[4];
+    float fog;
+    float uv[2];
+    float t[4][4];
+} GV;
+
+/* ---- device state ------------------------------------------------------ */
+
+static ID3D11Device *s_dev;
+static ID3D11DeviceContext *s_ctx;
+static ID3D11DeviceContext1 *s_ctx1;
+static ID3D11VertexShader *s_vs;
+static ID3D11PixelShader *s_ps;
+static ID3D11InputLayout *s_il;
+static ID3D11Buffer *s_cb, *s_vb;
+static UINT s_vb_size, s_vb_pos;
+static ID3D11ShaderResourceView *s_white2d, *s_whitecube;
+static ID3D11RasterizerState *s_rs;
+/* As s_rs, culling: [0 front, 1 back][front face is counter-clockwise]. */
+static ID3D11RasterizerState *s_rs_cull[2][2];
+/* Depth is clamped per pixel (DepthClipEnable off clamps to the viewport's
+ * range), never per vertex: a floor triangle reaching behind the eye has
+ * vertices far outside [0, 1], and clamping those first bent the depth of
+ * the whole triangle toward the camera -- decals drawn on it later failed
+ * their depth test. Fog likewise: the factor is clamped per pixel, after
+ * the clipper has interpolated it. */
+static int s_failed;
+static float s_scale = 1.0f;          /* RECOMP_RENDER_SCALE, see below */
+static int s_af;                      /* RECOMP_D3D11_AF, see sampler() */
+static UINT s_msaa = 1;               /* RECOMP_D3D11_MSAA, see rt_resolve() */
+static uint32_t s_frame = 1;
+static GV *s_gv;
+static UINT s_gv_cap;
+
+/* Vertex programs (vs_prog). Program memory and constants are re-sent only
+ * when the executor's counters say they changed. The raw stream ring is a
+ * ByteAddressBuffer the vertex shader reads attributes from. */
+typedef struct {
+    uint32_t attr[16][4];           /* buffer byte of element 0, stride, type, size */
+    uint32_t vm[4];                 /* start slot, fog enable, fog mode */
+    float    vf[4];                 /* aa x, aa y, fog params */
+} VACB;
+
+static ID3D11VertexShader *s_vs_prog;
+static ID3D11Buffer *s_cb_prog, *s_cb_const, *s_cb_va, *s_ib, *s_raw;
+static ID3D11ShaderResourceView *s_raw_srv;
+static UINT s_ib_size, s_ib_pos, s_raw_size, s_raw_pos;
+static int s_raw_nooverwrite;       /* MapNoOverwriteOnDynamicBufferSRV */
+static uint32_t s_prog_gen = ~0u, s_const_gen = ~0u;
+static uint32_t s_check_gen = ~0u, s_check_start = ~0u;
+static int s_check_ok;              /* program at start slot ends, writes no c[] */
+
+/* Per-frame work, printed every 300 flips (RECOMP_D3D11_STATS=0 hushes). */
+static struct {
+    uint32_t draws, verts, switches, uploads, writebacks, decodes, hashes;
+    uint32_t pdraws, pverts, spec;
+    uint64_t decode_texels, hash_bytes, raw_bytes;
+    double wb_ms, gpu_ms;          /* waiting on write-back maps; GPU busy */
+    uint32_t gpu_frames;
+} s_st;
+
+static uint32_t s_fb_copies;        /* feedback copies, for RECOMP_D3D11_GPUPROF */
+
+static void d3d_log(const char *what, HRESULT hr)
+{
+    fprintf(stderr, "  [D3D11] %s failed (0x%08lX)\n", what, (unsigned long)hr);
+    fflush(stderr);
+}
+
+static const D3D_SHADER_MACRO s_af_macro[] = { { "AF", "1" }, { NULL, NULL } };
+
+static int compile(const char *entry, const char *target, ID3DBlob **out)
+{
+    ID3DBlob *err = NULL;
+    HRESULT hr = D3DCompile(s_hlsl, sizeof s_hlsl - 1, "nv2a_d3d11",
+                            s_af ? s_af_macro : NULL, NULL,
+                            entry, target, D3DCOMPILE_OPTIMIZATION_LEVEL3, 0,
+                            out, &err);
+    if (FAILED(hr)) {
+        fprintf(stderr, "  [D3D11] shader %s: %s\n", entry,
+                err ? (const char *)ID3D10Blob_GetBufferPointer(err) : "?");
+        if (err) ID3D10Blob_Release(err);
+        return 0;
+    }
+    if (err) ID3D10Blob_Release(err);
+    return 1;
+}
+
+static ID3D11ShaderResourceView *make_white(int cube)
+{
+    D3D11_TEXTURE2D_DESC td;
+    D3D11_SUBRESOURCE_DATA sd[6];
+    D3D11_SHADER_RESOURCE_VIEW_DESC vd;
+    ID3D11Texture2D *t = NULL;
+    ID3D11ShaderResourceView *v = NULL;
+    static const uint32_t white = 0xFFFFFFFFu;
+    int i;
+
+    memset(&td, 0, sizeof td);
+    td.Width = td.Height = 1;
+    td.MipLevels = 1;
+    td.ArraySize = cube ? 6 : 1;
+    td.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    td.SampleDesc.Count = 1;
+    td.Usage = D3D11_USAGE_IMMUTABLE;
+    td.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+    td.MiscFlags = cube ? D3D11_RESOURCE_MISC_TEXTURECUBE : 0;
+    for (i = 0; i < 6; i++) {
+        sd[i].pSysMem = &white;
+        sd[i].SysMemPitch = 4;
+        sd[i].SysMemSlicePitch = 4;
+    }
+    if (FAILED(ID3D11Device_CreateTexture2D(s_dev, &td, sd, &t)))
+        return NULL;
+    memset(&vd, 0, sizeof vd);
+    vd.Format = td.Format;
+    if (cube) {
+        vd.ViewDimension = D3D11_SRV_DIMENSION_TEXTURECUBE;
+        vd.TextureCube.MipLevels = 1;
+    } else {
+        vd.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE2D;
+        vd.Texture2D.MipLevels = 1;
+    }
+    ID3D11Device_CreateShaderResourceView(s_dev, (ID3D11Resource *)t, &vd, &v);
+    ID3D11Texture2D_Release(t);
+    return v;
+}
+
+static int ensure_device(void)
+{
+    static const D3D11_INPUT_ELEMENT_DESC il[] = {
+        { "POSITION", 0, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 0,   D3D11_INPUT_PER_VERTEX_DATA, 0 },
+        { "COLOR",    0, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 16,  D3D11_INPUT_PER_VERTEX_DATA, 0 },
+        { "COLOR",    1, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 32,  D3D11_INPUT_PER_VERTEX_DATA, 0 },
+        { "FOGF",     0, DXGI_FORMAT_R32_FLOAT,          0, 48,  D3D11_INPUT_PER_VERTEX_DATA, 0 },
+        { "TEXCOORD", 4, DXGI_FORMAT_R32G32_FLOAT,       0, 52,  D3D11_INPUT_PER_VERTEX_DATA, 0 },
+        { "TEXCOORD", 0, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 60,  D3D11_INPUT_PER_VERTEX_DATA, 0 },
+        { "TEXCOORD", 1, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 76,  D3D11_INPUT_PER_VERTEX_DATA, 0 },
+        { "TEXCOORD", 2, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 92,  D3D11_INPUT_PER_VERTEX_DATA, 0 },
+        { "TEXCOORD", 3, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 108, D3D11_INPUT_PER_VERTEX_DATA, 0 },
+    };
+    D3D_FEATURE_LEVEL fl;
+    ID3DBlob *vsb = NULL, *psb = NULL;
+    D3D11_BUFFER_DESC bd;
+    D3D11_RASTERIZER_DESC rd;
+    HRESULT hr;
+
+    if (s_dev)
+        return 1;
+    if (s_failed)
+        return 0;
+    s_failed = 1;
+    hr = D3D11CreateDevice(NULL, D3D_DRIVER_TYPE_HARDWARE, NULL,
+                           D3D11_CREATE_DEVICE_BGRA_SUPPORT, NULL, 0,
+                           D3D11_SDK_VERSION, &s_dev, &fl, &s_ctx);
+    if (FAILED(hr)) { d3d_log("D3D11CreateDevice", hr); return 0; }
+    ID3D11DeviceContext_QueryInterface(s_ctx, &IID_ID3D11DeviceContext1, (void **)&s_ctx1);
+    {
+        const char *e = getenv("RECOMP_D3D11_AF");
+        int n = e ? atoi(e) : 0;
+        s_af = n < 1 ? 0 : n > 16 ? 16 : n;
+    }
+    {
+        const char *e = getenv("RECOMP_D3D11_MSAA");
+        UINT n = e ? (UINT)atoi(e) : 1, qc = 0, qd = 0;
+        n = n >= 8 ? 8 : n >= 4 ? 4 : n >= 2 ? 2 : 1;
+        /* The largest count both the colour and the depth format take. */
+        for (; n > 1; n /= 2) {
+            qc = qd = 0;
+            ID3D11Device_CheckMultisampleQualityLevels(s_dev, DXGI_FORMAT_B8G8R8A8_UNORM, n, &qc);
+            ID3D11Device_CheckMultisampleQualityLevels(s_dev, DXGI_FORMAT_D32_FLOAT_S8X24_UINT, n, &qd);
+            if (qc && qd)
+                break;
+        }
+        s_msaa = n;
+    }
+    if (!compile("vs_main", "vs_5_0", &vsb) || !compile("ps_main", "ps_5_0", &psb))
+        return 0;
+    {
+        ID3DBlob *vpb = NULL;
+        if (!compile("vs_prog", "vs_5_0", &vpb))
+            return 0;
+        hr = ID3D11Device_CreateVertexShader(s_dev, ID3D10Blob_GetBufferPointer(vpb),
+                ID3D10Blob_GetBufferSize(vpb), NULL, &s_vs_prog);
+        ID3D10Blob_Release(vpb);
+        if (FAILED(hr)) { d3d_log("CreateVertexShader(vs_prog)", hr); return 0; }
+    }
+    hr = ID3D11Device_CreateVertexShader(s_dev, ID3D10Blob_GetBufferPointer(vsb),
+            ID3D10Blob_GetBufferSize(vsb), NULL, &s_vs);
+    if (FAILED(hr)) { d3d_log("CreateVertexShader", hr); return 0; }
