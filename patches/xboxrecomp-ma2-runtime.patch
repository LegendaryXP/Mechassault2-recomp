-            /* Convert to 16-bit and write (not accumulate) into frame buffer.
-             * Each of the 8 sub-frames writes its own 32-sample slice. */
-            d->monitor.frame_buf[off + i][0] = (int16_t)(left * 32767.0f);
-            d->monitor.frame_buf[off + i][1] = (int16_t)(right * 32767.0f);
+        /* A peak limiter instead of flat clipping (RECOMP_APU_LIMITER=0 turns
+         * it off). The gain drops at once, for the whole frame, to what keeps
+         * this frame's peak under full scale (ramping it down across the
+         * frame left the first samples clipped), and recovers over about a
+         * quarter of a second, ramped so it does not click. */
+        {
+            static float gain = 1.0f;
