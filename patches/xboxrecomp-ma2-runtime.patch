+/* Whether the next sample-limit crossing may raise ISTS bit 3.
+ *
+ * RECOMP_APU_SSL_IRQ=N lets the first N through and no more (0: none);
+ * unset, every crossing raises it, as before. Black's DirectSound needs the
+ * interrupt to finish its init. MechAssault 2's DirectSound (sub_003AB500)
+ * answers it with a full restart of the sequencer and both DSPs
+ * (sub_003AAD8C, which counts them at 0x3C457C): it stops the counter,
+ * reloads the GP and EP, polls XGSCNT and starts the counter again. Raised
+ * every 2048 samples, that ran ~23 times a second, the frames taken while
+ * the counter was off were silent, and three quarters of every period came
+ * out as digital zero: the "static". The bit reads like the MCPX's delta
+ * panic (a DSP that fell more than SSL samples behind the counter), which
+ * the stub DSPs here never do. */
+static int ssl_irq_allowed(void)
+{
+    static long limit = -2, raised;
+
+    if (limit == -2) {
+        const char *e = getenv("RECOMP_APU_SSL_IRQ");
+        limit = (e && *e) ? strtol(e, NULL, 0) : -1;
+        if (limit >= 0)
+            fprintf(stderr, "[APU] sample-limit interrupt: first %ld only"
+                            " (RECOMP_APU_SSL_IRQ)\n", limit);
+    }
+    if (limit >= 0 && raised >= limit)
+        return 0;
+    raised++;
+    return 1;
+}
