+/* Whether the next sample-limit crossing may raise ISTS bit 3.
+ *
+ * RECOMP_APU_SSL_IRQ=N lets the first N through and no more (0: none);
+ * unset, every crossing raises it, as before. Black's DirectSound needs the
+ * interrupt to finish its init. MechAssault 2's DirectSound (sub_003AB500)
+ * answers it with a full restart of the sequencer and both DSPs
+ * (sub_003AAD8C, which counts them at 0x3C457C): it stops the counter,
+ * reloads the GP and EP, polls XGSCNT and starts the counter again. Raised
+ * every 2048 samples, that ran ~23 times a second, the frames taken while
+ * the counter was off were silent, and three quarters of every period came
+ * out as digital zero: the "static". The bit reads like the MCPX's delta
+ * panic (a DSP that fell more than SSL samples behind the counter), which
+ * the stub DSPs here never do. */
+static int ssl_irq_allowed(void)
+{
+    static long limit = -2, raised;
+
+    if (limit == -2) {
+        const char *e = getenv("RECOMP_APU_SSL_IRQ");
+        limit = (e && *e) ? strtol(e, NULL, 0) : -1;
+        if (limit >= 0)
+            fprintf(stderr, "[APU] sample-limit interrupt: first %ld only"
+                            " (RECOMP_APU_SSL_IRQ)\n", limit);
+    }
+    if (limit >= 0 && raised >= limit)
+        return 0;
+    raised++;
+    return 1;
+}
+
 /* The interrupt line, as the frame thread sees it. update_irq used to call
  * pci_irq_assert, which is an empty stub here, so DirectSound's service
  * routine never ran and no voice completion ever reached it. */
@@ -1042,12 +1072,52 @@ static void apu_irq_stats_line(void)
     if (now < s_irq_next_ns)
         return;
     if (s_irq_next_ns)
-        fprintf(stderr, "[APU-IRQ] traps %u se_frames %u fe-trapped-frames %u underruns %u\n",
+        fprintf(stderr, "[APU-IRQ] traps %u se_frames %u fe-trapped-frames %u underruns %u"
+                " lightweight %u (last SECTL %08X FECTL %08X)\n",
                 apu_irq_stats.traps, apu_irq_stats.se_frames,
-                apu_irq_stats.fe_trapped_frames, xa2_underruns());
+                apu_irq_stats.fe_trapped_frames, xa2_underruns(),
+                apu_irq_stats.lw_frames, apu_irq_stats.lw_sectl, apu_irq_stats.lw_fectl);
     s_irq_next_ns = now + 5000000000ull;
 }
 
+/* The EP's "program is running" word (RECOMP_APU_EP_MARK=1).
+ *
+ * MechAssault 2's DirectSound checks, every time its work routine runs
+ * (sub_003AB03A), that EP program memory word 6 (APU +0x5A018) reads
+ * 0xCCCCCC, and otherwise takes the EP for dead and restarts both DSPs
+ * (sub_003AADFA): counter stopped, GP and EP reset and reloaded, a 10 ms
+ * KeStallExecutionProcessor. On hardware the EP's boot loads its program
+ * and the word is there. Nothing here loads DSP programs, so the word stayed
+ * 0 and the restart ran about 75 times a second, with the same silent frames
+ * as the sample-limit restarts. The GP and EP windows are plain memory
+ * (MemoryLayoutInit traps only 0x00000-0x2FFFF), so the reset register the
+ * title writes, EPRST at +0x5FFFC, is read from there: while it has the EP
+ * running, the word is put in place. */
+#define APU_EP_PMEM_MARK   0x5A018u
+#define APU_EP_MARK_VALUE  0xCCCCCCu
+
+static void ep_mark_poll(void)
+{
+    static int on = -1;
+    static volatile uint32_t *ep;
+    const uint32_t run = NV_PAPU_GPRST_GPRST | NV_PAPU_GPRST_GPDSPRST;
+
+    if (on < 0) {
+        extern ptrdiff_t xbox_GetMemoryOffset(void);
+        on = apu_env_on("RECOMP_APU_EP_MARK");
+        ep = (volatile uint32_t *)((char *)xbox_GetMemoryOffset() + 0xFE850000u);
+        if (on)
+            fprintf(stderr, "[APU] EP program marker: 0x%06X at APU +0x%05X while EPRST"
+                            " runs the EP (RECOMP_APU_EP_MARK)\n",
+                    APU_EP_MARK_VALUE, APU_EP_PMEM_MARK);
+    }
+    if (!on)
+        return;
+    if ((ep[NV_PAPU_EPRST / 4] & run) == run
+        && ep[(APU_EP_PMEM_MARK - 0x50000u) / 4] != APU_EP_MARK_VALUE)
+        ep[(APU_EP_PMEM_MARK - 0x50000u) / 4] = APU_EP_MARK_VALUE;
+}
+
 static void *mcpx_apu_frame_thread(void *arg)
 {
     MCPXAPUState *d = MCPX_APU_DEVICE(arg);
@@ -1077,6 +1147,7 @@ static void *mcpx_apu_frame_thread(void *arg)
          * forever to post its next command: Burnout 3 stalls in
          * sub_002F805E polling the same doorbell it was acked on at init. */
         mcpx_apu_dsp_ack_poll(d);
+        ep_mark_poll();
 
         int xcntmode = GET_MASK(qatomic_read(&d->regs[NV_PAPU_SECTL]),
                                 NV_PAPU_SECTL_XCNTMODE);
@@ -1113,6 +1184,9 @@ static void *mcpx_apu_frame_thread(void *arg)
             apu_irq_stats.fe_trapped_frames++;
         } else {
             /* Lightweight: just monitor frame (test tone + software mixer) */
+            apu_irq_stats.lw_frames++;
+            apu_irq_stats.lw_sectl = qatomic_read(&d->regs[NV_PAPU_SECTL]);
+            apu_irq_stats.lw_fectl = fectl;
             mcpx_apu_monitor_frame(d);
             d->ep_frame_div++;
         }
@@ -1137,8 +1211,10 @@ static void *mcpx_apu_frame_thread(void *arg)
                     && (sectl & NV_PAPU_SECTL_XCNTMODE)
                            != NV_PAPU_SECTL_XCNTMODE_OFF) {
                 d->sample_count -= ssl;
-                qatomic_or(&d->regs[NV_PAPU_ISTS], NV_PAPU_ISTS_SSLINTSTS);
-                d->set_irq = true;
+                if (ssl_irq_allowed()) {
+                    qatomic_or(&d->regs[NV_PAPU_ISTS], NV_PAPU_ISTS_SSLINTSTS);
+                    d->set_irq = true;
+                }
             }
         }
 
